# ===========================================
# Production Environment Configuration
# Copy to .env.production and fill in values
# ===========================================

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database
DB_TYPE=mysql
DB_NAME=playwright_user_sys

# MySQL (required when DB_TYPE=mysql)
DB_HOST=<your_mysql_host>
DB_PORT=3306
DB_USER=<your_mysql_user>
DB_PASSWORD=<your_mysql_password>

# SQLite (required when DB_TYPE=sqlite)
# DB_TYPE=sqlite
# DB_PATH=/app/data/database.sqlite

# JWT
JWT_SECRET=<generate_a_random_64_char_string>
JWT_EXPIRES_IN=1d

# Admin Account (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<set_a_strong_password>

# Session Timeout (ms)
INSTANCE_TIMEOUT=60000

# gRPC Server
GRPC_PORT=50051

# Proxy Server
PROXY_PORT=8082

# ===========================================
# Machine Service Settings (Dockerfile.machine)
# ===========================================

# MACHINE_ID=machine-1
# MACHINE_NAME=production-machine-1
# MACHINE_GRPC_PORT=50052
# MACHINE_HTTP_PORT=8082
# MANAGER_HOST=<manager_host>:50051
# MACHINE_IP=<public_ip_or_domain>

# Optional: override auto-detected machine endpoint
# PUBLIC_MACHINE_ENDPOINT=example.com:8082
