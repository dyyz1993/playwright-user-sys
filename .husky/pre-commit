# Pre-commit hook — 第一道防线
# 即使使用 --no-verify 跳过，pre-push 和 CI 会再次检查

echo ""
echo "╔══════════════════════════════════════════════╗"
echo "║  🛡️  Pre-commit 质量门禁                      ║"
echo "╚══════════════════════════════════════════════╝"
echo ""

FAILED=0

# 1. ESLint + Prettier (lint-staged)
echo "1️⃣  ESLint + Prettier 检查..."
pnpm lint-staged || FAILED=1

# 2. TypeScript 类型检查
echo ""
echo "2️⃣  TypeScript 类型检查..."
pnpm build || FAILED=1

# 3. any/unknown 数量检查
echo ""
echo "3️⃣  类型安全数量检查..."
bash scripts/check-type-safety.sh || FAILED=1

# 4. Non-null assertion check
echo ""
echo "4️⃣  非空断言检查..."
bash scripts/check-non-null-assertions.sh || FAILED=1

# 5. @ts-ignore check
echo ""
echo "5️⃣  @ts-ignore 数量检查..."
bash scripts/check-ts-ignore.sh || FAILED=1

# 6. Empty catch check
echo ""
echo "6️⃣  空捕获检查..."
bash scripts/check-empty-catch.sh || FAILED=1

if [ "$FAILED" -ne 0 ]; then
  echo ""
  echo "❌ Pre-commit 检查失败"
  echo "⚠️  使用 --no-verify 跳过是违规行为，pre-push 和 CI 会拦截"
  echo ""
  exit 1
fi

echo ""
echo "✅ Pre-commit 检查通过"
echo ""
