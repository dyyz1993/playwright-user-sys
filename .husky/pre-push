#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

echo "=========================================="
echo "Pre-push 检查 - 第二道防线"
echo "=========================================="
echo ""
echo "即使使用了 --no-verify 跳过 pre-commit，"
echo "pre-push 仍会运行检查。"
echo ""

echo "1. 运行 ESLint 和 Prettier 检查..."
pnpm lint-staged || {
  echo "❌ 代码格式或语法检查失败"
  echo "请修复错误后再推送"
  exit 1
}

echo ""
echo "2. 运行 TypeScript 类型检查..."
pnpm build || {
  echo "❌ TypeScript 类型检查失败"
  echo "请修复类型错误后再推送"
  exit 1
}

echo ""
echo "3. 运行单元测试..."
pnpm test:unit || {
  echo "❌ 单元测试失败"
  echo "请修复失败的测试后再推送"
  exit 1
}

echo ""
echo "✅ Pre-push 检查通过"
