# 第一阶段：构建阶段
ARG NODE_VERSION=22.13.0

FROM node:${NODE_VERSION}-slim AS builder

# 安装必要的依赖项
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=tmpfs,target=/var/log/apt \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache; \
    apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
    python-is-python3 \
    make \
    g++ \
    build-essential

# 设置工作目录
WORKDIR /app

# 复制 package.json
COPY package.json ./

# 安装 pnpm
RUN npm install -g pnpm

# 使用挂载缓存安装依赖
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm install --no-frozen-lockfile

# 复制源代码
COPY . .

# 创建数据目录
RUN mkdir -p /app/data

# 编译 TypeScript 文件
RUN pnpm run build || echo "TypeScript compilation failed, but continuing with build"

# 第二阶段：创建最终镜像
FROM node:${NODE_VERSION}-slim

# 设置环境变量
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    CHROME_BIN=/usr/bin/google-chrome-stable \
    CHROME_PATH=/usr/bin/google-chrome-stable \
    PUPPETEER_CACHE_DIR=/app/.cache \
    DISPLAY=:10 \
    PATH="/usr/bin:/app/selenium/driver:${PATH}" \
    DBUS_SESSION_BUS_ADDRESS=autolaunch:

# 安装运行时必要的依赖和 Chrome
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=tmpfs,target=/var/log/apt \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache; \
    apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    sqlite3 \
    wget \
    gnupg \
    ca-certificates \
    # 字体支持
    fonts-liberation \
    fonts-ipafont-gothic \
    fonts-wqy-zenhei \
    fonts-thai-tlwg \
    fonts-kacst \
    fonts-freefont-ttf \
    # 浏览器依赖
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxss1 \
    xdg-utils \
    curl \
    # Xvfb 支持
    xvfb \
    dbus \
    dbus-x11 \
    # 安装 Chrome
    && mkdir -p /tmp/chrome-download \
    && CHROME_DEB="google-chrome-stable_128.0.6613.119-1_amd64.deb" \
    && wget -q -P /tmp/chrome-download "https://mirror.cs.uchicago.edu/google-chrome/pool/main/g/google-chrome-stable/${CHROME_DEB}" \
    && apt-get install -y /tmp/chrome-download/google-chrome-stable_*.deb \
    # 安装 ChromeDriver
    && mkdir -p /selenium/driver \
    && curl -o /tmp/chromedriver.zip https://storage.googleapis.com/chrome-for-testing-public/128.0.6613.119/linux64/chromedriver-linux64.zip \
    && unzip /tmp/chromedriver.zip -d /tmp \
    && mv /tmp/chromedriver-linux64/chromedriver /selenium/driver/chromedriver \
    && chmod +x /selenium/driver/chromedriver \
    # 清理不必要的文件以减小镜像大小
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/chrome-download/* /tmp/chromedriver.zip /tmp/chromedriver-linux64

# 创建文件目录
RUN mkdir -p /files

WORKDIR /app

# 复制依赖和构建文件
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./

# 创建数据目录
RUN mkdir -p /app/data

# 复制 proto 文件
RUN mkdir -p /app/dist/src/protos
COPY --from=builder /app/src/protos/ /app/dist/src/protos/

# 创建截图目录
RUN mkdir -p /app/dist/data/screenshots

# 创建启动脚本
RUN echo '#!/bin/bash\n\
# 启动 Xvfb\n\
Xvfb :10 -screen 0 1920x1080x24 -ac &\n\
# 等待 Xvfb 启动\n\
sleep 1\n\
# 启动 dbus\n\
dbus-daemon --session --address=unix:path=/tmp/dbus-session-bus --fork\n\
# 启动应用\n\
exec node dist/src/machine/index.js\n\
' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# 设置环境变量
ENV NODE_ENV=production \
    MACHINE_ID="" \
    MANAGEMENT_SERVER_URL="http://localhost:3000" \
    MANAGER_HOST="localhost:50051" \
    STATUS_REPORT_INTERVAL="60000" \
    # 机器配置
    MAX_SESSIONS=10 \
    SESSION_TIMEOUT=300000 \
    HEARTBEAT_INTERVAL=30000 \
    DISCONNECTION_TIMEOUT=10000 \
    ACTIVITY_REPORT_INTERVAL=3000 \
    SESSION_ACTIVITY_TIMEOUT=10000 \
    # 主机配置
    HOST_IP=localhost

# 暴露端口
EXPOSE 8082 50052

# 启动实例机器客户端
ENTRYPOINT ["/app/entrypoint.sh"]
