# 第一阶段：构建阶段
FROM node:18-slim AS builder

# 安装必要的依赖项
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    build-essential

# 设置工作目录
WORKDIR /app

# 复制 package.json
COPY package.json ./

# 安装 pnpm
RUN npm install -g pnpm

# 使用挂载缓存安装依赖
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm install --no-frozen-lockfile

# 复制源代码
COPY . .

# 创建数据目录
RUN mkdir -p /app/data

# 编译 TypeScript 文件
RUN pnpm run build || echo "TypeScript compilation failed, but continuing with build"

# 第二阶段：创建最终镜像
FROM node:18-slim

# 设置环境变量
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    CHROME_BIN=/usr/bin/google-chrome-stable \
    CHROME_PATH=/usr/bin/google-chrome-stable



# 安装运行时必要的依赖和 Chrome
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=cache,target=/tmp/chrome-download,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    sqlite3 \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxss1 \
    xdg-utils \
    curl  \
    # 安装 Chrome
    && CHROME_DEB="google-chrome-stable_128.0.6613.119-1_amd64.deb" \
    && wget -q "https://mirror.cs.uchicago.edu/google-chrome/pool/main/g/google-chrome-stable/${CHROME_DEB}" \
    && apt-get install -y ./google-chrome-stable_*.deb \
    && rm google-chrome-stable_*.deb \
    # 清理不必要的文件以减小镜像大小
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/chrome-download/*

WORKDIR /app

# 复制依赖和构建文件
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./

# 创建数据目录
RUN mkdir -p /app/data

# 复制 proto 文件
RUN mkdir -p /app/dist/src/protos
COPY --from=builder /app/src/protos/ /app/dist/src/protos/

# 设置环境变量
ENV NODE_ENV=production
ENV MACHINE_ID=""
ENV MANAGEMENT_SERVER_URL="http://localhost:3000"
ENV MANAGER_HOST="localhost:50051"
ENV STATUS_REPORT_INTERVAL="60000"

EXPOSE 8082 50052

# 创建数据目录
RUN mkdir -p /app/dist/data/screenshots

# 启动实例机器客户端
CMD ["node", "dist/src/machine/index.js"]
