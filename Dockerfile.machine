# 使用 Node.js 作为基础镜像
FROM nginx:alpine

# 安装 Node.js
RUN apk add --update nodejs npm

# 设置工作目录
WORKDIR /app

# 复制 package.json 和 pnpm-lock.yaml
COPY package.json ./

# 安装 pnpm
RUN npm install -g pnpm

# 安装依赖
RUN pnpm install --no-frozen-lockfile

# 复制源代码
COPY . .

# 创建数据目录
RUN mkdir -p /app/data

# 设置环境变量
ENV NODE_ENV=production
ENV MACHINE_ID=""
ENV MANAGEMENT_SERVER_URL="http://localhost:3000"
ENV STATUS_REPORT_INTERVAL="60000"

# 启动实例机器客户端
CMD ["node", "src/machine-server.js"]
