# 第一阶段：构建阶段
FROM node:18-alpine AS builder

# 安装必要的构建依赖
RUN apk add --no-cache \
    python3 \
    make \
    g++

# 设置工作目录
WORKDIR /app

# 先复制依赖文件，利用Docker层缓存
COPY package.json pnpm-lock.yaml* ./

# 安装pnpm
RUN npm install -g pnpm

# 使用挂载缓存安装依赖
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm install --frozen-lockfile

# 复制源代码
COPY . .

# 编译 TypeScript (生成 dist 目录)
RUN pnpm run build:emit || echo "TypeScript compilation failed, but continuing with build"

# 第二阶段：运行阶段
FROM node:18-alpine AS runtime

# 安装运行时依赖（最小化）
RUN apk add --no-cache \
    # 基本依赖
    sqlite \
    # 浏览器依赖（最小化）
    libasound2 \
    alsa-lib \
    atk \
    cups-libs \
    gtk+3.0 \
    nspr \
    nss \
    libxss \
    # Xvfb 支持
    xvfb \
    dbus \
    # 字体支持（最小化）
    ttf-liberation \
    ttf-dejavu \
    # 其他工具
    curl

# 创建非root用户
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# 设置工作目录
WORKDIR /app

# 从构建阶段复制必要文件
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist
COPY --from=builder --chown=nodejs:nodejs /app/package.json ./

# 创建数据目录并设置权限
RUN mkdir -p /app/data /app/dist/data/screenshots /app/dist/src/protos && \
    chown -R nodejs:nodejs /app

# 复制 proto 文件
COPY --from=builder --chown=nodejs:nodejs /app/src/protos/ /app/dist/src/protos/

# 创建启动脚本
RUN echo '#!/bin/sh\n\
# 检查 Chrome 文件是否存在\n\
if [ ! -d "/opt/chrome" ] || [ ! -f "/opt/chrome/chrome" ]; then\n\
    echo "警告: 未找到 Chrome 浏览器文件！"\n\
    echo "请通过卷映射将 Chrome 文件挂载到 /opt/chrome 目录"\n\
    echo "例如: docker run -v /path/to/your/chrome:/opt/chrome ..."\n\
    echo "容器将在 30 秒后退出..."\n\
    sleep 30\n\
    exit 1\n\
fi\n\
\n\
# 设置 Chrome 可执行权限\n\
chmod +x /opt/chrome/chrome\n\
\n\
# 启动 Xvfb\n\
Xvfb :10 -screen 0 1920x1080x8 -ac &\n\
# 等待 Xvfb 启动\n\
sleep 1\n\
# 启动 dbus\n\
dbus-daemon --session --address=unix:path=/tmp/dbus-session-bus --fork\n\
# 启动应用\n\
exec node dist/src/machine/index.js\n\
' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh && \
    chown nodejs:nodejs /app/entrypoint.sh

# 切换到非root用户
USER nodejs

# 设置环境变量
ENV NODE_ENV=production \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    CHROME_BIN=/opt/chrome/chrome \
    CHROME_PATH=/opt/chrome/chrome \
    PUPPETEER_CACHE_DIR=/app/.cache \
    DISPLAY=:10 \
    DBUS_SESSION_BUS_ADDRESS=autolaunch: \
    MACHINE_ID="" \
    MANAGEMENT_SERVER_URL="http://localhost:3000" \
    MANAGER_HOST="localhost:50051" \
    STATUS_REPORT_INTERVAL="60000" \
    MAX_SESSIONS=10 \
    SESSION_TIMEOUT=300000 \
    HEARTBEAT_INTERVAL=30000 \
    DISCONNECTION_TIMEOUT=10000 \
    ACTIVITY_REPORT_INTERVAL=3000 \
    SESSION_ACTIVITY_TIMEOUT=10000 \
    HOST_IP=localhost

# 暴露端口
EXPOSE 8082 50052

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:8082/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# 启动实例机器客户端
ENTRYPOINT ["/app/entrypoint.sh"]