# 第一阶段：构建阶段
FROM node:18-alpine AS builder

# 安装必要的构建依赖
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    sqlite-dev

# 设置工作目录
WORKDIR /app

# 先复制依赖文件，利用Docker层缓存
COPY package.json pnpm-lock.yaml* ./

# 安装pnpm
RUN npm install -g pnpm

# 使用挂载缓存安装依赖
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm install --frozen-lockfile

# 复制源代码
COPY . .

# 编译 better-sqlite3（仅一次）
RUN --mount=type=cache,target=/root/.npm \
    cd /app/node_modules/better-sqlite3 && \
    npm run build-release

# 编译 TypeScript (生成 dist 目录)
RUN pnpm run build:emit || echo "TypeScript compilation failed, but continuing with build"

# 第二阶段：运行阶段
FROM node:18-alpine AS runtime

# 安装运行时依赖
RUN apk add --no-cache \
    sqlite \
    sqlite-dev \
    libc6-compat

# 创建非root用户
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# 设置工作目录
WORKDIR /app

# 从构建阶段复制必要文件
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist
COPY --from=builder --chown=nodejs:nodejs /app/package.json ./

# 创建数据目录并设置权限
RUN mkdir -p /app/data /app/dist/data/screenshots && \
    chown -R nodejs:nodejs /app

# 复制视图和 proto 文件
RUN mkdir -p /app/dist/src/views/layouts /app/dist/src/protos
COPY --from=builder --chown=nodejs:nodejs /app/src/views/ /app/dist/src/views/
COPY --from=builder --chown=nodejs:nodejs /app/src/protos/ /app/dist/src/protos/

# 切换到非root用户
USER nodejs

# 设置环境变量
ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0

# 暴露端口
EXPOSE 3000

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# 启动应用
CMD ["node", "dist/src/server.js"]