# 使用本地构建
FROM scratch

# 复制已构建的应用
COPY dist /app/dist
COPY src/views /app/dist/views
COPY src/public /app/dist/public
COPY node_modules /app/node_modules
COPY package.json /app/package.json

# 设置工作目录
WORKDIR /app

# 创建数据目录
RUN mkdir -p /app/data

# 设置环境变量
ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

# 暴露端口
EXPOSE 3000

# 启动应用
CMD ["node", "dist/server.js"]
