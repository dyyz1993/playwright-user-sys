# ==========================================
# Docker Compose Production Environment
# ==========================================
# Copy this file to .env and fill in required values before deploying.
# docker-compose.prod.yml uses ${VAR} syntax to reference these variables.
#
# Managed: server /data/docker/playwright-user-sys/docker/.env
#
# ==========================================
# Image Tags (Optional - has default)
# ==========================================
DOCKER_REGISTRY=ghcr.io/dyyz1993/playwright-user-sys-manager
DOCKER_REGISTRY_MACHINE=ghcr.io/dyyz1993/playwright-user-sys-machine
IMAGE_TAG=latest

# ==========================================
# Proxy (Optional - only for restricted networks)
# ==========================================
# HTTP_PROXY=
# HTTPS_PROXY=
NO_PROXY=192.168.0.29,localhost,127.0.0.1,manager,machine-1,machine-2

# ==========================================
# Manager - Database Connection (Required)
# ==========================================
DB_HOST=192.168.0.29
DB_PORT=3307
DB_USER=playwright_user_sys
DB_PASSWORD=                             # Required: Set before deploy
DB_NAME=playwright_user_sys

# ==========================================
# Manager - Auth (Required)
# ==========================================
JWT_SECRET=                               # Required: Generate with: openssl rand -base64 32
JWT_EXPIRES_IN=1d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                           # Required: Set before deploy

# ==========================================
# Manager - Network (Required)
# ==========================================
MANAGER_HTTP_PORT=3011
MANAGER_GRPC_PORT=50051
PUBLIC_MANAGER_URL=192.168.0.29:3011
MACHINE_MONITOR_INTERVAL=30000

# ==========================================
# Machine - Session Limits (Required)
# ==========================================
MAX_SESSIONS=10
SESSION_TIMEOUT=300000
HEARTBEAT_INTERVAL=30000

# ==========================================
# Machine 1 - Ports (Required)
# ==========================================
MACHINE_1_GRPC_PORT=50052
MACHINE_1_PROXY_PORT=8082

# ==========================================
# Machine 2 - Ports (Required)
# ==========================================
MACHINE_2_GRPC_PORT=50053
MACHINE_2_PROXY_PORT=8083
