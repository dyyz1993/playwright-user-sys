# Production Environment Variables for Docker Compose
# Copy this file to .env and update with your values

# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=production
IMAGE_TAG=latest

# ==========================================
# Manager Server Configuration
# ==========================================
MANAGER_HTTP_PORT=3000
MANAGER_GRPC_PORT=50051
MANAGER_CPU_LIMIT=2
MANAGER_MEMORY_LIMIT=2G
MANAGER_CPU_RESERVATION=0.5
MANAGER_MEMORY_RESERVATION=512M

# ==========================================
# Machine Service Configuration
# ==========================================
MAX_SESSIONS=10
SESSION_TIMEOUT=300000
HEARTBEAT_INTERVAL=30000
MACHINE_CPU_LIMIT=4
MACHINE_MEMORY_LIMIT=4G
MACHINE_CPU_RESERVATION=1
MACHINE_MEMORY_RESERVATION=1G

# Machine 1
MACHINE_1_ID=machine-1
MACHINE_1_NAME=Production Machine 1
MACHINE_1_GRPC_PORT=50052
MACHINE_1_PROXY_PORT=8082

# Machine 2 (for scaling)
MACHINE_2_ID=machine-2
MACHINE_2_NAME=Production Machine 2
MACHINE_2_GRPC_PORT=50053
MACHINE_2_PROXY_PORT=8083

# ==========================================
# MySQL Database Configuration
# ==========================================
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD
MYSQL_DATABASE=playwright_user_sys
MYSQL_USER=playwright
MYSQL_PASSWORD=CHANGE_THIS_PASSWORD

# ==========================================
# Application Security Configuration
# ==========================================
JWT_SECRET=CHANGE_THIS_SECRET_KEY_TO_SECURE_RANDOM_STRING
JWT_EXPIRES_IN=1d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# ==========================================
# Monitoring Configuration
# ==========================================
MACHINE_MONITOR_INTERVAL=30000

# ==========================================
# Network Configuration
# ==========================================
NETWORK_SUBNET=172.20.0.0/16

# ==========================================
# Nginx Configuration (optional)
# ==========================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_CPU_LIMIT=1
NGINX_MEMORY_LIMIT=512M
