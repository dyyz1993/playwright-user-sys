# Production Machine Service Dockerfile
# Optimized for Playwright browser service (no SQLite dependencies)

# ============================================
# Stage 1: Dependencies
# ============================================
FROM node:22 AS dependencies

# Install build dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install pnpm
RUN npm install -g pnpm@10.8.0

# Install dependencies with caching
# Skip better-sqlite3 in production
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm install --no-frozen-lockfile --config.sqlite3_binary_host_property=skip

# ============================================
# Stage 2: Build
# ============================================
FROM node:22 AS build

WORKDIR /app

# Copy dependencies
COPY --from=dependencies /app/node_modules ./node_modules

# Copy source code
COPY . .

# Setup and build (generate dist directory)
RUN npm install -g pnpm@10.8.0
RUN pnpm setup:aliases || true
RUN pnpm build:emit

# ============================================
# Stage 3: Production with Host Chrome
# ============================================
FROM node:22 AS production

# Install runtime dependencies for running Chrome on Debian
RUN apt-get update && apt-get install -y \
    curl \
    xvfb \
    dbus \
    wget \
    ca-certificates \
    default-mysql-client \
    fonts-freefont-ttf \
    fonts-wqy-zenhei \
    fonts-wqy-microhei \
    fonts-noto-color-emoji \
    bash \
    netcat-openbsd \
    libglib2.0-0 \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Skip playwright install chromium, using host chrome
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Create non-root user
RUN groupadd -g 1001 nodejs && \
    useradd -u 1001 -g nodejs -m nodejs

WORKDIR /app

# Copy application files
COPY --from=build --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=build --chown=nodejs:nodejs /app/dist ./dist
COPY --from=build --chown=nodejs:nodejs /app/package.json ./

# Create directories (including X11 socket dir for Xvfb as non-root)
RUN mkdir -p /app/data \
    /app/dist/data/screenshots \
    /app/dist/src/shared/protos \
    /tmp/.X11-unix && \
    chmod 1777 /tmp/.X11-unix && \
    chown -R nodejs:nodejs /app

# Copy proto files
COPY --chown=nodejs:nodejs src/shared/protos ./dist/src/shared/protos

# Create startup script
RUN printf "#!/bin/sh\n\
set -e\n\
\n\
# Handle SIGTERM and SIGINT\n\
trap 'exit 0' TERM INT\n\
\n\
echo \"Cleaning up old Xvfb locks...\"\n\
rm -f /tmp/.X99-lock /tmp/.X11-unix/X99 || true\n\
\n\
echo \"Starting Machine Service...\"\n\
echo \"Machine ID: \${MACHINE_ID}\"\n\
echo \"Manager Host: \${MANAGER_HOST}\"\n\
\n\
# Wait for manager gRPC port to be ready\n\
echo \"Waiting for manager gRPC port (\${MANAGER_HOST})...\"\n\
HOST=\$(echo \${MANAGER_HOST} | cut -d: -f1)\n\
PORT=\$(echo \${MANAGER_HOST} | cut -d: -f2)\n\
while ! nc -z \${HOST} \${PORT}; do\n\
  echo \"Manager gRPC port (\${MANAGER_HOST}) is not ready yet, sleeping 2s...\"\n\
  sleep 2\n\
done\n\
echo \"Manager gRPC port is ready!\"\n\
\n\
# Start Xvfb for headless display\n\
echo \"Starting Xvfb...\"\n\
Xvfb :99 -screen 0 1920x1080x24 -ac +render -noreset &\n\
export DISPLAY=:99\n\
\n\
# Wait for Xvfb to be ready\n\
sleep 2\n\
\n\
# Start dbus\n\
echo \"Starting dbus...\"\n\
dbus-daemon --session --address=unix:path=/tmp/dbus-session-bus --fork\n\
\n\
# Start the machine service with auto-retry\n\
echo \"Starting machine server...\"\n\
until node dist/src/machine/server.js; do\n\
  echo \"Machine server crashed with exit code \$?. Respawning in 5s...\"\n\
  sleep 5\n\
done\n\
" > /app/entrypoint.sh

RUN chmod +x /app/entrypoint.sh && \
    chown nodejs:nodejs /app/entrypoint.sh

# Set environment variables
ENV NODE_ENV=production \
    DISPLAY=:99 \
    CHROME_BIN=/opt/google/chrome/chromium \
    CHROME_PATH=/opt/google/chrome/chromium \
    PUPPETEER_EXECUTABLE_PATH=/opt/google/chrome/chromium \
    DB_TYPE=mysql

# Setup path aliases (before switching to non-root user)
RUN node -e "const fs = require('fs'); const path = require('path'); const aliases = {'@shared': 'dist/src/shared', '@controllers': 'dist/src/controllers', '@models': 'dist/src/models', '@services': 'dist/src/services', '@routes': 'dist/src/routes', '@middlewares': 'dist/src/middlewares', '@utils': 'dist/src/utils', '@schemas': 'dist/src/schemas', '@plugins': 'dist/src/plugins', '@config': 'dist/src/config', '@machine': 'dist/src/machine', '@manager': 'dist/src/manager'}; for (const [alias, target] of Object.entries(aliases)) { const linkPath = path.join('/app/dist/node_modules', alias); const resolvedPath = path.join('/app', target); if (!fs.existsSync(linkPath)) { fs.mkdirSync(path.dirname(linkPath), { recursive: true }); fs.symlinkSync(resolvedPath, linkPath, 'dir'); console.log('Created symlink:', alias, '->', resolvedPath); } console.log('Symlink exists:', linkPath); }" || true

# Switch to non-root user
USER nodejs

# Expose ports
# 50052: gRPC
# 8082: WebSocket Proxy
# 9100: Health check HTTP
EXPOSE 50052 8082 9100

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${MACHINE_HEALTH_PORT:-9100}/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]

# ============================================
# Stage 4: E2E (production + Chromium)
# ============================================
FROM production AS e2e

USER root

RUN apt-get update && apt-get install -y \
    gnupg \
    && wget -qO- https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y google-chrome-stable \
    && rm -rf /var/lib/apt/lists/* \
    && google-chrome-stable --version

USER nodejs

ENV CHROME_BIN=/usr/bin/google-chrome-stable \
    CHROME_PATH=/usr/bin/google-chrome-stable \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

ENTRYPOINT ["/app/entrypoint.sh"]
