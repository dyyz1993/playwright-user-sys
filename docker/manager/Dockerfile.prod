# Production Management Server Dockerfile
# Optimized for MySQL-only deployment (no SQLite dependencies)

# ============================================
# Stage 1: Dependencies
# ============================================
FROM node:22 AS dependencies

# Install build dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install pnpm
RUN npm install -g pnpm@10.8.0

# Install dependencies with caching
# Use a custom install to skip better-sqlite3 in production
# Use --no-frozen-lockfile to allow lockfile updates during build
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm install --no-frozen-lockfile --config.sqlite3_binary_host_property=skip

RUN cd /app/node_modules/better-sqlite3 && npm run build-release

# ============================================
# Stage 2: Build
# ============================================
FROM node:22 AS build

WORKDIR /app

# Copy dependencies from previous stage
COPY --from=dependencies /app/node_modules ./node_modules

# Copy source code
COPY . .

# Setup TypeScript path mappings
RUN npm install -g pnpm@10.8.0
RUN pnpm setup:aliases || true

# Build TypeScript (generate dist directory)
RUN pnpm build:emit

# ============================================
# Stage 3: Production
# ============================================
FROM node:22 AS production

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    default-mysql-client \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1001 nodejs && \
    useradd -u 1001 -g nodejs -m nodejs

WORKDIR /app

# Copy necessary files from build stage
COPY --from=build --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=build --chown=nodejs:nodejs /app/dist ./dist
COPY --from=build --chown=nodejs:nodejs /app/package.json ./

# Create necessary directories
RUN mkdir -p /app/data \
    /app/dist/data/screenshots \
    /app/dist/src/shared/protos \
    /app/files && \
    chown -R nodejs:nodejs /app

# Copy proto files
COPY --chown=nodejs:nodejs src/shared/protos ./dist/src/shared/protos

# Copy static files (views and public)
COPY --chown=nodejs:nodejs src/views ./dist/src/views
COPY --chown=nodejs:nodejs src/public ./dist/src/public

# Copy browser-viewer standalone component
COPY --chown=nodejs:nodejs public/browser-viewer ./dist/public/browser-viewer
COPY --chown=nodejs:nodejs public/test-interactive.html ./dist/src/public/test-interactive.html

# Set environment variables
ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0 \
    DB_TYPE=mysql

# Setup path aliases (before switching to non-root user)
# We need to create symlinks in /app/dist/node_modules pointing to /app/dist/src
RUN node -e "const fs = require('fs'); const path = require('path'); const aliases = {'@shared': 'dist/src/shared', '@controllers': 'dist/src/controllers', '@models': 'dist/src/models', '@services': 'dist/src/services', '@routes': 'dist/src/routes', '@middlewares': 'dist/src/middlewares', '@utils': 'dist/src/utils', '@schemas': 'dist/src/schemas', '@plugins': 'dist/src/plugins', '@config': 'dist/src/config', '@machine': 'dist/src/machine', '@manager': 'dist/src/manager'}; for (const [alias, target] of Object.entries(aliases)) { const linkPath = path.join('/app/dist/node_modules', alias); const resolvedPath = path.join('/app', target); if (!fs.existsSync(linkPath)) { fs.mkdirSync(path.dirname(linkPath), { recursive: true }); fs.symlinkSync(resolvedPath, linkPath, 'dir'); console.log('Created symlink:', alias, '->', resolvedPath); } console.log('Symlink exists:', linkPath); }" || true

# Switch to non-root user
USER nodejs

# Expose ports
# 3000: HTTP API
# 50051: gRPC
EXPOSE 3000 50051

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start the application
CMD ["node", "dist/src/manager/server.js"]