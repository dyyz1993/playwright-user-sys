{
  "name": "playwright-user-sys",
  "version": "1.0.0",
  "description": "Playwright用户管理系统",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "predev": "bash scripts/setup-aliases.sh",
    "dev": "tsx watch src/server.ts",
    "predev:env": "bash scripts/setup-aliases.sh",
    "dev:env": "dotenv -e .env.dev -- tsx watch src/server.ts",
    "predev:server": "bash scripts/setup-aliases.sh",
    "dev:server": "export NODE_ENV=development && dotenv -e .env.dev -- tsx watch src/server.ts",
    "predev:machine": "bash scripts/setup-aliases.sh",
    "dev:machine": "export NODE_ENV=development && dotenv -e .env.dev -- tsx watch src/machine/index.ts",
    "predev:minimal": "bash scripts/setup-aliases.sh",
    "dev:minimal": "tsx watch src/minimal.ts",
    "setup:aliases": "bash scripts/setup-aliases.sh",
    "pretest:sqlite": "bash scripts/setup-aliases.sh",
    "test:sqlite": "tsx src/test-sqlite.ts",
    "pretest:mysql": "bash scripts/setup-aliases.sh",
    "test:mysql": "tsx src/test-mysql.ts",
    "build": "tsc --skipLibCheck --allowJs --noEmit false --noImplicitAny false --skipLibCheck true || true",
    "start": "node dist/server.js",
    "prestart:server": "bash scripts/setup-aliases.sh",
    "start:server": "tsx src/server.ts",
    "prestart:machine": "bash scripts/setup-aliases.sh",
    "start:machine": "tsx src/machine-server.ts",
    "demo": "bash scripts/run-demo.sh",
    "precreate-test-user": "bash scripts/setup-aliases.sh",
    "create-test-user": "tsx scripts/create-test-user.ts",
    "preclient-demo": "bash scripts/setup-aliases.sh",
    "client-demo": "tsx scripts/client-demo.ts",
    "premigrate": "bash scripts/setup-aliases.sh",
    "migrate": "tsx scripts/run-migrations.js",
    "premigrate:proxy-port": "bash scripts/setup-aliases.sh",
    "migrate:proxy-port": "tsx scripts/run-proxy-port-migration.js",
    "test": "jest --config=jest.config.cjs",
    "test:watch": "jest --watch",
    "test:unit": "vitest run src/tests/unit",
    "test:unit:watch": "vitest src/tests/unit",
    "lint": "eslint . --ext .ts",
    "test:api": "node tests/test-api.js",
    "test:login": "node tests/test-login.js",
    "test:sessions": "node tests/test-sessions.js",
    "test:credits": "node tests/test-credits.js",
    "test:all": "node tests/run-all-tests.js",
    "preverify-credits": "bash scripts/setup-aliases.sh",
    "verify-credits": "tsx scripts/verify-credits-deduction.ts",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.integration.config.mjs",
    "pretest:sdk": "bash scripts/setup-aliases.sh",
    "test:sdk": "tsx scripts/test-sdk.ts",
    "test:sdk:vitest": "vitest run src/tests/sdk/client.test.ts"
  },
  "keywords": [],
  "author": "xuyingzhou",
  "license": "ISC",
  "packageManager": "pnpm@10.8.0",
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
    "@types/http-proxy": "^1.17.16",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.1",
    "@types/node-fetch": "^2.6.12",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "axios": "^1.8.4",
    "babel-jest": "^29.7.0",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tslib": "^2.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "ws": "^8.18.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/flash": "^6.0.3",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/sensible": "^6.0.3",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.2",
    "@fastify/view": "^11.0.0",
    "@fastify/websocket": "^11.0.2",
    "@grpc/grpc-js": "^1.13.3",
    "@grpc/proto-loader": "^0.7.13",
    "@scalar/fastify-api-reference": "^1.28.19",
    "@types/async-retry": "^1.4.9",
    "@types/bcryptjs": "^3.0.0",
    "async-retry": "^1.3.3",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "fastify": "^5.3.0",
    "fastify-graceful-shutdown": "^4.0.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "fastify-websocket": "^4.3.0",
    "fingerprint-generator": "^2.1.63",
    "fingerprint-injector": "^2.1.63",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql2": "^3.14.0",
    "node-fetch": "^2.7.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.52.0",
    "proxy-chain": "^2.5.8",
    "puppeteer-core": "^24.6.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-adblocker": "^2.13.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^4.1.4",
    "uuid": "^11.1.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.5"
  }
}
