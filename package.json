{
  "name": "playwright-user-sys",
  "version": "1.0.0",
  "description": "Playwright用户管理系统",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "predev": "bash scripts/setup-aliases.sh",
    "dev": "tsx watch src/manager/server.ts",
    "predev:env": "bash scripts/setup-aliases.sh",
    "dev:env": "dotenv -e .env.dev -- tsx watch src/manager/server.ts",
    "predev:server": "bash scripts/setup-aliases.sh",
    "dev:server": "export NODE_ENV=development && dotenv -e .env.dev -- tsx watch src/manager/server.ts",
    "predev:machine": "bash scripts/setup-aliases.sh",
    "dev:machine": "export NODE_ENV=development && dotenv -e .env.dev -- tsx watch src/machine/server.ts",
    "predev:minimal": "bash scripts/setup-aliases.sh",
    "dev:minimal": "tsx watch src/minimal.ts",
    "setup:aliases": "bash scripts/setup-aliases.sh",
    "prepare": "husky",
    "pretest:sqlite": "bash scripts/setup-aliases.sh",
    "test:sqlite": "tsx src/test-sqlite.ts",
    "pretest:mysql": "bash scripts/setup-aliases.sh",
    "test:mysql": "tsx src/test-mysql.ts",
    "build": "tsc --noEmit",
    "build:emit": "tsc --skipLibCheck --allowJs --noEmit false --noImplicitAny false",
    "start": "node dist/manager/server.js",
    "prestart:server": "bash scripts/setup-aliases.sh",
    "start:server": "tsx src/manager/server.ts",
    "prestart:machine": "bash scripts/setup-aliases.sh",
    "start:machine": "tsx src/machine/server.ts",
    "demo": "bash scripts/run-demo.sh",
    "precreate-test-user": "bash scripts/setup-aliases.sh",
    "create-test-user": "tsx scripts/create-test-user.ts",
    "preclient-demo": "bash scripts/setup-aliases.sh",
    "client-demo": "tsx scripts/client-demo.ts",
    "premigrate": "bash scripts/setup-aliases.sh",
    "migrate": "tsx scripts/run-migrations.js",
    "premigrate:proxy-port": "bash scripts/setup-aliases.sh",
    "migrate:proxy-port": "tsx scripts/run-proxy-port-migration.js",
    "dev:test": "NODE_ENV=test vitest run --config vitest.unit.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:models": "vitest run src/tests/unit/models",
    "test:model:user": "vitest run src/tests/unit/models/user.model.test.ts",
    "test:model:session": "vitest run src/tests/unit/models/session.model.test.ts",
    "test:model:machine": "vitest run src/tests/unit/models/machine.model.test.ts",
    "test:services": "vitest run src/tests/unit/services",
    "test:controllers": "vitest run src/tests/unit/controllers",
    "test:routes": "vitest run src/tests/integration/routes",
    "test:coverage": "vitest run --coverage",
    "test:integration:init": "bash scripts/init-test-db.sh",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test:api": "node tests/test-api.cjs",
    "test:login": "node tests/test-login.cjs",
    "test:web:login": "node tests/test-web-login-flow.cjs",
    "test:jwt:verify": "node tests/verify-jwt-import.mjs",
    "preverify-credits": "bash scripts/setup-aliases.sh",
    "verify-credits": "tsx scripts/verify-credits-deduction.ts",
    "test:integration": "vitest run src/tests/integration",
    "pretest:sdk": "bash scripts/setup-aliases.sh",
    "test:sdk": "tsx scripts/test-sdk.ts",
    "test:sdk:vitest": "vitest run src/tests/sdk/client.test.ts",
    "pretest:e2e": "bash scripts/setup-aliases.sh",
    "test:e2e": "playwright test",
    "test:e2e:2": "TEST_MACHINE_COUNT=2 playwright test",
    "test:e2e:3": "TEST_MACHINE_COUNT=3 playwright test",
    "test:e2e:5": "TEST_MACHINE_COUNT=5 playwright test",
    "test:e2e:p0": "playwright test tests/e2e/p0-critical.spec.ts",
    "test:e2e:p1": "playwright test tests/e2e/p1-important.spec.ts",
    "test:e2e:p2": "playwright test tests/e2e/p2-nice-to-have.spec.ts",
    "test:e2e:views": "playwright test tests/e2e/views.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:ui": "playwright test --config=playwright.ui.config.ts",
    "test:ui:headed": "playwright test --config=playwright.ui.config.ts --headed",
    "test:ui:storage": "playwright test --config=playwright.ui.config.ts tests/ui/admin-storage-management.test.ts",
    "test:ui:debug": "playwright test --config=playwright.ui.config.ts --debug",
    "test:tier": "NODE_ENV=test NODE_OPTIONS=\"--max-old-space-size=4096\" npx vitest run tests/integration/security-vulnerabilities.test.ts tests/integration/multi-user-concurrency.test.ts tests/integration/three-tier-architecture.test.ts",
    "test:tier:security": "NODE_ENV=test NODE_OPTIONS=\"--max-old-space-size=4096\" npx vitest run tests/integration/security-vulnerabilities.test.ts",
    "test:tier:concurrency": "NODE_ENV=test NODE_OPTIONS=\"--max-old-space-size=4096\" npx vitest run tests/integration/multi-user-concurrency.test.ts",
    "test:tier:architecture": "NODE_ENV=test NODE_OPTIONS=\"--max-old-space-size=4096\" npx vitest run tests/integration/three-tier-architecture.test.ts",
    "check:types": "bash scripts/check-type-safety.sh",
    "check:all": "pnpm lint && pnpm format:check && pnpm build && pnpm check:types && pnpm test:unit",
    "quality": "pnpm check:all"
  },
  "keywords": [],
  "author": "xuyingzhou",
  "license": "Apache-2.0 WITH Commons-Clause",
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "buffer-equal-constant-time": "npm:scmp@^2.1.0",
      "protobufjs": ">=7.5.5",
      "basic-ftp": ">=5.3.0",
      "follow-redirects": ">=1.16.0",
      "yaml": ">=2.8.3",
      "diff": ">=4.0.4",
      "postcss": ">=8.5.10",
      "minimatch": ">=5.1.8",
      "picomatch": ">=4.0.4",
      "brace-expansion": ">=2.0.3"
    }
  },
  "lint-staged": {
    "src/**/*.ts": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "tests/**/*.ts": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/async-retry": "^1.4.9",
    "@types/form-data": "^2.5.2",
    "@types/http-proxy": "^1.17.16",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.1",
    "@types/node-fetch": "^2.6.12",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "prettier": "^3.8.3",
    "puppeteer": "^24.43.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "ws": "^8.18.1",
    "yaml": ">=2.8.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/flash": "^6.0.3",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/view": "^11.1.1",
    "@grpc/grpc-js": "^1.13.3",
    "@grpc/proto-loader": "^0.8.1",
    "@scalar/fastify-api-reference": "^1.28.19",
    "async-retry": "^1.3.3",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "fastify": "^5.8.5",
    "fastify-graceful-shutdown": "^4.0.1",
    "fastify-plugin": "^5.0.1",
    "fingerprint-generator": "^2.1.63",
    "fingerprint-injector": "^2.1.63",
    "form-data": "^4.0.5",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql2": "^3.14.0",
    "node-fetch": "^2.7.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.52.0",
    "proxy-chain": "^2.5.8",
    "puppeteer-core": "^24.6.1",
    "puppeteer-extra": "^3.3.6",
    "uuid": "^11.1.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.5"
  }
}
