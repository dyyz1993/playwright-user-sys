<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>远程浏览器体验 - Playwright Browser Cloud</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              200: '#bae6fd',
              300: '#7dd3fc',
              400: '#38bdf8',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
              800: '#075985',
              900: '#0c4a6e',
            }
          }
        }
      }
    }
  </script>
  <style>
    body { background: #030712; color: #e2e8f0; font-family: system-ui, -apple-system, sans-serif; }
    .glass { background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(12px); border: 1px solid rgba(148, 163, 184, 0.08); }
    .glow { box-shadow: 0 0 40px rgba(14, 165, 233, 0.15); }
    .pulse-dot { animation: pulse 2s ease-in-out infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .fade-in { animation: fadeIn 0.4s ease-out; }
    @keyframes gradientShift { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
    .gradient-text {
      background: linear-gradient(135deg, #38bdf8, #818cf8, #c084fc);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: gradientShift 4s ease infinite;
    }
    .hero-glow {
      position: absolute;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(14, 165, 233, 0.12) 0%, transparent 70%);
      pointer-events: none;
    }
    .preset-btn { transition: all 0.15s ease; }
    .preset-btn:hover { transform: translateY(-1px); }
    .status-pill { font-variant-numeric: tabular-nums; }
    .demo-btn {
      transition: all 0.15s ease;
    }
    .demo-btn:hover:not(:disabled) {
      transform: translateY(-1px);
      filter: brightness(1.1);
    }
    .demo-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .activity-log-item {
      animation: slideIn 0.3s ease-out;
    }
    @keyframes slideIn {
      from { opacity: 0; transform: translateX(-10px); }
      to { opacity: 1; transform: translateX(0); }
    }
    #side-panel::-webkit-scrollbar { width: 4px; }
    #side-panel::-webkit-scrollbar-track { background: transparent; }
    #side-panel::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.2); border-radius: 2px; }
  </style>
</head>
<body class="min-h-screen flex flex-col overflow-hidden">

  <!-- ========== HERO 区域 ========== -->
  <div id="hero-section" class="flex-1 flex items-center justify-center relative">
    <div class="hero-glow" style="top: -100px; left: 50%; transform: translateX(-50%);"></div>
    <div class="text-center max-w-2xl mx-auto px-6 fade-in relative z-10">
      <div class="mb-6 flex justify-center">
        <div class="w-16 h-16 rounded-2xl bg-primary-500/10 border border-primary-500/20 flex items-center justify-center">
          <i class="fas fa-globe text-primary-400 text-2xl"></i>
        </div>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4 gradient-text leading-tight">远程浏览器体验</h1>
      <p class="text-slate-400 text-lg mb-2">无需安装，即刻体验云端浏览器控制能力</p>
      <p class="text-slate-500 text-sm mb-8">基于 Playwright 的远程浏览器方案，支持实时画面与交互操作</p>
      <button id="start-btn" onclick="startDemo()"
        class="px-8 py-3.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-semibold text-base transition-all duration-200 shadow-lg shadow-primary-600/25 hover:shadow-primary-500/30 hover:scale-[1.02] active:scale-[0.98]">
        <i class="fas fa-play mr-2"></i>开始体验
      </button>
      <div id="hero-error" class="mt-4 text-red-400 text-sm hidden"></div>
      <div class="mt-8 flex items-center justify-center gap-6 text-xs text-slate-600">
        <span><i class="fas fa-clock mr-1"></i>5 分钟空闲自动释放</span>
        <span><i class="fas fa-shield-alt mr-1"></i>无需注册</span>
        <span><i class="fas fa-bolt mr-1"></i>即开即用</span>
      </div>
    </div>
  </div>

  <!-- ========== 浏览器画面 + 侧边面板（初始隐藏） ========== -->
  <div id="browser-section" class="hidden flex-1 flex flex-col min-h-0">
    <!-- 顶部导航栏 -->
    <div class="glass border-b border-slate-800/50 px-4 py-2 flex items-center gap-3 shrink-0">
      <div class="flex items-center gap-1.5">
        <button onclick="goBack()" class="w-8 h-8 rounded-lg hover:bg-slate-700/50 flex items-center justify-center text-slate-400 hover:text-white transition-colors" title="后退">
          <i class="fas fa-arrow-left text-xs"></i>
        </button>
        <button onclick="goForward()" class="w-8 h-8 rounded-lg hover:bg-slate-700/50 flex items-center justify-center text-slate-400 hover:text-white transition-colors" title="前进">
          <i class="fas fa-arrow-right text-xs"></i>
        </button>
        <button onclick="doRefresh()" class="w-8 h-8 rounded-lg hover:bg-slate-700/50 flex items-center justify-center text-slate-400 hover:text-white transition-colors" title="刷新">
          <i class="fas fa-redo text-xs"></i>
        </button>
      </div>

      <div class="flex-1 flex items-center">
        <div class="flex-1 flex items-center bg-slate-800/60 rounded-lg border border-slate-700/50 focus-within:border-primary-500/50 transition-colors">
          <i class="fas fa-lock text-slate-500 text-xs ml-3 mr-2"></i>
          <input id="url-input" type="text" placeholder="输入网址后回车..."
            class="flex-1 bg-transparent py-2 pr-3 text-sm text-white placeholder-slate-500 outline-none"
            onkeydown="if(event.key==='Enter') navigateTo(this.value)">
          <button onclick="navigateTo(document.getElementById('url-input').value)"
            class="px-3 py-2 text-primary-400 hover:text-primary-300 transition-colors">
            <i class="fas fa-arrow-right text-xs"></i>
          </button>
        </div>
      </div>

      <div class="flex items-center gap-1">
        <button onclick="navigateToTestPage()" class="preset-btn px-2.5 py-1 rounded-md text-xs bg-primary-500/20 text-primary-300 hover:text-white hover:bg-primary-500/30 border border-primary-500/30">测试页面</button>
        <button onclick="navigateTo('https://www.baidu.com')" class="preset-btn px-2.5 py-1 rounded-md text-xs bg-slate-800/60 text-slate-300 hover:text-white hover:bg-slate-700/60 border border-slate-700/30">百度</button>
        <button onclick="navigateTo('https://www.bing.com')" class="preset-btn px-2.5 py-1 rounded-md text-xs bg-slate-800/60 text-slate-300 hover:text-white hover:bg-slate-700/60 border border-slate-700/30">Bing</button>
        <button onclick="navigateTo('https://example.com')" class="preset-btn px-2.5 py-1 rounded-md text-xs bg-slate-800/60 text-slate-300 hover:text-white hover:bg-slate-700/60 border border-slate-700/30">Example</button>
        <button onclick="navigateToSliderTest()" class="preset-btn px-2.5 py-1 rounded-md text-xs bg-amber-500/20 text-amber-300 hover:text-white hover:bg-amber-500/30 border border-amber-500/30">滑块验证</button>
      </div>

      <div class="flex items-center gap-1.5 ml-2">
        <span class="w-1.5 h-1.5 rounded-full bg-green-400 pulse-dot"></span>
        <span id="header-countdown" class="text-amber-400 font-medium status-pill text-xs">05:00</span>
      </div>

      <button onclick="endDemo()" class="ml-2 px-3 py-1.5 rounded-lg text-xs bg-red-500/10 text-red-400 hover:bg-red-500/20 border border-red-500/20 transition-colors">
        <i class="fas fa-times mr-1"></i>结束
      </button>
    </div>

    <!-- 主体：画面 + 侧边面板 -->
    <div class="flex-1 flex min-h-0">
      <!-- 画面容器 -->
      <div id="video-container" class="flex-1 relative bg-black min-h-0">
        <iframe id="browser-viewer-frame" src="" style="width:100%;height:100%;border:none;" allow="clipboard-read; clipboard-write"></iframe>
        <!-- 连接中遮罩 -->
        <div id="connecting-overlay" class="absolute inset-0 bg-black/80 flex items-center justify-center z-20">
          <div class="text-center">
            <i class="fas fa-spinner fa-spin text-primary-400 text-3xl mb-3"></i>
            <p class="text-slate-300 text-sm">正在连接远程浏览器...</p>
          </div>
        </div>
      </div>

      <!-- ========== 功能面板 ========== -->
      <div id="side-panel" class="w-72 shrink-0 border-l border-slate-800/50 bg-slate-900/50 overflow-y-auto flex flex-col">
        <!-- 会话信息 -->
        <div class="p-3 border-b border-slate-800/30">
          <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
            <i class="fas fa-info-circle mr-1 text-primary-400"></i>会话信息
          </h3>
          <div class="space-y-1.5 text-xs">
            <div class="flex justify-between">
              <span class="text-slate-500">状态</span>
              <span id="panel-status" class="text-green-400"><i class="fas fa-circle text-[6px] mr-1"></i>已连接</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">已运行</span>
              <span id="panel-elapsed" class="text-slate-300 status-pill">00:00</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">空闲剩余</span>
              <span id="panel-remaining" class="text-amber-400 font-medium status-pill">05:00</span>
            </div>
          </div>
        </div>

        <!-- 积分消耗 -->
        <div class="p-3 border-b border-slate-800/30">
          <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
            <i class="fas fa-coins mr-1 text-amber-400"></i>积分消耗
          </h3>
          <div class="space-y-1.5 text-xs">
            <div class="flex justify-between">
              <span class="text-slate-500">已消耗</span>
              <span id="panel-credits" class="text-slate-300">0 积分</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">速率</span>
              <span class="text-slate-300">~1 积分/分钟</span>
            </div>
          </div>
        </div>

        <!-- 功能体验 -->
        <div class="p-3 border-b border-slate-800/30">
          <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
            <i class="fas fa-tools mr-1 text-purple-400"></i>功能体验
          </h3>
          <div class="space-y-2">
            <button id="btn-screenshot" onclick="demoScreenshot()" disabled
              class="demo-btn w-full px-3 py-2 rounded-lg text-xs bg-primary-500/10 text-primary-300 border border-primary-500/20 hover:bg-primary-500/20 text-left">
              <i class="fas fa-camera mr-2"></i>截图体验
            </button>
            <div id="screenshot-preview" class="hidden">
              <img id="demo-screenshot" class="w-full rounded border border-slate-700/50" alt="截图预览">
            </div>

            <button id="btn-upload" onclick="demoFileUpload()" disabled
              class="demo-btn w-full px-3 py-2 rounded-lg text-xs bg-green-500/10 text-green-300 border border-green-500/20 hover:bg-green-500/20 text-left">
              <i class="fas fa-upload mr-2"></i>文件上传体验
            </button>

            <button id="btn-url-download" onclick="demoUrlDownload()" disabled
              class="demo-btn w-full px-3 py-2 rounded-lg text-xs bg-purple-500/10 text-purple-300 border border-purple-500/20 hover:bg-purple-500/20 text-left">
              <i class="fas fa-download mr-2"></i>URL 下载体验
            </button>
          </div>
        </div>

        <!-- 性能指标 -->
        <div class="p-3 border-b border-slate-800/30">
          <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
            <i class="fas fa-tachometer-alt mr-1 text-cyan-400"></i>性能
          </h3>
          <div class="space-y-1.5 text-xs">
            <div class="flex justify-between">
              <span class="text-slate-500">帧率</span>
              <span id="panel-fps" class="text-slate-300 status-pill">-- FPS</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">带宽</span>
              <span id="panel-bandwidth" class="text-slate-300 status-pill">-- KB/s</span>
            </div>
          </div>
        </div>

        <!-- 使用记录 -->
        <div class="p-3 flex-1 min-h-0 flex flex-col">
          <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 shrink-0">
            <i class="fas fa-list mr-1 text-slate-400"></i>使用记录
          </h3>
          <div id="activity-log" class="flex-1 overflow-y-auto space-y-1 text-xs min-h-[60px]">
            <div class="text-slate-600 italic">暂无记录</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== 过期弹窗 ========== -->
  <div id="expired-modal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center">
    <div class="glass rounded-2xl p-8 max-w-md mx-4 text-center fade-in">
      <div class="w-16 h-16 rounded-full bg-amber-500/10 flex items-center justify-center mx-auto mb-4">
        <i class="fas fa-hourglass-end text-amber-400 text-2xl"></i>
      </div>
      <h2 class="text-xl font-bold text-white mb-2">体验时间已结束</h2>
      <p class="text-slate-400 text-sm mb-6">感谢您的体验，会话因空闲超时已自动关闭</p>
      <button onclick="location.reload()" class="px-6 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white text-sm font-medium transition-colors">
        <i class="fas fa-redo mr-2"></i>重新体验
      </button>
    </div>
  </div>

  <script>
    let sessionId = null;
    let demoApiKey = null;
    let sessionStartTime = null;
    let countdownTimer = null;
    let heartbeatTimer = null;
    let statsTimer = null;
    let creditsUsed = 0;
    const activityLog = [];

    var baseUrl = '<%= process.env.PUBLIC_URL || "" %>';

    const IDLE_TIMEOUT = <%= idleTimeout %>;

    function $(id) { return document.getElementById(id); }

    // ========== 创建会话 ==========
    async function startDemo() {
      const btn = $('start-btn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>正在创建会话...';

      try {
        const resp = await fetch('/api/demo/session', { method: 'POST' });
        const data = await resp.json();

        if (!data.success) {
          showError(data.error || '创建失败');
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-play mr-2"></i>开始体验';
          return;
        }

        sessionId = data.data.sessionId;
        demoApiKey = data.data.demoApiKey;
        sessionStartTime = Date.now();

        var isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)
          || window.innerWidth < 768;
        if (isMobile) {
          document.cookie = 'token=' + demoApiKey + '; path=/; max-age=3600';
          window.location.href = '/browser-viewer/index.html?sessionId=' + sessionId + '&token=' + encodeURIComponent(demoApiKey);
          return;
        }

        showBrowser();
        startTimers();
        enableDemoButtons();
        logActivity('浏览器已启动');
      } catch (e) {
        showError('网络错误，请稍后重试');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-play mr-2"></i>开始体验';
      }
    }

    function showError(msg) {
      const el = $('hero-error');
      el.textContent = msg;
      el.classList.remove('hidden');
      setTimeout(() => el.classList.add('hidden'), 5000);
    }

    function showBrowser() {
      var isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) 
        || window.innerWidth < 768;
      
      if (isMobile && sessionId && demoApiKey) {
        window.location.href = '/browser-viewer/index.html?sessionId=' + sessionId + '&token=' + encodeURIComponent(demoApiKey);
        return;
      }

      $('hero-section').classList.add('hidden');
      $('browser-section').classList.remove('hidden');
      $('browser-section').classList.add('flex');

      document.cookie = 'token=' + demoApiKey + '; path=/; max-age=3600';

      var viewerFrame = $('browser-viewer-frame');
      viewerFrame.src = '/browser-viewer/index.html?sessionId=' + sessionId + '&token=' + encodeURIComponent(demoApiKey);
      viewerFrame.onload = function() {
        $('connecting-overlay').classList.add('hidden');
      };
    }

    function enableDemoButtons() {
      $('btn-screenshot').disabled = false;
      $('btn-upload').disabled = false;
      $('btn-url-download').disabled = false;
    }

    // ========== 定时器 ==========
    function startTimers() {
      updatePanelTimers();
      countdownTimer = setInterval(updatePanelTimers, 1000);

      heartbeatTimer = setInterval(() => {
        if (sessionId) {
          fetch('/api/demo/activity', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ sessionId })
          });
        }
      }, 60000);

      statsTimer = setInterval(() => {
        creditsUsed = Math.max(creditsUsed, Math.floor((Date.now() - sessionStartTime) / 60000));
        $('panel-credits').textContent = `${creditsUsed} 积分`;
      }, 1000);
    }

    function updatePanelTimers() {
      const elapsed = Math.floor((Date.now() - sessionStartTime) / 1000);
      const em = Math.floor(elapsed / 60);
      const es = elapsed % 60;
      $('panel-elapsed').textContent = `${String(em).padStart(2, '0')}:${String(es).padStart(2, '0')}`;

      fetch(`/api/demo/session/${sessionId}/status`)
        .then(r => r.json())
        .then(data => {
          if (data.success) {
            const remaining = data.data.remainingSeconds;
            const rm = Math.floor(remaining / 60);
            const rs = remaining % 60;
            const timeStr = `${String(rm).padStart(2, '0')}:${String(rs).padStart(2, '0')}`;
            $('panel-remaining').textContent = timeStr;
            $('header-countdown').textContent = timeStr;

            if (remaining <= 60) {
              $('panel-remaining').classList.add('text-red-400');
              $('panel-remaining').classList.remove('text-amber-400');
              $('header-countdown').classList.add('text-red-400');
              $('header-countdown').classList.remove('text-amber-400');
            }

            if (data.data.status === 'expired') {
              showExpired();
            }
          }
        })
        .catch(() => {});
    }

    function navigateToTestPage() {
      var base = baseUrl || (location.protocol + '//' + location.host);
      navigateTo(base + '/public/test-interactive.html');
    }

    function navigateToSliderTest() {
      var base = baseUrl || (location.protocol + '//' + location.host);
      navigateTo(base + '/public/slider-test.html');
    }

    // ========== 导航（通过 iframe） ==========
    function navigateTo(url) {
      if (!url) return;
      if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
      $('url-input').value = url;
      var viewerFrame = $('browser-viewer-frame');
      if (viewerFrame.contentWindow && viewerFrame.contentWindow.BrowserViewer) {
        viewerFrame.contentWindow.BrowserViewer.instance && viewerFrame.contentWindow.BrowserViewer.instance.navigateTo(url);
      }
      logActivity(`导航到 ${url}`);
    }

    function goBack() {
      var viewerFrame = $('browser-viewer-frame');
      if (viewerFrame && viewerFrame.contentWindow && viewerFrame.contentWindow.BrowserViewer && viewerFrame.contentWindow.BrowserViewer.instance) {
        viewerFrame.contentWindow.BrowserViewer.instance.send({ type: 'navigate', data: { action: 'goBack' } });
      }
      logActivity('⬅️ 后退');
    }

    function goForward() {
      var viewerFrame = $('browser-viewer-frame');
      if (viewerFrame && viewerFrame.contentWindow && viewerFrame.contentWindow.BrowserViewer && viewerFrame.contentWindow.BrowserViewer.instance) {
        viewerFrame.contentWindow.BrowserViewer.instance.send({ type: 'navigate', data: { action: 'goForward' } });
      }
      logActivity('➡️ 前进');
    }

    function doRefresh() {
      var viewerFrame = $('browser-viewer-frame');
      if (viewerFrame && viewerFrame.contentWindow && viewerFrame.contentWindow.BrowserViewer && viewerFrame.contentWindow.BrowserViewer.instance) {
        viewerFrame.contentWindow.BrowserViewer.instance.send({ type: 'navigate', data: { action: 'reload' } });
      }
      logActivity('🔄 刷新');
    }

    // ========== 使用记录 ==========
    function logActivity(action) {
      const time = new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      activityLog.unshift({ time, action });
      if (activityLog.length > 50) activityLog.pop();
      renderActivityLog();
    }

    function renderActivityLog() {
      const container = $('activity-log');
      if (activityLog.length === 0) {
        container.innerHTML = '<div class="text-slate-600 italic">暂无记录</div>';
        return;
      }
      container.innerHTML = activityLog.map(item =>
        `<div class="activity-log-item flex gap-2 py-0.5">
          <span class="text-slate-600 shrink-0">${item.time}</span>
          <span class="text-slate-400">${item.action}</span>
        </div>`
      ).join('');
    }

    // ========== 功能体验按钮 ==========
    async function demoScreenshot() {
      const btn = $('btn-screenshot');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>截图中...';
      logActivity('正在截图...');

      try {
        const resp = await fetch(`/api/sessions/${sessionId}/screenshot`, {
          headers: { 'x-api-key': demoApiKey }
        });
        const data = await resp.json();
        if (data.success && data.data) {
          const screenshotUrl = data.data.screenshot_url || data.data.screenshotUrl;
          if (screenshotUrl) {
            $('demo-screenshot').src = screenshotUrl;
            $('screenshot-preview').classList.remove('hidden');
            logActivity('截图成功！');
          } else {
            logActivity('截图成功（无预览URL）');
          }
        } else {
          logActivity('截图失败: ' + (data.error || '未知错误'));
        }
      } catch (e) {
        logActivity('截图失败: 网络错误');
      }

      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-camera mr-2"></i>截图体验';
    }

    function buildFileTestPageUrl() {
      const html = `<!DOCTYPE html>
<html><head><title>文件上传测试</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,-apple-system,sans-serif;max-width:520px;margin:30px auto;padding:24px;background:#f8fafc;color:#1e293b}
h2{font-size:22px;margin-bottom:8px}
p.sub{color:#94a3b8;font-size:14px;margin-bottom:20px}
.upload-area{border:2px dashed #cbd5e1;border-radius:14px;padding:36px 20px;text-align:center;transition:.2s}
.upload-area.dragover{border-color:#3b82f6;background:#eff6ff}
#fileInput{display:none}
.btn{display:inline-block;padding:10px 22px;background:#3b82f6;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:15px;margin-top:12px}
.btn:hover{background:#2563eb}
#result{margin-top:20px;padding:16px;background:#f0fdf4;border:1px solid #86efac;border-radius:10px;display:none}
#result.show{display:block}
.file-info{display:flex;align-items:center;gap:14px}
.file-icon{font-size:30px}
.file-details{text-align:left}
.file-name{font-weight:700;color:#166534;font-size:15px}
.file-meta{color:#64748b;font-size:13px;margin-top:2px}
#progress{width:100%;height:4px;background:#e2e8f0;border-radius:2px;margin-top:14px;overflow:hidden;display:none}
#progress.show{display:block}
#progressBar{width:0;height:100%;background:#3b82f6;border-radius:2px;transition:width .3s}
</style></head><body>
<h2>📁 文件上传测试</h2>
<p class="sub">演示远程文件上传：选择文件后自动注入远程浏览器</p>
<div class="upload-area" id="dropZone">
<p style="color:#64748b;margin-bottom:6px">📂 拖拽文件到这里</p>
<p style="color:#94a3b8;font-size:13px;margin-bottom:4px">或</p>
<button class="btn" onclick="document.getElementById('fileInput').click()">选择文件</button>
<input type="file" id="fileInput">
</div>
<div id="progress"><div id="progressBar"></div></div>
<div id="result"><div class="file-info"><span class="file-icon">✅</span><div class="file-details"><div class="file-name" id="fileName"></div><div class="file-meta" id="fileSize"></div><div class="file-meta" id="fileType"></div></div></div></div>
<script>
var fi=document.getElementById('fileInput'),rs=document.getElementById('result'),pg=document.getElementById('progress'),pb=document.getElementById('progressBar');
function showFileResult(f){pg.classList.add('show');pb.style.width='50%';setTimeout(function(){pb.style.width='100%';setTimeout(function(){pg.classList.remove('show');document.getElementById('fileName').textContent=f.name;document.getElementById('fileSize').textContent='大小: '+(f.size/1024).toFixed(1)+' KB';document.getElementById('fileType').textContent='类型: '+(f.type||'未知');rs.classList.add('show')},300)},500)}
fi.addEventListener('change',function(){if(this.files[0])showFileResult(this.files[0])});
var dz=document.getElementById('dropZone');
dz.addEventListener('dragover',function(e){e.preventDefault();dz.classList.add('dragover')});
dz.addEventListener('dragleave',function(){dz.classList.remove('dragover')});
dz.addEventListener('drop',function(e){e.preventDefault();dz.classList.remove('dragover');var f=e.dataTransfer.files[0];if(f){fi.files=e.dataTransfer.files;showFileResult(f)}});
<\/script></body></html>`;
      return 'data:text/html;charset=utf-8,' + encodeURIComponent(html);
    }

    async function demoFileUpload() {
      if (!sessionId) { showToast('请先开始体验'); return; }
      const btn = $('btn-upload');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>上传中...';

      const input = document.createElement('input');
      input.type = 'file';
      input.accept = '.txt,.jpg,.jpeg,.png,.pdf,.csv,.json';
      input.onchange = async (e) => {
        const file = e.target.files[0];
        if (!file) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-upload mr-2"></i>文件上传体验'; return; }

        logActivity(`已选择文件: ${file.name} (${(file.size / 1024).toFixed(1)}KB)`);

        try {
          var base = baseUrl || (location.protocol + '//' + location.host);
          navigateTo(base + '/public/slider-test.html');
          logActivity('正在打开滑块测试页面...');
          await new Promise(r => setTimeout(r, 2000));

          logActivity('正在上传文件到远程服务器...');
          const formData = new FormData();
          formData.append('file', file, file.name);
          formData.append('sessionId', sessionId);

          const uploadResp = await fetch('/api/files/upload-session', {
            method: 'POST',
            headers: { 'x-api-key': demoApiKey },
            body: formData
          });
          const uploadData = await uploadResp.json();

          if (!uploadData.success || !uploadData.data) {
            logActivity('上传失败: ' + (uploadData.error || '未知错误'));
            return;
          }

          logActivity(`文件已传输到远程服务器`);

          logActivity('正在注入到远程浏览器...');
          const injectResp = await fetch(`/api/sessions/${sessionId}/inject-file`, {
            method: 'POST',
            headers: { 'x-api-key': demoApiKey, 'content-type': 'application/json' },
            body: JSON.stringify({
              machineFilePath: uploadData.data.machineFilePath,
              selector: '#fileInput'
            })
          });
          const injectData = await injectResp.json();

          if (injectData.success) {
            logActivity(`✅ 上传成功！${file.name} 已注入远程浏览器`);
          } else {
            logActivity('注入结果: ' + (injectData.message || '完成'));
          }
        } catch (err) {
          logActivity('上传失败: ' + err.message);
        } finally {
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-upload mr-2"></i>文件上传体验';
        }
      };

      input.click();
    }

    async function demoUrlDownload() {
      if (!sessionId) { showToast('请先开始体验'); return; }
      const btn = $('btn-url-download');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>下载中...';
      logActivity('正在下载远程文件...');

      try {
        var base = baseUrl || (location.protocol + '//' + location.host);
        navigateTo(base + '/public/slider-test.html');
        logActivity('正在打开滑块测试页面...');
        await new Promise(r => setTimeout(r, 3000));

        logActivity('正在下载远程图片并注入...');
        const injectResp = await fetch(`/api/sessions/${sessionId}/upload-url`, {
          method: 'POST',
          headers: { 'x-api-key': demoApiKey, 'content-type': 'application/json' },
          body: JSON.stringify({
            url: 'https://www.baidu.com/img/PCtm_d9c8750bed0b3c7d089fa7d55720d6cf.png',
            selector: '#fileInput',
            filename: 'baidu-logo-demo.png'
          })
        });
        const data = await injectResp.json();
        if (data.success) {
          logActivity('✅ 远程文件下载并注入成功！');
        } else {
          logActivity('URL 下载: ' + (data.message || data.error || '未知错误'));
        }
      } catch (e) {
        logActivity('URL 下载失败: 网络错误');
      }

      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-download mr-2"></i>URL 下载体验';
    }

    // ========== 状态更新 ==========
    function setConnected(ok) {
      $('panel-status').innerHTML = ok
        ? '<i class="fas fa-circle text-[6px] mr-1"></i>已连接'
        : '<i class="fas fa-circle text-[6px] mr-1"></i>已断开';
      $('panel-status').className = ok ? 'text-green-400' : 'text-red-400';
      if (ok) $('connecting-overlay').classList.add('hidden');
    }

    function showExpired() {
      $('expired-modal').classList.remove('hidden');
      cleanup();
    }

    // ========== 结束/清理 ==========
    async function endDemo() {
      try {
        if (sessionId) {
          await fetch('/api/demo/session', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sessionId })
          });
        }
      } catch {}
      cleanup();
      location.reload();
    }

    function cleanup() {
      if (countdownTimer) clearInterval(countdownTimer);
      if (heartbeatTimer) clearInterval(heartbeatTimer);
      if (statsTimer) clearInterval(statsTimer);
    }

    window.addEventListener('message', function(e) {
      if (e.data && e.data.type === 'bv-stats') {
        if (e.data.fps > 0) $('panel-fps').textContent = e.data.fps + ' FPS';
        if (e.data.bandwidth > 0) $('panel-bandwidth').textContent = e.data.bandwidth + ' KB/s';
      }
    });

    window.addEventListener('beforeunload', () => {
      if (sessionId) {
        navigator.sendBeacon('/api/demo/session', JSON.stringify({ sessionId }));
      }
      cleanup();
    });

    // ========== 初始化 ==========
  </script>
</body>
</html>
