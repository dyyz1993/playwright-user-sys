<div class="bg-white shadow rounded-lg p-6 mb-6">
  <h2 class="text-xl font-semibold text-gray-800 mb-4">上传文件</h2>

  <form id="upload-form" class="mb-6">
    <div class="flex items-center space-x-4">
      <div class="flex-1">
        <input type="file" id="file-input" class="block w-full text-sm text-gray-500
          file:mr-4 file:py-2 file:px-4
          file:rounded-md file:border-0
          file:text-sm file:font-semibold
          file:bg-primary-600 file:text-white
          hover:file:bg-primary-700
        " accept=".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.txt,.zip" required>
        <p class="text-sm text-gray-500 mt-2">支持的文件类型: JPG, PNG, GIF, PDF, DOC, DOCX, TXT, ZIP</p>
      </div>
      <button type="submit" class="bg-primary-600 text-white py-2 px-4 rounded-md hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500">
        上传文件
      </button>
    </div>
  </form>
  
  <div id="upload-result" class="hidden mt-4 p-4 rounded-md"></div>
</div>

<div class="bg-white shadow rounded-lg p-6">
  <h2 class="text-xl font-semibold text-gray-800 mb-4">已上传文件</h2>
  
  <div id="file-list" class="space-y-3">
    <p class="text-gray-500 text-center py-4">加载中...</p>
  </div>
</div>

<script>
// 上传文件
document.getElementById('upload-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  
  const fileInput = document.getElementById('file-input');
  const file = fileInput.files[0];
  
  if (!file) {
    showNotification('请选择一个文件', 'error');
    return;
  }
  
  try {
    const formData = new FormData();
    formData.append('file', file);
    
    const response = await fetch('/api/files/upload', {
      method: 'POST',
      body: formData,
      headers: {
        // 注意：不要设置 Content-Type，让浏览器自动设置 multipart/form-data
      }
    });
    
    const result = await response.json();
    
    if (result.success) {
      showNotification('文件上传成功', 'success');
      loadFileList(); // 重新加载文件列表
      
      // 显示上传结果
      const resultDiv = document.getElementById('upload-result');
      resultDiv.className = 'bg-green-50 border border-green-200 text-green-700 p-4 rounded-md';
      resultDiv.innerHTML = `
        <h3 class="font-semibold mb-2">上传成功</h3>
        <p>文件名: ${result.data.filename}</p>
        <p>大小: ${formatFileSize(result.data.size)}</p>
        <p>访问地址: <a href="${result.data.url}" target="_blank" class="text-primary-600 hover:underline">${result.data.url}</a></p>
      `;
      resultDiv.classList.remove('hidden');
      
      // 清空文件输入
      fileInput.value = '';
    } else {
      showNotification(`上传失败: ${result.error}`, 'error');
    }
  } catch (error) {
    console.error('上传错误:', error);
    showNotification(`上传失败: ${error.message}`, 'error');
  }
});

// 加载文件列表
async function loadFileList() {
  try {
    const response = await fetch('/api/files');
    const result = await response.json();
    
    if (result.success) {
      const fileList = document.getElementById('file-list');
      
      if (result.data.length === 0) {
        fileList.innerHTML = '<p class="text-gray-500 text-center py-4">暂无上传文件</p>';
        return;
      }
      
      fileList.innerHTML = result.data.map(file => `
        <div class="border rounded-md p-4 flex justify-between items-center">
          <div>
            <h3 class="font-medium text-gray-800">${file.filename}</h3>
            <p class="text-sm text-gray-500">大小: ${formatFileSize(file.size)} | 上传时间: ${new Date(file.uploadedAt).toLocaleString()}</p>
          </div>
          <a href="${file.url}" target="_blank" class="text-primary-600 hover:underline">下载</a>
        </div>
      `).join('');
    } else {
      fileList.innerHTML = `<p class="text-red-500 text-center py-4">加载失败: ${result.error}</p>`;
    }
  } catch (error) {
    console.error('加载文件列表错误:', error);
    document.getElementById('file-list').innerHTML = '<p class="text-red-500 text-center py-4">加载失败</p>';
  }
}

// 格式化文件大小
function formatFileSize(bytes) {
  if (bytes === 0) return '0 Bytes';
  
  const k = 1024;
  const sizes = ['Bytes', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

// 页面加载完成后获取文件列表
document.addEventListener('DOMContentLoaded', function() {
  loadFileList();
});
</script>