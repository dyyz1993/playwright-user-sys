<div class="bg-white rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
    <h3 class="text-lg font-medium text-gray-700">操作日志</h3>
    <div class="flex space-x-2">
      <button id="refresh-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
        <i class="fas fa-sync-alt"></i>
      </button>
      <div class="relative">
        <button id="export-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
          <i class="fas fa-download mr-1"></i> 导出
        </button>
        <div id="export-menu" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-10 hidden">
          <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">导出为 CSV</a>
          <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">导出为 Excel</a>
        </div>
      </div>
    </div>
  </div>

  <div class="p-6">
    <!-- 搜索和筛选 -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6 space-y-4 md:space-y-0">
      <div class="flex items-center">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-search text-gray-400"></i>
          </div>
          <input type="text" id="search-logs" placeholder="搜索日志..."
            class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>
        <div class="ml-4">
          <select id="action-filter" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="">所有操作</option>
            <option value="login">登录</option>
            <option value="create_user">创建用户</option>
            <option value="add_credits">添加算力</option>
            <option value="create_session">创建会话</option>
            <option value="end_session">结束会话</option>
          </select>
        </div>
      </div>

      <div class="flex items-center space-x-4">
        <div>
          <label for="date-range" class="block text-sm font-medium text-gray-700 mb-1">日期范围</label>
          <select id="date-range" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="all">所有时间</option>
            <option value="today">今天</option>
            <option value="yesterday">昨天</option>
            <option value="week">本周</option>
            <option value="month">本月</option>
          </select>
        </div>
      </div>
    </div>

    <!-- 日志表格 -->
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              时间
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              用户
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              操作
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              详情
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              IP 地址
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% logs.forEach(log => { %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= new Date(log.created_at).toLocaleString() %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="flex-shrink-0 h-8 w-8 rounded-full bg-primary-500 flex items-center justify-center text-white font-medium">
                    <%= log.username.charAt(0).toUpperCase() %>
                  </div>
                  <div class="ml-3">
                    <div class="text-sm font-medium text-gray-900"><%= log.username %></div>
                    <div class="text-xs text-gray-500"><%= log.role %></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (log.action === 'login') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                    登录
                  </span>
                <% } else if (log.action === 'create_user') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    创建用户
                  </span>
                <% } else if (log.action === 'add_credits') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                    添加算力
                  </span>
                <% } else if (log.action === 'create_session') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-purple-100 text-purple-800">
                    创建会话
                  </span>
                <% } else if (log.action === 'end_session') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                    结束会话
                  </span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                    <%= log.action %>
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% try { %>
                  <% if (log.details) { %>
                    <% const detailsObj = JSON.parse(log.details); %>
                    <% if (typeof detailsObj === 'object' && detailsObj !== null) { %>
                      <% Object.entries(detailsObj).forEach(([key, value]) => { %>
                        <div><strong><%= key %>:</strong> <%= typeof value === 'object' ? JSON.stringify(value) : value %></div>
                      <% }); %>
                    <% } else { %>
                      <%= log.details %>
                    <% } %>
                  <% } else { %>
                    -
                  <% } %>
                <% } catch (e) { %>
                  <%= log.details || '-' %>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= log.ip_address %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- 分页 -->
    <div class="flex items-center justify-between mt-6">
      <div class="text-sm text-gray-700">
        显示 <span class="font-medium"><%= (page - 1) * limit + 1 %></span> 到 <span class="font-medium"><%= Math.min(page * limit, totalLogs) %></span> 条，共 <span class="font-medium"><%= totalLogs %></span> 条
      </div>
      <div class="flex space-x-2">
        <% if (page > 1) { %>
          <a href="/admin/logs?page=<%= page - 1 %>&limit=<%= limit %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            上一页
          </a>
        <% } else { %>
          <button disabled class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
            上一页
          </button>
        <% } %>

        <% if (page * limit < totalLogs) { %>
          <a href="/admin/logs?page=<%= page + 1 %>&limit=<%= limit %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            下一页
          </a>
        <% } else { %>
          <button disabled class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
            下一页
          </button>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  // 导出菜单
  const exportBtn = document.getElementById('export-btn');
  const exportMenu = document.getElementById('export-menu');

  exportBtn?.addEventListener('click', () => {
    exportMenu.classList.toggle('hidden');
  });

  // 点击其他地方关闭导出菜单
  document.addEventListener('click', (e) => {
    if (!exportBtn?.contains(e.target) && !exportMenu?.contains(e.target)) {
      exportMenu?.classList.add('hidden');
    }
  });

  // 搜索功能
  const searchInput = document.getElementById('search-logs');
  searchInput?.addEventListener('input', () => {
    const searchTerm = searchInput.value.toLowerCase();
    const rows = document.querySelectorAll('tbody tr');

    rows.forEach(row => {
      const username = row.querySelector('td:nth-child(2) .text-sm.font-medium').textContent.toLowerCase();
      const action = row.querySelector('td:nth-child(3) span').textContent.trim().toLowerCase();
      const details = row.querySelector('td:nth-child(4)').textContent.toLowerCase();

      if (username.includes(searchTerm) || action.includes(searchTerm) || details.includes(searchTerm)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  });

  // 操作筛选
  const actionFilter = document.getElementById('action-filter');
  actionFilter?.addEventListener('change', () => {
    const selectedAction = actionFilter.value;
    const rows = document.querySelectorAll('tbody tr');

    rows.forEach(row => {
      const actionCell = row.querySelector('td:nth-child(3) span');
      let action = '';

      if (actionCell.textContent.trim() === '登录') action = 'login';
      else if (actionCell.textContent.trim() === '创建用户') action = 'create_user';
      else if (actionCell.textContent.trim() === '添加算力') action = 'add_credits';
      else if (actionCell.textContent.trim() === '创建会话') action = 'create_session';
      else if (actionCell.textContent.trim() === '结束会话') action = 'end_session';

      if (selectedAction === '' || action === selectedAction) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  });

  // 日期范围筛选
  const dateRangeFilter = document.getElementById('date-range');
  dateRangeFilter?.addEventListener('change', () => {
    const selectedRange = dateRangeFilter.value;
    const rows = document.querySelectorAll('tbody tr');

    if (selectedRange === 'all') {
      rows.forEach(row => {
        row.style.display = '';
      });
      return;
    }

    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const yesterday = new Date(today);
    yesterday.setDate(yesterday.getDate() - 1);

    const startOfWeek = new Date(today);
    startOfWeek.setDate(today.getDate() - today.getDay());

    const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);

    rows.forEach(row => {
      const dateCell = row.querySelector('td:first-child').textContent;
      const logDate = new Date(dateCell);

      let show = false;

      switch (selectedRange) {
        case 'today':
          show = logDate >= today;
          break;
        case 'yesterday':
          show = logDate >= yesterday && logDate < today;
          break;
        case 'week':
          show = logDate >= startOfWeek;
          break;
        case 'month':
          show = logDate >= startOfMonth;
          break;
      }

      row.style.display = show ? '' : 'none';
    });
  });

  // 刷新按钮
  const refreshBtn = document.getElementById('refresh-btn');
  refreshBtn?.addEventListener('click', () => {
    window.location.reload();
  });
</script>
