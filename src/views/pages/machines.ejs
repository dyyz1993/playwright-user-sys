<div class="bg-white rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
    <h3 class="text-lg font-medium text-gray-700">机器管理</h3>
    <div class="flex space-x-2">
      <button id="add-machine-btn" class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-2 rounded-md text-sm font-medium">
        <i class="fas fa-plus mr-1"></i>添加机器
      </button>
      <button id="batch-health-check-btn" class="bg-green-600 hover:bg-green-700 text-white px-3 py-2 rounded-md text-sm font-medium">
        <i class="fas fa-heartbeat mr-1"></i>批量健康检查
      </button>
      <button id="refresh-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
        <i class="fas fa-sync-alt"></i>
      </button>
    </div>
  </div>

  <div class="p-6">
    <!-- 搜索和筛选 -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6 space-y-4 md:space-y-0">
      <div class="flex items-center">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-search text-gray-400"></i>
          </div>
          <input type="text" id="search-machines" placeholder="搜索机器..."
            class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>
        <div class="ml-4">
          <select id="status-filter" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="">所有状态</option>
            <option value="online" <%= filters.status === 'online' ? 'selected' : '' %>>在线</option>
            <option value="offline" <%= filters.status === 'offline' ? 'selected' : '' %>>离线</option>
          </select>
        </div>
      </div>
      <div class="flex items-center">
        <label class="flex items-center">
          <input type="checkbox" id="select-all-machines" class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded mr-2">
          <span class="text-sm text-gray-700">全选</span>
        </label>
      </div>
    </div>

    <!-- 批量操作按钮 -->
    <div id="batch-actions" class="hidden mb-4 p-3 bg-blue-50 border border-blue-200 rounded-md flex items-center justify-between">
      <span class="text-sm text-blue-700">已选择 <span id="selected-count">0</span> 台机器</span>
      <div class="flex space-x-2">
        <button id="batch-restart-btn" class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1.5 rounded-md text-sm font-medium">
          <i class="fas fa-redo mr-1"></i> 批量重启
        </button>
        <button id="cancel-selection-btn" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-3 py-1.5 rounded-md text-sm font-medium">
          取消选择
        </button>
      </div>
    </div>

    <!-- 机器卡片视图 -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% machines.forEach(machine => { %>
        <div class="machine-card bg-white border rounded-lg shadow-sm overflow-hidden relative" data-machine-id="<%= machine.id %>" data-status="<%= machine.status %>">
          <!-- 复选框 -->
          <div class="absolute top-4 left-4 z-10">
            <input type="checkbox" class="machine-checkbox h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded" data-machine-id="<%= machine.id %>">
          </div>

          <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
            <div class="flex items-center">
              <% if (machine.status === 'online') { %>
                <div class="w-3 h-3 rounded-full bg-green-500 mr-2"></div>
              <% } else { %>
                <div class="w-3 h-3 rounded-full bg-red-500 mr-2"></div>
              <% } %>
              <h3 class="text-lg font-medium text-gray-900"><%= machine.name %></h3>
            </div>
            <div class="flex items-center">
              <span class="text-xs font-medium px-2 py-1 rounded-full <%= machine.status === 'online' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                <%= machine.status === 'online' ? '在线' : '离线' %>
              </span>
            </div>
          </div>

          <div class="px-6 py-4">
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div>
                <p class="text-sm text-gray-500">IP 地址</p>
                <p class="text-sm font-medium text-gray-900"><%= machine.ip_address %></p>
              </div>
              <div>
                <p class="text-sm text-gray-500">最后心跳</p>
                <p class="text-sm font-medium text-gray-900"><%= new Date(machine.last_heartbeat).toLocaleString() %></p>
              </div>
              <div>
                <p class="text-sm text-gray-500">活跃会话</p>
                <p class="text-sm font-medium text-gray-900"><%= machine.active_sessions %></p>
              </div>
              <div>
                <p class="text-sm text-gray-500">最大会话数</p>
                <p class="text-sm font-medium text-gray-900"><%= machine.max_sessions %></p>
              </div>
            </div>

            <div class="mb-4">
              <div class="flex justify-between mb-1">
                <span class="text-xs font-medium text-gray-700">负载</span>
                <span class="text-xs font-medium text-gray-700"><%= machine.load %>%</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="bg-blue-600 h-2 rounded-full" style="width: <%= machine.load %>%"></div>
              </div>
            </div>

            <div class="flex justify-between">
              <a href="/admin/machines/<%= machine.id %>" class="text-primary-600 hover:text-primary-900 text-sm font-medium">
                详情
              </a>
              <div class="flex space-x-2">
                <button class="text-green-600 hover:text-green-900 health-check-machine-btn" data-machine-id="<%= machine.id %>" title="健康检查">
                  <i class="fas fa-heartbeat"></i>
                </button>
                <button class="text-blue-600 hover:text-blue-900 edit-machine-btn" data-machine-id="<%= machine.id %>" title="编辑">
                  <i class="fas fa-edit"></i>
                </button>
                <% if (machine.status === 'online') { %>
                  <button class="text-yellow-600 hover:text-yellow-900 restart-machine-btn" data-machine-id="<%= machine.id %>">
                    <i class="fas fa-redo"></i>
                  </button>
                <% } %>
                <button class="text-red-600 hover:text-red-900 delete-machine-btn" data-machine-id="<%= machine.id %>">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- 分页 -->
    <div class="flex items-center justify-between mt-6">
      <div class="text-sm text-gray-700">
        显示 <span class="font-medium"><%= (page - 1) * limit + 1 %></span> 到 <span class="font-medium"><%= Math.min(page * limit, totalMachines) %></span> 台，共 <span class="font-medium"><%= totalMachines %></span> 台
      </div>
      <div class="flex space-x-2">
        <% if (page > 1) { %>
          <a href="/admin/machines?page=<%= page - 1 %>&limit=<%= limit %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            上一页
          </a>
        <% } else { %>
          <button disabled class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
            上一页
          </button>
        <% } %>

        <% if (page * limit < totalMachines) { %>
          <a href="/admin/machines?page=<%= page + 1 %>&limit=<%= limit %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            下一页
          </a>
        <% } else { %>
          <button disabled class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
            下一页
          </button>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- 重启机器确认模态框 -->
<div id="restart-machine-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">重启机器</h3>
      <button id="close-restart-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="p-6">
      <p class="text-gray-700 mb-4">确定要重启此机器吗？这将中断所有正在运行的会话。</p>

      <div class="flex justify-end">
        <button id="cancel-restart-machine" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 mr-3">
          取消
        </button>
        <button id="confirm-restart-machine" class="bg-yellow-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-yellow-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500">
          重启
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 删除机器确认模态框 -->
<div id="delete-machine-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">删除机器</h3>
      <button id="close-delete-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="p-6">
      <p class="text-gray-700 mb-4">确定要删除此机器吗？此操作无法撤销。</p>

      <div class="flex justify-end">
        <button id="cancel-delete-machine" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 mr-3">
          取消
        </button>
        <button id="confirm-delete-machine" class="bg-red-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
          删除
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 添加机器模态框 -->
<div id="add-machine-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">添加新机器</h3>
      <button id="close-add-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="p-6">
      <form id="add-machine-form">
        <div class="mb-4">
          <label for="machine-hostname" class="block text-sm font-medium text-gray-700 mb-1">主机名</label>
          <input type="text" id="machine-hostname" name="hostname" required
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"
            placeholder="例如: machine-01">
        </div>
        <div class="mb-4">
          <label for="machine-ip" class="block text-sm font-medium text-gray-700 mb-1">IP 地址</label>
          <input type="text" id="machine-ip" name="ip" required
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"
            placeholder="例如: 192.168.1.100">
          <p class="mt-1 text-xs text-gray-500">有效的 IPv4 地址格式</p>
        </div>
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label for="machine-grpc-port" class="block text-sm font-medium text-gray-700 mb-1">gRPC 端口</label>
            <input type="number" id="machine-grpc-port" name="grpcPort" min="1" max="65535"
              class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"
              placeholder="50051">
          </div>
          <div>
            <label for="machine-proxy-port" class="block text-sm font-medium text-gray-700 mb-1">代理端口</label>
            <input type="number" id="machine-proxy-port" name="proxyPort" min="1" max="65535"
              class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"
              placeholder="3000">
          </div>
        </div>
        <div class="mb-4">
          <label for="machine-max-instances" class="block text-sm font-medium text-gray-700 mb-1">最大实例数</label>
          <input type="number" id="machine-max-instances" name="maxInstances" min="1" max="100" value="10" required
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
        </div>
        <div class="flex justify-end space-x-3">
          <button type="button" id="cancel-add-machine" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            取消
          </button>
          <button type="submit" class="bg-blue-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            添加
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 编辑机器模态框 -->
<div id="edit-machine-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">编辑机器配置</h3>
      <button id="close-edit-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="p-6">
      <form id="edit-machine-form">
        <input type="hidden" name="machineId" id="edit-machine-id">
        <div class="mb-4">
          <label for="edit-hostname" class="block text-sm font-medium text-gray-700 mb-1">主机名</label>
          <input type="text" id="edit-hostname" name="hostname" required
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
        </div>
        <div class="mb-4">
          <label for="edit-ip" class="block text-sm font-medium text-gray-700 mb-1">IP 地址</label>
          <input type="text" id="edit-ip" name="ip" required
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
          <p class="mt-1 text-xs text-gray-500">有效的 IPv4 地址格式</p>
        </div>
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label for="edit-grpc-port" class="block text-sm font-medium text-gray-700 mb-1">gRPC 端口</label>
            <input type="number" id="edit-grpc-port" name="grpcPort" min="1" max="65535"
              class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
          </div>
          <div>
            <label for="edit-proxy-port" class="block text-sm font-medium text-gray-700 mb-1">代理端口</label>
            <input type="number" id="edit-proxy-port" name="proxyPort" min="1" max="65535"
              class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
          </div>
        </div>
        <div class="mb-4">
          <label for="edit-max-instances" class="block text-sm font-medium text-gray-700 mb-1">最大实例数</label>
          <input type="number" id="edit-max-instances" name="maxInstances" min="1" max="100" required
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
        </div>
        <div class="flex justify-end space-x-3">
          <button type="button" id="cancel-edit" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            取消
          </button>
          <button type="submit" class="bg-blue-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            保存
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // 添加机器模态框
  const addMachineBtn = document.getElementById('add-machine-btn');
  const addMachineModal = document.getElementById('add-machine-modal');
  const closeAddModal = document.getElementById('close-add-modal');
  const cancelAddMachine = document.getElementById('cancel-add-machine');
  const addMachineForm = document.getElementById('add-machine-form');

  addMachineBtn?.addEventListener('click', () => {
    addMachineModal.classList.remove('hidden');
  });

  closeAddModal?.addEventListener('click', () => {
    addMachineModal.classList.add('hidden');
  });

  cancelAddMachine?.addEventListener('click', () => {
    addMachineModal.classList.add('hidden');
  });

  addMachineForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(addMachineForm);
    const data = {
      hostname: formData.get('hostname'),
      ip: formData.get('ip'),
      grpcPort: formData.get('grpcPort') ? parseInt(formData.get('grpcPort')) : undefined,
      proxyPort: formData.get('proxyPort') ? parseInt(formData.get('proxyPort')) : undefined,
      maxInstances: parseInt(formData.get('maxInstances')) || 10
    };

    try {
      const response = await fetch('/api/admin/machines', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      if (result.success) {
        // 刷新页面
        window.location.reload();
      } else {
        alert('添加机器失败: ' + (result.error || result.message || '未知错误'));
      }
    } catch (error) {
      alert('添加机器失败: ' + error.message);
    }
  });

  addMachineModal?.addEventListener('click', (e) => {
    if (e.target === addMachineModal) {
      addMachineModal.classList.add('hidden');
    }
  });

  // 重启机器模态框
  const restartMachineButtons = document.querySelectorAll('.restart-machine-btn');
  const restartMachineModal = document.getElementById('restart-machine-modal');
  const closeRestartModal = document.getElementById('close-restart-modal');
  const cancelRestartMachine = document.getElementById('cancel-restart-machine');
  const confirmRestartMachine = document.getElementById('confirm-restart-machine');
  let currentMachineId = null;

  restartMachineButtons.forEach(button => {
    button.addEventListener('click', () => {
      currentMachineId = button.getAttribute('data-machine-id');
      restartMachineModal.classList.remove('hidden');
    });
  });

  closeRestartModal?.addEventListener('click', () => {
    restartMachineModal.classList.add('hidden');
  });

  cancelRestartMachine?.addEventListener('click', () => {
    restartMachineModal.classList.add('hidden');
  });

  confirmRestartMachine?.addEventListener('click', async () => {
    if (!currentMachineId) return;

    try {
      const response = await fetch(`/api/machines/${currentMachineId}/restart`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      const result = await response.json();

      if (result.success) {
        // 刷新页面
        window.location.reload();
      } else {
        alert('重启机器失败: ' + result.message);
      }
    } catch (error) {
      alert('重启机器失败: ' + error.message);
    } finally {
      restartMachineModal.classList.add('hidden');
    }
  });

  // 删除机器模态框
  const deleteMachineButtons = document.querySelectorAll('.delete-machine-btn');
  const deleteMachineModal = document.getElementById('delete-machine-modal');
  const closeDeleteModal = document.getElementById('close-delete-modal');
  const cancelDeleteMachine = document.getElementById('cancel-delete-machine');
  const confirmDeleteMachine = document.getElementById('confirm-delete-machine');

  deleteMachineButtons.forEach(button => {
    button.addEventListener('click', () => {
      currentMachineId = button.getAttribute('data-machine-id');
      deleteMachineModal.classList.remove('hidden');
    });
  });

  closeDeleteModal?.addEventListener('click', () => {
    deleteMachineModal.classList.add('hidden');
  });

  cancelDeleteMachine?.addEventListener('click', () => {
    deleteMachineModal.classList.add('hidden');
  });

  confirmDeleteMachine?.addEventListener('click', async () => {
    if (!currentMachineId) return;

    try {
      const response = await fetch(`/api/machines/${currentMachineId}`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      const result = await response.json();

      if (result.success) {
        // 刷新页面
        window.location.reload();
      } else {
        alert('删除机器失败: ' + (result.error || result.message || '未知错误'));
      }
    } catch (error) {
      console.error('删除机器失败:', error);
      alert('删除机器失败: ' + (error.message || '未知错误'));
    } finally {
      deleteMachineModal.classList.add('hidden');
    }
  });

  // 点击模态框背景关闭模态框
  restartMachineModal?.addEventListener('click', (e) => {
    if (e.target === restartMachineModal) {
      restartMachineModal.classList.add('hidden');
    }
  });

  deleteMachineModal?.addEventListener('click', (e) => {
    if (e.target === deleteMachineModal) {
      deleteMachineModal.classList.add('hidden');
    }
  });

  // 搜索功能
  const searchInput = document.getElementById('search-machines');
  searchInput?.addEventListener('input', () => {
    const searchTerm = searchInput.value.toLowerCase();
    const cards = document.querySelectorAll('.bg-white.border.rounded-lg');

    cards.forEach(card => {
      const machineName = card.querySelector('h3').textContent.toLowerCase();
      const ipAddress = card.querySelector('.grid-cols-2 div:first-child p:last-child').textContent.toLowerCase();

      if (machineName.includes(searchTerm) || ipAddress.includes(searchTerm)) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  });

  // 辅助函数：构建带筛选参数的 URL
  function buildMachineUrl(params) {
    const url = new URL(window.location.href);
    // 更新参数
    Object.keys(params).forEach(key => {
      if (params[key] === '' || params[key] === null || params[key] === undefined) {
        url.searchParams.delete(key);
      } else {
        url.searchParams.set(key, params[key]);
      }
    });
    return url.toString();
  }

  // 状态筛选 - 通过 URL 参数
  const statusFilter = document.getElementById('status-filter');
  statusFilter?.addEventListener('change', () => {
    const selectedStatus = statusFilter.value;
    window.location.href = buildMachineUrl({ status: selectedStatus });
  });

  // 刷新按钮
  const refreshBtn = document.getElementById('refresh-btn');
  refreshBtn?.addEventListener('click', () => {
    window.location.reload();
  });

  // 批量操作功能
  const selectAllMachinesCheckbox = document.getElementById('select-all-machines');
  const machineCheckboxes = document.querySelectorAll('.machine-checkbox');
  const batchActions = document.getElementById('batch-actions');
  const selectedCountSpan = document.getElementById('selected-count');
  const batchRestartBtn = document.getElementById('batch-restart-btn');
  const cancelSelectionBtn = document.getElementById('cancel-selection-btn');

  let selectedMachineIds = [];

  // 全选/取消全选
  selectAllMachinesCheckbox?.addEventListener('change', () => {
    machineCheckboxes.forEach(checkbox => {
      checkbox.checked = selectAllMachinesCheckbox.checked;
    });
    updateSelectedMachines();
  });

  // 单个复选框变化
  machineCheckboxes.forEach(checkbox => {
    checkbox.addEventListener('change', () => {
      updateSelectedMachines();
      // 更新全选框状态
      const allChecked = Array.from(machineCheckboxes).every(cb => cb.checked);
      selectAllMachinesCheckbox.checked = allChecked && machineCheckboxes.length > 0;
    });
  });

  // 更新选中机器列表
  function updateSelectedMachines() {
    selectedMachineIds = Array.from(machineCheckboxes)
      .filter(cb => cb.checked)
      .map(cb => cb.getAttribute('data-machine-id'));

    if (selectedMachineIds.length > 0) {
      batchActions?.classList.remove('hidden');
      if (selectedCountSpan) {
        selectedCountSpan.textContent = selectedMachineIds.length;
      }
    } else {
      batchActions?.classList.add('hidden');
    }
  }

  // 取消选择
  cancelSelectionBtn?.addEventListener('click', () => {
    machineCheckboxes.forEach(cb => cb.checked = false);
    selectAllMachinesCheckbox.checked = false;
    updateSelectedMachines();
  });

  // 批量重启机器
  batchRestartBtn?.addEventListener('click', async () => {
    if (selectedMachineIds.length === 0) {
      alert('请选择要重启的机器');
      return;
    }

    if (!confirm(`确定要重启选中的 ${selectedMachineIds.length} 台机器吗？这将中断所有正在运行的会话。`)) {
      return;
    }

    try {
      const response = await fetch('/api/admin/machines/batch-restart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ machineIds: selectedMachineIds })
      });

      const result = await response.json();

      if (result.success) {
        let message = `成功重启 ${result.data.restarted.length} 台机器`;
        if (result.data.failed.length > 0) {
          message += `，${result.data.failed.length} 台失败`;
          console.error('重启失败的机器:', result.data.failed);
        }
        alert(message);
        window.location.reload();
      } else {
        alert('批量重启失败: ' + result.message);
      }
    } catch (error) {
      alert('批量重启失败: ' + error.message);
    }
  });

  // 批量健康检查
  const batchHealthCheckBtn = document.getElementById('batch-health-check-btn');
  batchHealthCheckBtn?.addEventListener('click', async () => {
    // 获取所有机器ID
    const allMachineIds = Array.from(document.querySelectorAll('.machine-checkbox'))
      .map(cb => cb.getAttribute('data-machine-id'));

    if (allMachineIds.length === 0) {
      alert('没有可检查的机器');
      return;
    }

    try {
      const response = await fetch('/api/admin/machines/health-check/batch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ machineIds: allMachineIds })
      });

      const result = await response.json();

      if (result.success) {
        let message = `健康检查完成:\n健康: ${result.data.healthy} 台\n不健康: ${result.data.unhealthy} 台`;
        if (result.data.unhealthy > 0) {
          message += '\n\n不健康的机器:';
          result.data.results.filter(r => r.status === 'unhealthy').forEach(r => {
            message += `\n- ${r.machineId}: ${r.error || '连接失败'}`;
          });
        }
        alert(message);
      } else {
        alert('批量健康检查失败: ' + result.message);
      }
    } catch (error) {
      alert('批量健康检查失败: ' + error.message);
    }
  });

  // 编辑机器功能
  const editMachineButtons = document.querySelectorAll('.edit-machine-btn');
  const editMachineModal = document.getElementById('edit-machine-modal');
  const closeEditModal = document.getElementById('close-edit-modal');
  const cancelEdit = document.getElementById('cancel-edit');
  const editMachineForm = document.getElementById('edit-machine-form');

  editMachineButtons.forEach(button => {
    button.addEventListener('click', async () => {
      const machineId = button.getAttribute('data-machine-id');
      const machineCard = button.closest('.machine-card');

      // 从卡片中获取机器信息
      const hostname = machineCard.querySelector('h3')?.textContent || '';
      const ip = machineCard.querySelector('.grid-cols-2 div:first-child p:last-child')?.textContent || '';

      // 填充表单
      document.getElementById('edit-machine-id').value = machineId;
      document.getElementById('edit-hostname').value = hostname;
      document.getElementById('edit-ip').value = ip;

      editMachineModal?.classList.remove('hidden');
    });
  });

  closeEditModal?.addEventListener('click', () => {
    editMachineModal?.classList.add('hidden');
  });

  cancelEdit?.addEventListener('click', () => {
    editMachineModal?.classList.add('hidden');
  });

  editMachineForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(editMachineForm);
    const machineId = formData.get('machineId');
    const data = {
      hostname: formData.get('hostname'),
      ip: formData.get('ip'),
      grpcPort: formData.get('grpcPort') ? parseInt(formData.get('grpcPort')) : undefined,
      proxyPort: formData.get('proxyPort') ? parseInt(formData.get('proxyPort')) : undefined,
      maxInstances: parseInt(formData.get('maxInstances')) || 10
    };

    try {
      const response = await fetch(`/api/admin/machines/${machineId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      if (result.success) {
        alert('机器配置已更新');
        window.location.reload();
      } else {
        alert('更新失败: ' + (result.error || result.message || '未知错误'));
      }
    } catch (error) {
      alert('更新失败: ' + error.message);
    }
  });

  // 健康检查功能
  const healthCheckButtons = document.querySelectorAll('.health-check-machine-btn');

  healthCheckButtons.forEach(button => {
    button.addEventListener('click', async () => {
      const machineId = button.getAttribute('data-machine-id');
      const icon = button.querySelector('i');

      // 显示加载状态
      if (icon) {
        icon.className = 'fas fa-spinner fa-spin';
      }
      button.disabled = true;

      try {
        const response = await fetch(`/api/admin/machines/${machineId}/health-check`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        const result = await response.json();

        if (result.success) {
          const data = result.data;
          let status = data.status === 'healthy' ? '健康' : '不健康';
          let message = `机器状态: ${status}\n`;

          if (data.grpcConnected) {
            message += `gRPC 连接: 已连接\n`;
            if (data.responseTime !== undefined) {
              message += `响应时间: ${data.responseTime}ms\n`;
            }
            if (data.systemInfo) {
              message += `\n系统信息:\n`;
              message += `CPU: ${data.systemInfo.cpuUsage}%\n`;
              message += `内存: ${data.systemInfo.memoryUsage}%\n`;
              message += `磁盘: ${data.systemInfo.diskUsage}%\n`;
            }
            if (data.activeInstances !== undefined) {
              message += `活跃实例: ${data.activeInstances}\n`;
            }
          }

          if (data.error) {
            message += `\n错误: ${data.error}`;
          }

          alert(message);
        } else {
          alert('健康检查失败: ' + result.message);
        }
      } catch (error) {
        alert('健康检查失败: ' + error.message);
      } finally {
        // 恢复按钮状态
        if (icon) {
          icon.className = 'fas fa-heartbeat';
        }
        button.disabled = false;
      }
    });
  });
</script>
