<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- 个人资料卡片 -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-700">个人资料</h3>
      </div>
      <div class="p-6">
        <form id="profile-form">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="username" class="block text-sm font-medium text-gray-700 mb-1">用户名</label>
              <input type="text" id="username" name="username" value="<%= user.username %>" readonly
                class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm bg-gray-50 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
              <p class="mt-1 text-xs text-gray-500">用户名不可更改</p>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1">邮箱</label>
              <input type="email" id="email" name="email" value="<%= user.email || '' %>"
                class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            </div>

            <div>
              <label for="role" class="block text-sm font-medium text-gray-700 mb-1">角色</label>
              <input type="text" id="role" name="role" value="<%= user.role === 'admin' ? '管理员' : '普通用户' %>" readonly
                class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm bg-gray-50 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            </div>

            <div>
              <label for="created-at" class="block text-sm font-medium text-gray-700 mb-1">注册时间</label>
              <input type="text" id="created-at" name="created-at" value="<%= new Date(user.created_at).toLocaleString() %>" readonly
                class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm bg-gray-50 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            </div>

            <div class="md:col-span-2">
              <label for="webhook-url" class="block text-sm font-medium text-gray-700 mb-1">Webhook URL</label>
              <input type="url" id="webhook-url" name="webhook-url" value="<%= user.webhook_url || '' %>"
                class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500"
                placeholder="https://example.com/webhook">
              <p class="mt-1 text-xs text-gray-500">当会话结束时，系统将发送通知到此 URL</p>
            </div>
          </div>

          <div class="mt-6">
            <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
              保存更改
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- 修改密码卡片 -->
    <div class="bg-white rounded-lg shadow mt-6">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-700">修改密码</h3>
      </div>
      <div class="p-6">
        <form id="password-form">
          <div class="space-y-4">
            <div>
              <label for="current-password" class="block text-sm font-medium text-gray-700 mb-1">当前密码</label>
              <input type="password" id="current-password" name="current_password" required
                class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            </div>

            <div>
              <label for="new-password" class="block text-sm font-medium text-gray-700 mb-1">新密码</label>
              <input type="password" id="new-password" name="new_password" required
                class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            </div>

            <div>
              <label for="confirm-password" class="block text-sm font-medium text-gray-700 mb-1">确认新密码</label>
              <input type="password" id="confirm-password" name="confirm_password" required
                class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            </div>
          </div>

          <div class="mt-6">
            <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
              更新密码
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- API Key 和算力卡片 -->
  <div>
    <!-- API Key 卡片 -->
    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-700">API Key</h3>
      </div>
      <div class="p-6">
        <div class="mb-4">
          <label for="api-key" class="block text-sm font-medium text-gray-700 mb-1">您的 API Key</label>
          <% if (user.api_key) { %>
          <div class="flex">
            <input type="text" id="api-key" name="api_key" value="<%= user.api_key %>" readonly
              class="block w-full px-3 py-2 border border-gray-300 rounded-l-md shadow-sm bg-gray-50 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <button id="copy-api-key" class="bg-gray-100 px-3 py-2 border border-l-0 border-gray-300 rounded-r-md text-gray-700 hover:bg-gray-200">
              <i class="fas fa-copy"></i>
            </button>
          </div>
          <p class="mt-1 text-xs text-gray-500">用于访问 API 的密钥，请妥善保管</p>
          <% } else { %>
          <div class="flex">
            <input type="text" id="api-key" name="api_key" value="" readonly
              class="block w-full px-3 py-2 border border-gray-300 rounded-l-md shadow-sm bg-gray-50 focus:outline-none focus:ring-primary-500 focus:border-primary-500" placeholder="暂无 API Key，请点击下方按钮生成">
            <button id="copy-api-key" disabled class="bg-gray-50 px-3 py-2 border border-l-0 border-gray-300 rounded-r-md text-gray-400 cursor-not-allowed">
              <i class="fas fa-copy"></i>
            </button>
          </div>
          <% } %>
        </div>

        <button id="regenerate-api-key" class="inline-flex items-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-yellow-600 hover:bg-yellow-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500">
          <i class="fas fa-<%= user.api_key ? 'sync-alt' : 'plus' %> mr-2"></i> <%= user.api_key ? '重新生成 API Key' : '生成 API Key' %>
        </button>
      </div>
    </div>

    <!-- 算力卡片 -->
    <div class="bg-white rounded-lg shadow mt-6">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-700">算力点数</h3>
      </div>
      <div class="p-6">
        <div class="flex items-center justify-between mb-4">
          <div>
            <p class="text-sm text-gray-500">当前可用点数</p>
            <p class="text-3xl font-bold text-gray-900"><%= user.credits %></p>
          </div>
          <div class="p-3 bg-green-100 rounded-full">
            <i class="fas fa-bolt text-green-500 text-xl"></i>
          </div>
        </div>

        <div class="mb-4">
          <div class="flex justify-between mb-1">
            <span class="text-xs font-medium text-gray-700">使用情况</span>
            <span class="text-xs font-medium text-gray-700"><%= Math.round((user.used_credits / (user.credits + user.used_credits)) * 100) %>%</span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-2">
            <div class="bg-green-600 h-2 rounded-full" style="width: <%= Math.round((user.used_credits / (user.credits + user.used_credits)) * 100) %>%"></div>
          </div>
          <p class="mt-1 text-xs text-gray-500">已使用 <%= user.used_credits %> 点数</p>
        </div>

        <div class="border-t border-gray-200 pt-4">
          <h4 class="text-sm font-medium text-gray-700 mb-2">点数使用记录</h4>
          <% if (creditHistory && creditHistory.length > 0) { %>
            <div class="space-y-3">
              <% creditHistory.forEach(record => { %>
                <div class="flex justify-between items-center">
                  <div>
                    <p class="text-sm font-medium text-gray-900"><%= record.action === 'add' ? '添加' : '使用' %> <%= Math.abs(record.amount) %> 点数</p>
                    <p class="text-xs text-gray-500"><%= new Date(record.created_at).toLocaleString() %></p>
                  </div>
                  <span class="text-sm <%= record.action === 'add' ? 'text-green-600' : 'text-red-600' %>">
                    <%= record.action === 'add' ? '+' : '-' %><%= Math.abs(record.amount) %>
                  </span>
                </div>
              <% }); %>
            </div>
            <div class="mt-3 text-right">
              <a href="/admin/credits/history" class="text-primary-600 hover:text-primary-800 text-sm font-medium">
                查看全部 <i class="fas fa-arrow-right ml-1"></i>
              </a>
            </div>
          <% } else { %>
            <p class="text-sm text-gray-500">暂无点数使用记录</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 重新生成 API Key 确认模态框 -->
<div id="regenerate-key-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900"><%= user.api_key ? '重新生成 API Key' : '生成 API Key' %></h3>
      <button id="close-key-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="p-6">
      <% if (user.api_key) { %>
      <p class="text-gray-700 mb-4">确定要重新生成 API Key 吗？这将使当前的 API Key 失效，所有使用旧 Key 的应用程序将无法访问 API。</p>
      <% } else { %>
      <p class="text-gray-700 mb-4">确定要生成 API Key 吗？生成后您将可以使用它来访问 API。</p>
      <% } %>

      <div class="flex justify-end">
        <button id="cancel-regenerate-key" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 mr-3">
          取消
        </button>
        <button id="confirm-regenerate-key" class="bg-yellow-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-yellow-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500">
          <%= user.api_key ? '重新生成' : '生成' %>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // 复制 API Key
  const copyApiKeyBtn = document.getElementById('copy-api-key');
  const apiKeyInput = document.getElementById('api-key');

  copyApiKeyBtn?.addEventListener('click', () => {
    apiKeyInput.select();
    document.execCommand('copy');

    // 显示复制成功提示
    const originalText = copyApiKeyBtn.innerHTML;
    copyApiKeyBtn.innerHTML = '<i class="fas fa-check"></i>';
    copyApiKeyBtn.classList.add('bg-green-100', 'text-green-700');

    setTimeout(() => {
      copyApiKeyBtn.innerHTML = originalText;
      copyApiKeyBtn.classList.remove('bg-green-100', 'text-green-700');
    }, 2000);
  });

  // 重新生成 API Key 模态框
  const regenerateKeyBtn = document.getElementById('regenerate-api-key');
  const regenerateKeyModal = document.getElementById('regenerate-key-modal');
  const closeKeyModal = document.getElementById('close-key-modal');
  const cancelRegenerateKey = document.getElementById('cancel-regenerate-key');
  const confirmRegenerateKey = document.getElementById('confirm-regenerate-key');

  regenerateKeyBtn?.addEventListener('click', () => {
    regenerateKeyModal.classList.remove('hidden');
  });

  closeKeyModal?.addEventListener('click', () => {
    regenerateKeyModal.classList.add('hidden');
  });

  cancelRegenerateKey?.addEventListener('click', () => {
    regenerateKeyModal.classList.add('hidden');
  });

  confirmRegenerateKey?.addEventListener('click', async () => {
    try {
      const response = await fetch('/api/users/me/apikey/regenerate', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      const result = await response.json();

      if (result.success) {
        // 关闭模态框
        regenerateKeyModal.classList.add('hidden');

        // 显示成功消息
        alert('API Key 已成功生成');

        // 直接刷新页面显示新的 API Key
        window.location.reload();
      } else {
        alert('重新生成 API Key 失败: ' + result.error);
      }
    } catch (error) {
      alert('重新生成 API Key 失败: ' + error.message);
    }
  });

  // 点击模态框背景关闭模态框
  regenerateKeyModal?.addEventListener('click', (e) => {
    if (e.target === regenerateKeyModal) {
      regenerateKeyModal.classList.add('hidden');
    }
  });

  // 个人资料表单提交
  const profileForm = document.getElementById('profile-form');
  profileForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(profileForm);
    const userData = {
      email: formData.get('email'),
      webhook_url: formData.get('webhook-url')
    };

    try {
      const response = await fetch('/api/users/me', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(userData)
      });

      const result = await response.json();

      if (result.success) {
        alert('个人资料已成功更新');
      } else {
        alert('更新个人资料失败: ' + result.message);
      }
    } catch (error) {
      alert('更新个人资料失败: ' + error.message);
    }
  });

  // 密码表单提交
  const passwordForm = document.getElementById('password-form');
  passwordForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(passwordForm);
    const currentPassword = formData.get('current_password');
    const newPassword = formData.get('new_password');
    const confirmPassword = formData.get('confirm_password');

    if (newPassword !== confirmPassword) {
      alert('新密码和确认密码不匹配');
      return;
    }

    try {
      const response = await fetch('/api/users/me/password', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          current_password: currentPassword,
          new_password: newPassword
        })
      });

      const result = await response.json();

      if (result.success) {
        alert('密码已成功更新');
        passwordForm.reset();
      } else {
        alert('更新密码失败: ' + result.message);
      }
    } catch (error) {
      alert('更新密码失败: ' + error.message);
    }
  });
</script>
