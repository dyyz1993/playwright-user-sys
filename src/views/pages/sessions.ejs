<!-- 统计卡片 -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">总会话数</p>
        <p class="text-2xl font-bold" id="total-sessions">-</p>
      </div>
      <div class="p-3 bg-blue-100 rounded-full">
        <i class="fas fa-list text-blue-500"></i>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">活跃会话</p>
        <p class="text-2xl font-bold text-green-600" id="active-sessions">-</p>
      </div>
      <div class="p-3 bg-green-100 rounded-full">
        <i class="fas fa-play-circle text-green-500"></i>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">总消耗积分</p>
        <p class="text-2xl font-bold text-yellow-600" id="total-credits">-</p>
      </div>
      <div class="p-3 bg-yellow-100 rounded-full">
        <i class="fas fa-coins text-yellow-500"></i>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">平均时长</p>
        <p class="text-2xl font-bold text-purple-600" id="avg-duration">-</p>
      </div>
      <div class="p-3 bg-purple-100 rounded-full">
        <i class="fas fa-clock text-purple-500"></i>
      </div>
    </div>
  </div>
</div>

<div class="bg-white rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
    <h3 class="text-lg font-medium text-gray-700">会话管理</h3>
    <div class="flex items-center space-x-4">
      <!-- 自动刷新开关 -->
      <div class="flex items-center">
        <input type="checkbox" id="auto-refresh" class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded mr-2">
        <label for="auto-refresh" class="text-sm text-gray-600">自动刷新</label>
      </div>
      <button id="refresh-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
        <i class="fas fa-sync-alt"></i>
      </button>
      <div class="relative">
        <button id="export-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
          <i class="fas fa-download mr-1"></i> 导出
        </button>
        <div id="export-menu" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-10 hidden">
          <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">导出为 CSV</a>
          <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">导出为 Excel</a>
        </div>
      </div>
    </div>
  </div>

  <div class="p-6">
    <!-- 搜索和筛选 -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6 space-y-4 md:space-y-0">
      <div class="flex flex-wrap items-center gap-4">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-search text-gray-400"></i>
          </div>
          <input type="text" id="search-sessions" name="search" placeholder="搜索会话..."
            class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>
        <div>
          <select id="status-filter" name="status" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="">所有状态</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>活跃</option>
            <option value="ended" <%= filters.status === 'ended' ? 'selected' : '' %>>已结束</option>
            <option value="error" <%= filters.status === 'error' ? 'selected' : '' %>>错误</option>
          </select>
        </div>
        <div>
          <select id="user-filter" name="user_id" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="">所有用户</option>
            <% users.forEach(user => { %>
              <option value="<%= user.id %>" <%= filters.userId == user.id ? 'selected' : '' %>><%= user.username %></option>
            <% }); %>
          </select>
        </div>
        <!-- 排序下拉框 -->
        <div>
          <select id="sort-select" name="sort" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="">默认排序</option>
            <option value="created_at:desc">创建时间(新→旧)</option>
            <option value="created_at:asc">创建时间(旧→新)</option>
            <option value="duration:desc">持续时间(长→短)</option>
            <option value="duration:asc">持续时间(短→长)</option>
            <option value="credits_used:desc">消耗积分(多→少)</option>
            <option value="credits_used:asc">消耗积分(少→多)</option>
            <option value="updated_at:desc">更新时间(新→旧)</option>
          </select>
        </div>
      </div>

      <div class="flex items-center space-x-4">
        <div>
          <select id="date-range" name="dateRange" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="all" <%= filters.dateRange === 'all' ? 'selected' : '' %>>所有时间</option>
            <option value="today" <%= filters.dateRange === 'today' ? 'selected' : '' %>>今天</option>
            <option value="yesterday" <%= filters.dateRange === 'yesterday' ? 'selected' : '' %>>昨天</option>
            <option value="week" <%= filters.dateRange === 'week' ? 'selected' : '' %>>本周</option>
            <option value="month" <%= filters.dateRange === 'month' ? 'selected' : '' %>>本月</option>
          </select>
        </div>
      </div>
    </div>

    <!-- 批量操作按钮 -->
    <div id="batch-actions" class="hidden mb-4 p-3 bg-blue-50 border border-blue-200 rounded-md flex items-center justify-between">
      <span class="text-sm text-blue-700">已选择 <span id="selected-count">0</span> 个会话</span>
      <div class="flex space-x-2">
        <button id="batch-release-btn" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded-md text-sm font-medium">
          <i class="fas fa-stop-circle mr-1"></i> 批量结束
        </button>
        <button id="cancel-selection-btn" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-3 py-1.5 rounded-md text-sm font-medium">
          取消选择
        </button>
      </div>
    </div>

    <!-- 会话表格 -->
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-12">
              <input type="checkbox" id="select-all-sessions" class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded">
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              会话 ID
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              用户
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              机器
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              状态
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              开始时间
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              持续时间
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              消耗点数
            </th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
              操作
            </th>
          </tr>
        </thead>
        <%
          // 定义活跃和已结束的状态列表（移到循环外部，避免重复声明）
          const activeStatuses = ['created', 'connected'];
          const endedStatuses = ['disconnected', 'expired', 'completed'];
        %>
        <tbody class="bg-white divide-y divide-gray-200">
          <% sessions.forEach(session => { %>
            <tr class="session-row" data-session-id="<%= session.id %>" data-status="<%= session.status %>">
              <td class="px-6 py-4 whitespace-nowrap">
                <input type="checkbox" class="session-checkbox h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded" data-session-id="<%= session.id %>">
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= session.id.substring(0, 8) %>...
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="flex-shrink-0 h-8 w-8 rounded-full bg-primary-500 flex items-center justify-center text-white font-medium">
                    <%= session.username ? session.username.charAt(0).toUpperCase() : '?' %>
                  </div>
                  <div class="ml-3">
                    <div class="text-sm font-medium text-gray-900"><%= session.username || '未知用户' %></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= session.machine_name || '未分配' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (activeStatuses.includes(session.status)) { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    活跃
                  </span>
                <% } else if (endedStatuses.includes(session.status)) { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                    已结束
                  </span>
                <% } else if (session.status === 'error') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                    错误
                  </span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                    <%= session.status %>
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= new Date(session.created_at).toLocaleString() %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if (session.duration) { %>
                  <%
                    const minutes = Math.floor(session.duration / 60);
                    const seconds = session.duration % 60;
                    if (minutes > 0) {
                  %>
                    <%= minutes %> 分 <%= seconds %> 秒
                  <% } else { %>
                    <%= seconds %> 秒
                  <% } %>
                <% } else { %>
                  0 秒
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= session.credits_used || 0 %> 点
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex justify-end space-x-2">
                  <a href="/admin/sessions/<%= session.id %>" class="text-primary-600 hover:text-primary-900">
                    <i class="fas fa-eye"></i>
                  </a>
                  <% if (activeStatuses.includes(session.status)) { %>
                    <button class="text-red-600 hover:text-red-900 end-session-btn" data-session-id="<%= session.id %>">
                      <i class="fas fa-stop-circle"></i>
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- 分页 -->
    <div class="flex items-center justify-between mt-6">
      <div class="text-sm text-gray-700">
        显示 <span class="font-medium"><%= (page - 1) * limit + 1 %></span> 到 <span class="font-medium"><%= Math.min(page * limit, totalSessions) %></span> 条，共 <span class="font-medium"><%= totalSessions %></span> 条
      </div>
      <div class="flex space-x-2">
        <% // 构建分页 URL，保留筛选参数
        const buildPageUrl = (pageNum) => {
          let url = `/admin/sessions?page=${pageNum}&limit=${limit}`;
          if (filters.status) url += `&status=${filters.status}`;
          if (filters.userId) url += `&userId=${filters.userId}`;
          if (filters.dateRange && filters.dateRange !== 'all') url += `&dateRange=${filters.dateRange}`;
          return url;
        };
        %>
        <% if (page > 1) { %>
          <a href="<%= buildPageUrl(page - 1) %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            上一页
          </a>
        <% } else { %>
          <button disabled class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
            上一页
          </button>
        <% } %>

        <% if (page * limit < totalSessions) { %>
          <a href="<%= buildPageUrl(page + 1) %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            下一页
          </a>
        <% } else { %>
          <button disabled class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
            下一页
          </button>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- 结束会话确认模态框 -->
<div id="end-session-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">结束会话</h3>
      <button id="close-end-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="p-6">
      <p class="text-gray-700 mb-4">确定要结束此会话吗？这将立即停止浏览器实例并释放资源。</p>

      <div class="flex justify-end">
        <button id="cancel-end-session" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 mr-3">
          取消
        </button>
        <button id="confirm-end-session" class="bg-red-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
          结束会话
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // 结束会话模态框
  const endSessionButtons = document.querySelectorAll('.end-session-btn');
  const endSessionModal = document.getElementById('end-session-modal');
  const closeEndModal = document.getElementById('close-end-modal');
  const cancelEndSession = document.getElementById('cancel-end-session');
  const confirmEndSession = document.getElementById('confirm-end-session');
  let currentSessionId = null;

  endSessionButtons.forEach(button => {
    button.addEventListener('click', () => {
      currentSessionId = button.getAttribute('data-session-id');
      endSessionModal.classList.remove('hidden');
    });
  });

  closeEndModal?.addEventListener('click', () => {
    endSessionModal.classList.add('hidden');
  });

  cancelEndSession?.addEventListener('click', () => {
    endSessionModal.classList.add('hidden');
  });

  confirmEndSession?.addEventListener('click', async () => {
    if (!currentSessionId) return;

    try {
      const response = await fetch(`/api/sessions/${currentSessionId}/release`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      const result = await response.json();

      if (result.success) {
        // 刷新页面
        window.location.reload();
      } else {
        alert('结束会话失败: ' + result.message);
      }
    } catch (error) {
      alert('结束会话失败: ' + error.message);
    } finally {
      endSessionModal.classList.add('hidden');
    }
  });

  // 导出菜单
  const exportBtn = document.getElementById('export-btn');
  const exportMenu = document.getElementById('export-menu');

  exportBtn?.addEventListener('click', () => {
    exportMenu.classList.toggle('hidden');
  });

  // 点击其他地方关闭导出菜单
  document.addEventListener('click', (e) => {
    if (!exportBtn?.contains(e.target) && !exportMenu?.contains(e.target)) {
      exportMenu?.classList.add('hidden');
    }
  });

  // 点击模态框背景关闭模态框
  endSessionModal?.addEventListener('click', (e) => {
    if (e.target === endSessionModal) {
      endSessionModal.classList.add('hidden');
    }
  });

  // 搜索功能（前端筛选，不影响 URL）
  const searchInput = document.getElementById('search-sessions');
  searchInput?.addEventListener('input', () => {
    const searchTerm = searchInput.value.toLowerCase();
    const rows = document.querySelectorAll('tbody tr');

    rows.forEach(row => {
      const sessionId = row.querySelector('td:first-child').textContent.toLowerCase();
      const username = row.querySelector('td:nth-child(2) .text-sm.font-medium').textContent.toLowerCase();
      const machine = row.querySelector('td:nth-child(3)').textContent.toLowerCase();

      if (sessionId.includes(searchTerm) || username.includes(searchTerm) || machine.includes(searchTerm)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  });

  // 辅助函数：构建带筛选参数的 URL
  function buildUrl(params) {
    const url = new URL(window.location.href);
    // 保留当前的分页参数
    if (!params.page && url.searchParams.has('page')) {
      params.page = url.searchParams.get('page');
    }
    // 保留当前的 limit 参数
    if (!params.limit && url.searchParams.has('limit')) {
      params.limit = url.searchParams.get('limit');
    }
    // 更新参数
    Object.keys(params).forEach(key => {
      if (params[key] === '' || params[key] === null || params[key] === undefined) {
        url.searchParams.delete(key);
      } else {
        url.searchParams.set(key, params[key]);
      }
    });
    return url.toString();
  }

  // 状态筛选 - 通过 URL 参数
  const statusFilter = document.getElementById('status-filter');
  statusFilter?.addEventListener('change', () => {
    const selectedStatus = statusFilter.value;
    window.location.href = buildUrl({ status: selectedStatus, page: 1 });
  });

  // 用户筛选 - 通过 URL 参数
  const userFilter = document.getElementById('user-filter');
  userFilter?.addEventListener('change', () => {
    const selectedUser = userFilter.value;
    window.location.href = buildUrl({ userId: selectedUser, page: 1 });
  });

  // 日期范围筛选 - 通过 URL 参数
  const dateRangeFilter = document.getElementById('date-range');
  dateRangeFilter?.addEventListener('change', () => {
    const selectedRange = dateRangeFilter.value;
    window.location.href = buildUrl({ dateRange: selectedRange, page: 1 });
  });

  // 刷新按钮
  const refreshBtn = document.getElementById('refresh-btn');
  refreshBtn?.addEventListener('click', () => {
    window.location.reload();
  });

  // 批量操作功能
  const selectAllSessionsCheckbox = document.getElementById('select-all-sessions');
  const sessionCheckboxes = document.querySelectorAll('.session-checkbox');
  const batchActions = document.getElementById('batch-actions');
  const selectedCountSpan = document.getElementById('selected-count');
  const batchReleaseBtn = document.getElementById('batch-release-btn');
  const cancelSelectionBtn = document.getElementById('cancel-selection-btn');

  let selectedSessionIds = [];

  // 全选/取消全选
  selectAllSessionsCheckbox?.addEventListener('change', () => {
    sessionCheckboxes.forEach(checkbox => {
      checkbox.checked = selectAllSessionsCheckbox.checked;
    });
    updateSelectedSessions();
  });

  // 单个复选框变化
  sessionCheckboxes.forEach(checkbox => {
    checkbox.addEventListener('change', () => {
      updateSelectedSessions();
      // 更新全选框状态
      const allChecked = Array.from(sessionCheckboxes).every(cb => cb.checked);
      selectAllSessionsCheckbox.checked = allChecked && sessionCheckboxes.length > 0;
    });
  });

  // 更新选中会话列表
  function updateSelectedSessions() {
    selectedSessionIds = Array.from(sessionCheckboxes)
      .filter(cb => cb.checked)
      .map(cb => cb.getAttribute('data-session-id'));

    if (selectedSessionIds.length > 0) {
      batchActions?.classList.remove('hidden');
      if (selectedCountSpan) {
        selectedCountSpan.textContent = selectedSessionIds.length;
      }
    } else {
      batchActions?.classList.add('hidden');
    }
  }

  // 取消选择
  cancelSelectionBtn?.addEventListener('click', () => {
    sessionCheckboxes.forEach(cb => cb.checked = false);
    selectAllSessionsCheckbox.checked = false;
    updateSelectedSessions();
  });

  // 批量结束会话
  batchReleaseBtn?.addEventListener('click', async () => {
    if (selectedSessionIds.length === 0) {
      alert('请选择要结束的会话');
      return;
    }

    if (!confirm(`确定要结束选中的 ${selectedSessionIds.length} 个会话吗？此操作将立即停止浏览器实例并释放资源。`)) {
      return;
    }

    try {
      const response = await fetch('/api/admin/sessions/batch-release', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionIds: selectedSessionIds })
      });

      const result = await response.json();

      if (result.success) {
        let message = `成功结束 ${result.data.released.length} 个会话`;
        if (result.data.failed.length > 0) {
          message += `，${result.data.failed.length} 个失败`;
          console.error('结束失败的会话:', result.data.failed);
        }
        alert(message);
        window.location.reload();
      } else {
        alert('批量结束失败: ' + result.message);
      }
    } catch (error) {
      alert('批量结束失败: ' + error.message);
    }
  });

  // 加载统计数据
  async function loadStats() {
    try {
      // 从 URL 获取当前的时间范围筛选参数
      const urlParams = new URLSearchParams(window.location.search);
      const dateRange = urlParams.get('dateRange') || 'all';

      const response = await fetch(`/api/admin/sessions/stats?dateRange=${dateRange}`);
      const result = await response.json();

      if (result.success) {
        document.getElementById('total-sessions').textContent = result.data.total;
        document.getElementById('active-sessions').textContent = result.data.active;
        document.getElementById('total-credits').textContent = result.data.totalCreditsUsed;
        document.getElementById('avg-duration').textContent = result.data.avgDuration + '秒';
      }
    } catch (error) {
      console.error('加载统计数据失败:', error);
    }
  }

  // 页面加载时获取统计数据
  loadStats();

  // 排序功能
  const sortSelect = document.getElementById('sort-select');
  sortSelect?.addEventListener('change', () => {
    const sortValue = sortSelect.value;
    if (sortValue) {
      const [sort, order] = sortValue.split(':');
      window.location.href = buildUrl({ sort, order, page: 1 });
    } else {
      // 清除排序
      const url = new URL(window.location.href);
      url.searchParams.delete('sort');
      url.searchParams.delete('order');
      window.location.href = url.toString();
    }
  });

  // 自动刷新功能
  const autoRefreshCheckbox = document.getElementById('auto-refresh');
  let refreshInterval = null;

  autoRefreshCheckbox?.addEventListener('change', () => {
    if (autoRefreshCheckbox.checked) {
      // 每10秒刷新一次
      refreshInterval = setInterval(() => {
        loadStats(); // 只刷新统计数据，不刷新整个页面
      }, 10000);
    } else {
      if (refreshInterval) {
        clearInterval(refreshInterval);
        refreshInterval = null;
      }
    }
  });
</script>
