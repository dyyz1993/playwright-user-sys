<div class="bg-white rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
    <h3 class="text-lg font-medium text-gray-700">会话管理</h3>
    <div class="flex space-x-2">
      <button id="refresh-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
        <i class="fas fa-sync-alt"></i>
      </button>
      <div class="relative">
        <button id="export-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
          <i class="fas fa-download mr-1"></i> 导出
        </button>
        <div id="export-menu" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-10 hidden">
          <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">导出为 CSV</a>
          <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">导出为 Excel</a>
        </div>
      </div>
    </div>
  </div>

  <div class="p-6">
    <!-- 搜索和筛选 -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6 space-y-4 md:space-y-0">
      <div class="flex items-center">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-search text-gray-400"></i>
          </div>
          <input type="text" id="search-sessions" placeholder="搜索会话..."
            class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>
        <div class="ml-4">
          <select id="status-filter" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="">所有状态</option>
            <option value="active">活跃</option>
            <option value="ended">已结束</option>
          </select>
        </div>
      </div>

      <div class="flex items-center space-x-4">
        <div>
          <label for="date-range" class="block text-sm font-medium text-gray-700 mb-1">日期范围</label>
          <select id="date-range" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="all">所有时间</option>
            <option value="today">今天</option>
            <option value="yesterday">昨天</option>
            <option value="week">本周</option>
            <option value="month">本月</option>
          </select>
        </div>
      </div>
    </div>

    <!-- 会话表格 -->
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              会话 ID
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              用户
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              机器
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              状态
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              开始时间
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              持续时间
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              消耗点数
            </th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
              操作
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% sessions.forEach(session => { %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= session.id.substring(0, 8) %>...
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="flex-shrink-0 h-8 w-8 rounded-full bg-primary-500 flex items-center justify-center text-white font-medium">
                    <%= session.username.charAt(0).toUpperCase() %>
                  </div>
                  <div class="ml-3">
                    <div class="text-sm font-medium text-gray-900"><%= session.username %></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= session.machine_name || '未分配' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (session.status === 'active') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    活跃
                  </span>
                <% } else if (session.status === 'ended') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                    已结束
                  </span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                    <%= session.status %>
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= new Date(session.created_at).toLocaleString() %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if (session.duration) { %>
                  <%
                    const minutes = Math.floor(session.duration / 60);
                    const seconds = session.duration % 60;
                    if (minutes > 0) {
                  %>
                    <%= minutes %> 分 <%= seconds %> 秒
                  <% } else { %>
                    <%= seconds %> 秒
                  <% } %>
                <% } else { %>
                  0 秒
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= session.credits_used || 0 %> 点
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex justify-end space-x-2">
                  <a href="/admin/sessions/<%= session.id %>" class="text-primary-600 hover:text-primary-900">
                    <i class="fas fa-eye"></i>
                  </a>
                  <% if (session.status === 'active') { %>
                    <button class="text-red-600 hover:text-red-900 end-session-btn" data-session-id="<%= session.id %>">
                      <i class="fas fa-stop-circle"></i>
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- 分页 -->
    <div class="flex items-center justify-between mt-6">
      <div class="text-sm text-gray-700">
        显示 <span class="font-medium"><%= (page - 1) * limit + 1 %></span> 到 <span class="font-medium"><%= Math.min(page * limit, totalSessions) %></span> 条，共 <span class="font-medium"><%= totalSessions %></span> 条
      </div>
      <div class="flex space-x-2">
        <% if (page > 1) { %>
          <a href="/admin/sessions?page=<%= page - 1 %>&limit=<%= limit %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            上一页
          </a>
        <% } else { %>
          <button disabled class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
            上一页
          </button>
        <% } %>

        <% if (page * limit < totalSessions) { %>
          <a href="/admin/sessions?page=<%= page + 1 %>&limit=<%= limit %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            下一页
          </a>
        <% } else { %>
          <button disabled class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
            下一页
          </button>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- 结束会话确认模态框 -->
<div id="end-session-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">结束会话</h3>
      <button id="close-end-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="p-6">
      <p class="text-gray-700 mb-4">确定要结束此会话吗？这将立即停止浏览器实例并释放资源。</p>

      <div class="flex justify-end">
        <button id="cancel-end-session" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 mr-3">
          取消
        </button>
        <button id="confirm-end-session" class="bg-red-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
          结束会话
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // 结束会话模态框
  const endSessionButtons = document.querySelectorAll('.end-session-btn');
  const endSessionModal = document.getElementById('end-session-modal');
  const closeEndModal = document.getElementById('close-end-modal');
  const cancelEndSession = document.getElementById('cancel-end-session');
  const confirmEndSession = document.getElementById('confirm-end-session');
  let currentSessionId = null;

  endSessionButtons.forEach(button => {
    button.addEventListener('click', () => {
      currentSessionId = button.getAttribute('data-session-id');
      endSessionModal.classList.remove('hidden');
    });
  });

  closeEndModal?.addEventListener('click', () => {
    endSessionModal.classList.add('hidden');
  });

  cancelEndSession?.addEventListener('click', () => {
    endSessionModal.classList.add('hidden');
  });

  confirmEndSession?.addEventListener('click', async () => {
    if (!currentSessionId) return;

    try {
      const response = await fetch(`/api/sessions/${currentSessionId}/release`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      const result = await response.json();

      if (result.success) {
        // 刷新页面
        window.location.reload();
      } else {
        alert('结束会话失败: ' + result.message);
      }
    } catch (error) {
      alert('结束会话失败: ' + error.message);
    } finally {
      endSessionModal.classList.add('hidden');
    }
  });

  // 导出菜单
  const exportBtn = document.getElementById('export-btn');
  const exportMenu = document.getElementById('export-menu');

  exportBtn?.addEventListener('click', () => {
    exportMenu.classList.toggle('hidden');
  });

  // 点击其他地方关闭导出菜单
  document.addEventListener('click', (e) => {
    if (!exportBtn?.contains(e.target) && !exportMenu?.contains(e.target)) {
      exportMenu?.classList.add('hidden');
    }
  });

  // 点击模态框背景关闭模态框
  endSessionModal?.addEventListener('click', (e) => {
    if (e.target === endSessionModal) {
      endSessionModal.classList.add('hidden');
    }
  });

  // 搜索功能
  const searchInput = document.getElementById('search-sessions');
  searchInput?.addEventListener('input', () => {
    const searchTerm = searchInput.value.toLowerCase();
    const rows = document.querySelectorAll('tbody tr');

    rows.forEach(row => {
      const sessionId = row.querySelector('td:first-child').textContent.toLowerCase();
      const username = row.querySelector('td:nth-child(2) .text-sm.font-medium').textContent.toLowerCase();
      const machine = row.querySelector('td:nth-child(3)').textContent.toLowerCase();

      if (sessionId.includes(searchTerm) || username.includes(searchTerm) || machine.includes(searchTerm)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  });

  // 状态筛选
  const statusFilter = document.getElementById('status-filter');
  statusFilter?.addEventListener('change', () => {
    const selectedStatus = statusFilter.value;
    const rows = document.querySelectorAll('tbody tr');

    rows.forEach(row => {
      const statusCell = row.querySelector('td:nth-child(4) span');
      const status = statusCell.textContent.trim() === '活跃' ? 'active' : 'ended';

      if (selectedStatus === '' || status === selectedStatus) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  });

  // 日期范围筛选
  const dateRangeFilter = document.getElementById('date-range');
  dateRangeFilter?.addEventListener('change', () => {
    const selectedRange = dateRangeFilter.value;
    const rows = document.querySelectorAll('tbody tr');

    if (selectedRange === 'all') {
      rows.forEach(row => {
        row.style.display = '';
      });
      return;
    }

    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const yesterday = new Date(today);
    yesterday.setDate(yesterday.getDate() - 1);

    const startOfWeek = new Date(today);
    startOfWeek.setDate(today.getDate() - today.getDay());

    const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);

    rows.forEach(row => {
      const dateCell = row.querySelector('td:nth-child(5)').textContent;
      const sessionDate = new Date(dateCell);

      let show = false;

      switch (selectedRange) {
        case 'today':
          show = sessionDate >= today;
          break;
        case 'yesterday':
          show = sessionDate >= yesterday && sessionDate < today;
          break;
        case 'week':
          show = sessionDate >= startOfWeek;
          break;
        case 'month':
          show = sessionDate >= startOfMonth;
          break;
      }

      row.style.display = show ? '' : 'none';
    });
  });

  // 刷新按钮
  const refreshBtn = document.getElementById('refresh-btn');
  refreshBtn?.addEventListener('click', () => {
    window.location.reload();
  });
</script>
