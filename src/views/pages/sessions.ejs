<!-- 统计卡片 -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">总会话数</p>
        <p class="text-2xl font-bold" id="total-sessions">-</p>
      </div>
      <div class="p-3 bg-blue-100 rounded-full">
        <i class="fas fa-list text-blue-500"></i>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">活跃会话</p>
        <p class="text-2xl font-bold text-green-600" id="active-sessions">-</p>
      </div>
      <div class="p-3 bg-green-100 rounded-full">
        <i class="fas fa-play-circle text-green-500"></i>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">总消耗积分</p>
        <p class="text-2xl font-bold text-yellow-600" id="total-credits">-</p>
      </div>
      <div class="p-3 bg-yellow-100 rounded-full">
        <i class="fas fa-coins text-yellow-500"></i>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">平均时长</p>
        <p class="text-2xl font-bold text-purple-600" id="avg-duration">-</p>
      </div>
      <div class="p-3 bg-purple-100 rounded-full">
        <i class="fas fa-clock text-purple-500"></i>
      </div>
    </div>
  </div>
</div>

<div class="bg-white rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
    <h3 class="text-lg font-medium text-gray-700">会话管理</h3>
    <div class="flex items-center space-x-4">
      <div class="flex items-center">
        <input type="checkbox" id="auto-refresh" class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded mr-2">
        <label for="auto-refresh" class="text-sm text-gray-600">自动刷新</label>
      </div>
      <button id="refresh-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
        <i class="fas fa-sync-alt"></i>
      </button>
      <button id="quick-create-session-btn" class="bg-primary-600 hover:bg-primary-700 text-white px-3 py-2 rounded-md text-sm font-medium">
        <i class="fas fa-plus mr-1"></i> 快速创建测试会话
      </button>
      <div class="relative">
        <button id="export-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
          <i class="fas fa-download mr-1"></i> 导出
        </button>
        <div id="export-menu" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-10 hidden">
          <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">导出为 CSV</a>
          <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">导出为 Excel</a>
        </div>
      </div>
    </div>
  </div>

  <div class="p-6">
    <!-- 搜索和筛选 -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6 space-y-4 md:space-y-0">
      <div class="flex flex-wrap items-center gap-4">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-search text-gray-400"></i>
          </div>
          <input type="text" id="search-sessions" name="search" placeholder="搜索会话..."
            class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>
        <div>
          <select id="status-filter" name="status" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="">所有状态</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>活跃</option>
            <option value="ended" <%= filters.status === 'ended' ? 'selected' : '' %>>已结束</option>
            <option value="error" <%= filters.status === 'error' ? 'selected' : '' %>>错误</option>
          </select>
        </div>
        <div>
          <select id="user-filter" name="user_id" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="">所有用户</option>
            <% users.forEach(user => { %>
              <option value="<%= user.id %>" <%= filters.userId == user.id ? 'selected' : '' %>><%= user.username %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <select id="sort-select" name="sort" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="">默认排序</option>
            <option value="created_at:desc" <%= (filters.sort === 'created_at' && filters.order === 'desc') ? 'selected' : '' %>>创建时间(新→旧)</option>
            <option value="created_at:asc" <%= (filters.sort === 'created_at' && filters.order === 'asc') ? 'selected' : '' %>>创建时间(旧→新)</option>
            <option value="duration:desc" <%= (filters.sort === 'duration' && filters.order === 'desc') ? 'selected' : '' %>>持续时间(长→短)</option>
            <option value="duration:asc" <%= (filters.sort === 'duration' && filters.order === 'asc') ? 'selected' : '' %>>持续时间(短→长)</option>
            <option value="credits_used:desc" <%= (filters.sort === 'credits_used' && filters.order === 'desc') ? 'selected' : '' %>>消耗积分(多→少)</option>
            <option value="credits_used:asc" <%= (filters.sort === 'credits_used' && filters.order === 'asc') ? 'selected' : '' %>>消耗积分(少→多)</option>
            <option value="updated_at:desc" <%= (filters.sort === 'updated_at' && filters.order === 'desc') ? 'selected' : '' %>>更新时间(新→旧)</option>
          </select>
        </div>
      </div>

      <div class="flex items-center space-x-4">
        <div>
          <select id="date-range" name="dateRange" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="all" <%= filters.dateRange === 'all' ? 'selected' : '' %>>所有时间</option>
            <option value="today" <%= filters.dateRange === 'today' ? 'selected' : '' %>>今天</option>
            <option value="yesterday" <%= filters.dateRange === 'yesterday' ? 'selected' : '' %>>昨天</option>
            <option value="week" <%= filters.dateRange === 'week' ? 'selected' : '' %>>本周</option>
            <option value="month" <%= filters.dateRange === 'month' ? 'selected' : '' %>>本月</option>
          </select>
        </div>
      </div>
    </div>

    <!-- 批量操作按钮 -->
    <div id="batch-actions" class="hidden mb-4 p-3 bg-blue-50 border border-blue-200 rounded-md flex items-center justify-between">
      <span class="text-sm text-blue-700">已选择 <span id="selected-count">0</span> 个会话</span>
      <div class="flex space-x-2">
        <button id="batch-release-btn" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded-md text-sm font-medium">
          <i class="fas fa-stop-circle mr-1"></i> 批量结束
        </button>
        <button id="cancel-selection-btn" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-3 py-1.5 rounded-md text-sm font-medium">
          取消选择
        </button>
      </div>
    </div>

    <!-- 会话表格 -->
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-12">
              <input type="checkbox" id="select-all-sessions" class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded">
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              会话 ID
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              用户
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              机器
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              状态
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              开始时间
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              持续时间
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              消耗点数
            </th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
              操作
            </th>
          </tr>
        </thead>
        <%
          const activeStatuses = ['created', 'connected'];
          const endedStatuses = ['disconnected', 'expired', 'completed'];
        %>
        <tbody class="bg-white divide-y divide-gray-200">
          <% sessions.forEach(session => { %>
            <%
              const machineIp = session.machine_ip || '';
              const machineProxyPort = session.machine_proxy_port || '';
              const wsUrl = machineIp && machineProxyPort ? `ws://${machineIp}:${machineProxyPort}/ws/${session.id}` : '';
              const httpProxyUrl = machineIp && session.port ? `http://${machineIp}:${session.port}` : '';
              const apiEndpoint = `/api/sessions/${session.id}`;
            %>
            <tr class="session-row" data-session-id="<%= session.id %>" data-status="<%= session.status %>"
                data-machine-ip="<%= machineIp %>" data-machine-proxy-port="<%= machineProxyPort %>" data-port="<%= session.port || '' %>">
              <td class="px-6 py-4 whitespace-nowrap">
                <input type="checkbox" class="session-checkbox h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded" data-session-id="<%= session.id %>">
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <div class="flex items-center space-x-2">
                  <span><%= session.id.substring(0, 8) %>...</span>
                  <button class="text-gray-400 hover:text-primary-600 copy-btn" data-copy="<%= session.id %>" title="复制会话 ID">
                    <i class="fas fa-copy text-xs"></i>
                  </button>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="flex-shrink-0 h-8 w-8 rounded-full bg-primary-500 flex items-center justify-center text-white font-medium">
                    <%= session.username ? session.username.charAt(0).toUpperCase() : '?' %>
                  </div>
                  <div class="ml-3">
                    <div class="text-sm font-medium text-gray-900"><%= session.username || '未知用户' %></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= session.machine_name || '未分配' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (activeStatuses.includes(session.status)) { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    活跃
                  </span>
                <% } else if (endedStatuses.includes(session.status)) { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                    已结束
                  </span>
                <% } else if (session.status === 'error') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                    错误
                  </span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                    <%= session.status %>
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= new Date(session.created_at).toLocaleString() %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if (session.duration) { %>
                  <%
                    const minutes = Math.floor(session.duration / 60);
                    const seconds = session.duration % 60;
                    if (minutes > 0) {
                  %>
                    <%= minutes %> 分 <%= seconds %> 秒
                  <% } else { %>
                    <%= seconds %> 秒
                  <% } %>
                <% } else { %>
                  0 秒
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= session.credits_used || 0 %> 点
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex justify-end items-center space-x-1">
                  <a href="/admin/sessions/<%= session.id %>" class="text-primary-600 hover:text-primary-900 p-1" title="查看详情">
                    <i class="fas fa-eye"></i>
                  </a>
                  <% if (activeStatuses.includes(session.status)) { %>
                    <button class="text-red-600 hover:text-red-900 end-session-btn p-1" data-session-id="<%= session.id %>" title="结束会话">
                      <i class="fas fa-stop-circle"></i>
                    </button>
                  <% } %>
                  <button class="text-gray-400 hover:text-primary-600 session-info-toggle p-1" data-session-id="<%= session.id %>" title="连接信息">
                    <i class="fas fa-info-circle"></i>
                  </button>
                  <div class="relative inline-block">
                    <button class="text-gray-400 hover:text-primary-600 session-actions-toggle p-1" data-session-id="<%= session.id %>" title="快捷操作">
                      <i class="fas fa-ellipsis-v"></i>
                    </button>
                    <div class="session-actions-menu absolute right-0 mt-1 w-52 bg-white rounded-md shadow-lg py-1 z-20 hidden border border-gray-200">
                      <button class="quick-action-copy flex items-center w-full px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" data-copy="<%= session.id %>">
                        <i class="fas fa-copy text-gray-400 mr-3 w-4"></i> 复制会话 ID
                      </button>
                      <% if (wsUrl) { %>
                        <button class="quick-action-copy flex items-center w-full px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" data-copy="<%= wsUrl %>">
                          <i class="fas fa-link text-gray-400 mr-3 w-4"></i> 复制 WebSocket URL
                        </button>
                      <% } %>
                      <% if (httpProxyUrl) { %>
                        <button class="quick-action-copy flex items-center w-full px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" data-copy="<%= httpProxyUrl %>">
                          <i class="fas fa-globe text-gray-400 mr-3 w-4"></i> 复制 HTTP 代理 URL
                        </button>
                      <% } %>
                      <button class="quick-action-copy flex items-center w-full px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" data-copy="<%= apiEndpoint %>">
                        <i class="fas fa-code text-gray-400 mr-3 w-4"></i> 复制 API 端点
                      </button>
                      <a href="/admin/playground?sessionId=<%= session.id %>" class="flex items-center w-full px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        <i class="fas fa-flask text-gray-400 mr-3 w-4"></i> API Playground
                      </a>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
            <tr class="session-info-row hidden" id="info-row-<%= session.id %>">
              <td colspan="9" class="px-6 py-0">
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-4">
                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div>
                      <p class="text-xs text-gray-500 mb-1">会话 ID</p>
                      <div class="flex items-center space-x-2">
                        <code class="text-xs bg-white px-2 py-1 rounded border border-gray-200 break-all"><%= session.id %></code>
                        <button class="text-gray-400 hover:text-primary-600 copy-btn flex-shrink-0" data-copy="<%= session.id %>">
                          <i class="fas fa-copy text-xs"></i>
                        </button>
                      </div>
                    </div>
                    <div>
                      <p class="text-xs text-gray-500 mb-1">WebSocket URL</p>
                      <div class="flex items-center space-x-2">
                        <code class="text-xs bg-white px-2 py-1 rounded border border-gray-200 break-all"><%= wsUrl || 'N/A' %></code>
                        <% if (wsUrl) { %>
                          <button class="text-gray-400 hover:text-primary-600 copy-btn flex-shrink-0" data-copy="<%= wsUrl %>">
                            <i class="fas fa-copy text-xs"></i>
                          </button>
                        <% } %>
                      </div>
                    </div>
                    <div>
                      <p class="text-xs text-gray-500 mb-1">HTTP 代理 URL</p>
                      <div class="flex items-center space-x-2">
                        <code class="text-xs bg-white px-2 py-1 rounded border border-gray-200 break-all"><%= httpProxyUrl || 'N/A' %></code>
                        <% if (httpProxyUrl) { %>
                          <button class="text-gray-400 hover:text-primary-600 copy-btn flex-shrink-0" data-copy="<%= httpProxyUrl %>">
                            <i class="fas fa-copy text-xs"></i>
                          </button>
                        <% } %>
                      </div>
                    </div>
                    <div>
                      <p class="text-xs text-gray-500 mb-1">API 端点</p>
                      <div class="flex items-center space-x-2">
                        <code class="text-xs bg-white px-2 py-1 rounded border border-gray-200 break-all">GET <%= apiEndpoint %></code>
                        <button class="text-gray-400 hover:text-primary-600 copy-btn flex-shrink-0" data-copy="<%= apiEndpoint %>">
                          <i class="fas fa-copy text-xs"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                  <% if (machineIp) { %>
                  <div class="mt-3 pt-3 border-t border-gray-200">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                      <div>
                        <p class="text-xs text-gray-500 mb-1">机器 IP</p>
                        <span class="text-xs font-medium text-gray-700"><%= machineIp %></span>
                      </div>
                      <div>
                        <p class="text-xs text-gray-500 mb-1">代理端口</p>
                        <span class="text-xs font-medium text-gray-700"><%= machineProxyPort || 'N/A' %></span>
                      </div>
                      <div>
                        <p class="text-xs text-gray-500 mb-1">会话端口</p>
                        <span class="text-xs font-medium text-gray-700"><%= session.port || 'N/A' %></span>
                      </div>
                    </div>
                  </div>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- 分页 -->
    <div class="flex items-center justify-between mt-6">
      <div class="text-sm text-gray-700">
        显示 <span class="font-medium"><%= (page - 1) * limit + 1 %></span> 到 <span class="font-medium"><%= Math.min(page * limit, totalSessions) %></span> 条，共 <span class="font-medium"><%= totalSessions %></span> 条
      </div>
      <div class="flex space-x-2">
        <%
        const buildPageUrl = (pageNum) => {
          let url = `/admin/sessions?page=${pageNum}&limit=${limit}`;
          if (filters.status) url += `&status=${filters.status}`;
          if (filters.userId) url += `&userId=${filters.userId}`;
          if (filters.dateRange && filters.dateRange !== 'all') url += `&dateRange=${filters.dateRange}`;
          return url;
        };
        %>
        <% if (page > 1) { %>
          <a href="<%= buildPageUrl(page - 1) %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            上一页
          </a>
        <% } else { %>
          <button disabled class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
            上一页
          </button>
        <% } %>

        <% if (page * limit < totalSessions) { %>
          <a href="<%= buildPageUrl(page + 1) %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            下一页
          </a>
        <% } else { %>
          <button disabled class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
            下一页
          </button>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- 结束会话确认模态框 -->
<div id="end-session-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">结束会话</h3>
      <button id="close-end-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="p-6">
      <p class="text-gray-700 mb-4">确定要结束此会话吗？这将立即停止浏览器实例并释放资源。</p>

      <div class="flex justify-end">
        <button id="cancel-end-session" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 mr-3">
          取消
        </button>
        <button id="confirm-end-session" class="bg-red-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
          结束会话
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 快速创建测试会话模态框 -->
<div id="quick-create-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">快速创建测试会话</h3>
      <button id="close-create-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="p-6 space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">用户</label>
        <select id="create-user-select" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
          <option value="">选择用户...</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">浏览器类型</label>
        <select id="create-browser-select" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
          <option value="chromium">Chromium</option>
          <option value="firefox">Firefox</option>
          <option value="webkit">WebKit</option>
        </select>
      </div>
      <div class="flex items-center">
        <input type="checkbox" id="create-headless" checked class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded mr-2">
        <label for="create-headless" class="text-sm text-gray-700">无头模式 (Headless)</label>
      </div>
    </div>
    <div class="px-6 py-4 border-t flex justify-end space-x-3">
      <button id="cancel-create-session" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
        取消
      </button>
      <button id="confirm-create-session" class="bg-primary-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
        创建
      </button>
    </div>
  </div>
</div>

<script>
  const endSessionButtons = document.querySelectorAll('.end-session-btn');
  const endSessionModal = document.getElementById('end-session-modal');
  const closeEndModal = document.getElementById('close-end-modal');
  const cancelEndSession = document.getElementById('cancel-end-session');
  const confirmEndSession = document.getElementById('confirm-end-session');
  let currentSessionId = null;

  endSessionButtons.forEach(button => {
    button.addEventListener('click', () => {
      currentSessionId = button.getAttribute('data-session-id');
      endSessionModal.classList.remove('hidden');
    });
  });

  closeEndModal?.addEventListener('click', () => {
    endSessionModal.classList.add('hidden');
  });

  cancelEndSession?.addEventListener('click', () => {
    endSessionModal.classList.add('hidden');
  });

  confirmEndSession?.addEventListener('click', async () => {
    if (!currentSessionId) return;

    try {
      const response = await fetch(`/api/sessions/${currentSessionId}/release`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      const result = await response.json();

      if (result.success) {
        window.location.reload();
      } else {
        alert('结束会话失败: ' + result.message);
      }
    } catch (error) {
      alert('结束会话失败: ' + error.message);
    } finally {
      endSessionModal.classList.add('hidden');
    }
  });

  const exportBtn = document.getElementById('export-btn');
  const exportMenu = document.getElementById('export-menu');

  exportBtn?.addEventListener('click', () => {
    exportMenu.classList.toggle('hidden');
  });

  document.addEventListener('click', (e) => {
    if (!exportBtn?.contains(e.target) && !exportMenu?.contains(e.target)) {
      exportMenu?.classList.add('hidden');
    }
  });

  endSessionModal?.addEventListener('click', (e) => {
    if (e.target === endSessionModal) {
      endSessionModal.classList.add('hidden');
    }
  });

  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      window.appUtils.copyToClipboard(btn.getAttribute('data-copy'));
    });
  });

  document.querySelectorAll('.quick-action-copy').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      window.appUtils.copyToClipboard(btn.getAttribute('data-copy'));
      const menu = btn.closest('.session-actions-menu');
      if (menu) menu.classList.add('hidden');
    });
  });

  document.querySelectorAll('.session-info-toggle').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const sessionId = btn.getAttribute('data-session-id');
      const infoRow = document.getElementById('info-row-' + sessionId);
      if (infoRow) {
        infoRow.classList.toggle('hidden');
        btn.classList.toggle('text-primary-600');
        btn.classList.toggle('text-gray-400');
      }
    });
  });

  document.querySelectorAll('.session-actions-toggle').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const menu = btn.nextElementSibling;
      document.querySelectorAll('.session-actions-menu').forEach(m => {
        if (m !== menu) m.classList.add('hidden');
      });
      menu.classList.toggle('hidden');
    });
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.session-actions-toggle') && !e.target.closest('.session-actions-menu')) {
      document.querySelectorAll('.session-actions-menu').forEach(m => m.classList.add('hidden'));
    }
  });

  const quickCreateBtn = document.getElementById('quick-create-session-btn');
  const quickCreateModal = document.getElementById('quick-create-modal');
  const closeCreateModal = document.getElementById('close-create-modal');
  const cancelCreateSession = document.getElementById('cancel-create-session');
  const confirmCreateSession = document.getElementById('confirm-create-session');
  const createUserSelect = document.getElementById('create-user-select');

  quickCreateBtn?.addEventListener('click', async () => {
    quickCreateModal.classList.remove('hidden');
    if (createUserSelect.options.length <= 1) {
      try {
        const result = await window.appUtils.API.get('/api/admin/users?limit=50');
        if (result.success || result.items) {
          const users = result.items || result.data || [];
          users.forEach(user => {
            const opt = document.createElement('option');
            opt.value = user.id;
            opt.textContent = user.username + ' (ID: ' + user.id + ')';
            createUserSelect.appendChild(opt);
          });
        }
      } catch (err) {
        window.appUtils.toast.error('加载用户列表失败');
      }
    }
  });

  closeCreateModal?.addEventListener('click', () => {
    quickCreateModal.classList.add('hidden');
  });

  cancelCreateSession?.addEventListener('click', () => {
    quickCreateModal.classList.add('hidden');
  });

  quickCreateModal?.addEventListener('click', (e) => {
    if (e.target === quickCreateModal) {
      quickCreateModal.classList.add('hidden');
    }
  });

  confirmCreateSession?.addEventListener('click', async () => {
    const userId = createUserSelect.value;
    if (!userId) {
      window.appUtils.toast.warning('请选择用户');
      return;
    }

    const originalText = window.appUtils.Loading.setButtonLoading(confirmCreateSession);

    try {
      const result = await window.appUtils.API.post('/api/admin/test/sessions', {
        user_id: parseInt(userId),
        count: 1
      });

      if (result.success) {
        window.appUtils.toast.success('测试会话创建成功');
        quickCreateModal.classList.add('hidden');
        setTimeout(() => window.location.reload(), 500);
      } else {
        window.appUtils.toast.error('创建失败: ' + (result.error || result.message || '未知错误'));
      }
    } catch (err) {
      window.appUtils.toast.error('创建失败: ' + err.message);
    } finally {
      window.appUtils.Loading.restoreButton(confirmCreateSession, originalText);
    }
  });

  const searchInput = document.getElementById('search-sessions');
  searchInput?.addEventListener('input', () => {
    const searchTerm = searchInput.value.toLowerCase();
    const rows = document.querySelectorAll('.session-row');

    rows.forEach(row => {
      const sessionId = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
      const username = row.querySelector('td:nth-child(3) .text-sm.font-medium').textContent.toLowerCase();
      const machine = row.querySelector('td:nth-child(4)').textContent.toLowerCase();

      if (sessionId.includes(searchTerm) || username.includes(searchTerm) || machine.includes(searchTerm)) {
        row.style.display = '';
        const infoRow = row.nextElementSibling;
        if (infoRow && infoRow.classList.contains('session-info-row')) {
          infoRow.style.display = '';
        }
      } else {
        row.style.display = 'none';
        const infoRow = row.nextElementSibling;
        if (infoRow && infoRow.classList.contains('session-info-row')) {
          infoRow.style.display = 'none';
        }
      }
    });
  });

  function buildUrl(params) {
    const url = new URL(window.location.href);
    if (!params.page && url.searchParams.has('page')) {
      params.page = url.searchParams.get('page');
    }
    if (!params.limit && url.searchParams.has('limit')) {
      params.limit = url.searchParams.get('limit');
    }
    Object.keys(params).forEach(key => {
      if (params[key] === '' || params[key] === null || params[key] === undefined) {
        url.searchParams.delete(key);
      } else {
        url.searchParams.set(key, params[key]);
      }
    });
    return url.toString();
  }

  const statusFilter = document.getElementById('status-filter');
  statusFilter?.addEventListener('change', () => {
    window.location.href = buildUrl({ status: statusFilter.value, page: 1 });
  });

  const userFilter = document.getElementById('user-filter');
  userFilter?.addEventListener('change', () => {
    window.location.href = buildUrl({ userId: userFilter.value, page: 1 });
  });

  const dateRangeFilter = document.getElementById('date-range');
  dateRangeFilter?.addEventListener('change', () => {
    window.location.href = buildUrl({ dateRange: dateRangeFilter.value, page: 1 });
  });

  const refreshBtn = document.getElementById('refresh-btn');
  refreshBtn?.addEventListener('click', () => {
    window.location.reload();
  });

  const selectAllSessionsCheckbox = document.getElementById('select-all-sessions');
  const sessionCheckboxes = document.querySelectorAll('.session-checkbox');
  const batchActions = document.getElementById('batch-actions');
  const selectedCountSpan = document.getElementById('selected-count');
  const batchReleaseBtn = document.getElementById('batch-release-btn');
  const cancelSelectionBtn = document.getElementById('cancel-selection-btn');

  let selectedSessionIds = [];

  selectAllSessionsCheckbox?.addEventListener('change', () => {
    sessionCheckboxes.forEach(checkbox => {
      checkbox.checked = selectAllSessionsCheckbox.checked;
    });
    updateSelectedSessions();
  });

  sessionCheckboxes.forEach(checkbox => {
    checkbox.addEventListener('change', () => {
      updateSelectedSessions();
      const allChecked = Array.from(sessionCheckboxes).every(cb => cb.checked);
      selectAllSessionsCheckbox.checked = allChecked && sessionCheckboxes.length > 0;
    });
  });

  function updateSelectedSessions() {
    selectedSessionIds = Array.from(sessionCheckboxes)
      .filter(cb => cb.checked)
      .map(cb => cb.getAttribute('data-session-id'));

    if (selectedSessionIds.length > 0) {
      batchActions?.classList.remove('hidden');
      if (selectedCountSpan) {
        selectedCountSpan.textContent = selectedSessionIds.length;
      }
    } else {
      batchActions?.classList.add('hidden');
    }
  }

  cancelSelectionBtn?.addEventListener('click', () => {
    sessionCheckboxes.forEach(cb => cb.checked = false);
    selectAllSessionsCheckbox.checked = false;
    updateSelectedSessions();
  });

  batchReleaseBtn?.addEventListener('click', async () => {
    if (selectedSessionIds.length === 0) {
      alert('请选择要结束的会话');
      return;
    }

    if (!confirm(`确定要结束选中的 ${selectedSessionIds.length} 个会话吗？此操作将立即停止浏览器实例并释放资源。`)) {
      return;
    }

    try {
      const response = await fetch('/api/admin/sessions/batch-release', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionIds: selectedSessionIds })
      });

      const result = await response.json();

      if (result.success) {
        let message = `成功结束 ${result.data.released.length} 个会话`;
        if (result.data.failed.length > 0) {
          message += `，${result.data.failed.length} 个失败`;
          console.error('结束失败的会话:', result.data.failed);
        }
        alert(message);
        window.location.reload();
      } else {
        alert('批量结束失败: ' + result.message);
      }
    } catch (error) {
      alert('批量结束失败: ' + error.message);
    }
  });

  async function loadStats() {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const dateRange = urlParams.get('dateRange') || 'all';

      const response = await fetch(`/api/admin/sessions/stats?dateRange=${dateRange}`);
      const result = await response.json();

      if (result.success) {
        document.getElementById('total-sessions').textContent = result.data.total;
        document.getElementById('active-sessions').textContent = result.data.active;
        document.getElementById('total-credits').textContent = result.data.totalCreditsUsed;
        document.getElementById('avg-duration').textContent = result.data.avgDuration + '秒';
      }
    } catch (error) {
      console.error('加载统计数据失败:', error);
    }
  }

  loadStats();

  const sortSelect = document.getElementById('sort-select');
  sortSelect?.addEventListener('change', () => {
    const sortValue = sortSelect.value;
    if (sortValue) {
      const [sort, order] = sortValue.split(':');
      window.location.href = buildUrl({ sort, order, page: 1 });
    } else {
      const url = new URL(window.location.href);
      url.searchParams.delete('sort');
      url.searchParams.delete('order');
      window.location.href = url.toString();
    }
  });

  const autoRefreshCheckbox = document.getElementById('auto-refresh');
  let refreshInterval = null;

  autoRefreshCheckbox?.addEventListener('change', () => {
    if (autoRefreshCheckbox.checked) {
      refreshInterval = setInterval(() => {
        loadStats();
      }, 10000);
    } else {
      if (refreshInterval) {
        clearInterval(refreshInterval);
        refreshInterval = null;
      }
    }
  });
</script>
