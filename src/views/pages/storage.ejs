<div class="bg-white rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
    <h3 class="text-lg font-medium text-gray-700">存储管理</h3>
    <div class="flex items-center space-x-2">
      <button id="refresh-stats-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
        <i class="fas fa-sync-alt"></i> 刷新
      </button>
      <button id="cleanup-all-btn" class="bg-orange-500 hover:bg-orange-600 text-white px-3 py-2 rounded-md text-sm font-medium">
        <i class="fas fa-broom mr-1"></i> 清理旧数据
      </button>
    </div>
  </div>

  <div class="p-6">
    <!-- 系统存储概览 -->
    <div class="mb-8">
      <h4 class="text-md font-medium text-gray-700 mb-4">系统存储概览</h4>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4" id="system-stats">
        <div class="bg-blue-50 rounded-lg p-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-600">总用户数</p>
              <p class="text-2xl font-bold text-gray-900" id="stat-total-users">-</p>
            </div>
            <i class="fas fa-users text-blue-500 text-2xl"></i>
          </div>
        </div>
        <div class="bg-green-50 rounded-lg p-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-600">总存储</p>
              <p class="text-2xl font-bold text-gray-900" id="stat-total-storage">-</p>
            </div>
            <i class="fas fa-database text-green-500 text-2xl"></i>
          </div>
        </div>
        <div class="bg-purple-50 rounded-lg p-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-600">用户数据</p>
              <p class="text-2xl font-bold text-gray-900" id="stat-user-storage">-</p>
            </div>
            <i class="fas fa-hdd text-purple-500 text-2xl"></i>
          </div>
        </div>
        <div class="bg-yellow-50 rounded-lg p-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-600">临时文件</p>
              <p class="text-2xl font-bold text-gray-900" id="stat-temp-storage">-</p>
            </div>
            <i class="fas fa-file-alt text-yellow-500 text-2xl"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- 搜索和筛选 -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6 space-y-4 md:space-y-0">
      <div class="flex items-center">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-search text-gray-400"></i>
          </div>
          <input type="text" id="search-users" placeholder="搜索用户..."
            class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>
        <div class="ml-4">
          <select id="sort-by" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="totalSize">按总存储</option>
            <option value="sessionsSize">按会话存储</option>
            <option value="sharedSize">按共享存储</option>
            <option value="username">按用户名</option>
          </select>
        </div>
        <div class="ml-4">
          <select id="sort-order" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="desc">降序</option>
            <option value="asc">升序</option>
          </select>
        </div>
      </div>

      <div class="flex items-center space-x-2">
        <button id="filter-over-limit" class="bg-red-100 hover:bg-red-200 text-red-700 px-3 py-2 rounded-md text-sm font-medium">
          <i class="fas fa-exclamation-triangle mr-1"></i> 超限用户
        </button>
      </div>
    </div>

    <!-- 批量操作按钮 -->
    <div id="batch-actions" class="hidden mb-4 p-3 bg-blue-50 border border-blue-200 rounded-md flex items-center justify-between">
      <span class="text-sm text-blue-700">已选择 <span id="selected-count">0</span> 个用户</span>
      <div class="flex space-x-2">
        <button id="cleanup-sessions-btn" class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1.5 rounded-md text-sm font-medium">
          <i class="fas fa-trash-alt mr-1"></i> 清理会话
        </button>
        <button id="cleanup-shared-btn" class="bg-orange-500 hover:bg-orange-600 text-white px-3 py-1.5 rounded-md text-sm font-medium">
          <i class="fas fa-broom mr-1"></i> 清理共享
        </button>
        <button id="cleanup-all-btn-user" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1.5 rounded-md text-sm font-medium">
          <i class="fas fa-trash mr-1"></i> 全部清理
        </button>
        <button id="cancel-selection-btn" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-3 py-1.5 rounded-md text-sm font-medium">
          取消选择
        </button>
      </div>
    </div>

    <!-- 用户存储表格 -->
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-12">
              <input type="checkbox" id="select-all-users" class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded">
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              用户
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              会话存储
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              共享存储
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              总存储
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              会话数
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              状态
            </th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
              操作
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200" id="storage-table-body">
          <tr>
            <td colspan="8" class="px-6 py-4 text-center text-gray-500">
              <i class="fas fa-spinner fa-spin mr-2"></i> 加载中...
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- 分页 -->
    <div class="mt-4 flex items-center justify-between">
      <div class="text-sm text-gray-700">
        显示第 <span id="page-start">0</span> - <span id="page-end">0</span> 条，共 <span id="total-items">0</span> 条
      </div>
      <div class="flex items-center space-x-2">
        <button id="prev-page" class="px-3 py-1 border border-gray-300 rounded-md text-sm disabled:opacity-50 disabled:cursor-not-allowed" disabled>
          <i class="fas fa-chevron-left"></i>
        </button>
        <span id="page-info" class="text-sm text-gray-700">第 1 页</span>
        <button id="next-page" class="px-3 py-1 border border-gray-300 rounded-md text-sm disabled:opacity-50 disabled:cursor-not-allowed" disabled>
          <i class="fas fa-chevron-right"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 清理确认模态框 -->
<div id="cleanup-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">确认清理</h3>
    </div>
    <div class="px-6 py-4">
      <p class="text-gray-700" id="cleanup-modal-message">确定要清理这些数据吗？此操作不可撤销。</p>
      <p class="text-sm text-gray-500 mt-2">清理类型: <span id="cleanup-type" class="font-medium"></span></p>
    </div>
    <div class="px-6 py-4 bg-gray-50 flex justify-end space-x-3">
      <button id="cancel-cleanup" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100">
        取消
      </button>
      <button id="confirm-cleanup" class="px-4 py-2 bg-red-600 border border-transparent rounded-md text-sm font-medium text-white hover:bg-red-700">
        确认清理
      </button>
    </div>
  </div>
</div>

<!-- 清理旧数据模态框 -->
<div id="cleanup-all-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">清理旧数据</h3>
    </div>
    <div class="px-6 py-4">
      <p class="text-gray-700 mb-4">清理超过指定天数未使用的共享数据。</p>
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-2">天数</label>
        <input type="number" id="cleanup-days" value="30" min="1" max="365"
          class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        <p class="text-sm text-gray-500 mt-1">默认: 30 天</p>
      </div>
    </div>
    <div class="px-6 py-4 bg-gray-50 flex justify-end space-x-3">
      <button id="cancel-cleanup-all" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100">
        取消
      </button>
      <button id="confirm-cleanup-all" class="px-4 py-2 bg-orange-600 border border-transparent rounded-md text-sm font-medium text-white hover:bg-orange-700">
        开始清理
      </button>
    </div>
  </div>
</div>

<script>
// 配置
const API_BASE = '/api/admin/storage';
let currentPage = 1;
const limit = 20;
let currentSort = 'totalSize';
let currentOrder = 'desc';
let currentSearch = '';
let selectedUsers = new Set();

// 格式化字节数
function formatBytes(bytes) {
  if (bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

// 加载系统存储统计
async function loadSystemStats() {
  try {
    const response = await fetch('/api/admin/storage/system-stats');
    const result = await response.json();

    if (result.success) {
      const stats = result.data;
      document.getElementById('stat-total-users').textContent = stats.totalUsers;
      document.getElementById('stat-total-storage').textContent = formatBytes(stats.totalStorageSize);
      document.getElementById('stat-user-storage').textContent = formatBytes(stats.userStorageSize);
      document.getElementById('stat-temp-storage').textContent = formatBytes(stats.tempSize);
    }
  } catch (error) {
    console.error('加载系统统计失败:', error);
  }
}

// 加载用户存储统计
async function loadStorageStats() {
  try {
    const params = new URLSearchParams({
      page: currentPage,
      limit: limit,
      sortBy: currentSort,
      sortOrder: currentOrder,
      ...(currentSearch && { search: currentSearch })
    });

    const response = await fetch(`${API_BASE}/stats?${params}`);
    const result = await response.json();

    if (result.success) {
      renderStorageTable(result.data);
      updatePagination(result.data);
    }
  } catch (error) {
    console.error('加载存储统计失败:', error);
    document.getElementById('storage-table-body').innerHTML = `
      <tr>
        <td colspan="8" class="px-6 py-4 text-center text-red-500">
          <i class="fas fa-exclamation-circle mr-2"></i> 加载失败
        </td>
      </tr>
    `;
  }
}

// 渲染存储表格
function renderStorageTable(data) {
  const tbody = document.getElementById('storage-table-body');

  if (data.users.length === 0) {
    tbody.innerHTML = `
      <tr>
        <td colspan="8" class="px-6 py-4 text-center text-gray-500">
          暂无数据
        </td>
      </tr>
    `;
    return;
  }

  tbody.innerHTML = data.users.map(user => {
    const isSelected = selectedUsers.has(user.userId);
    const overLimitClass = user.isOverLimit ? 'bg-red-50' : '';
    const statusBadge = user.isOverLimit
      ? '<span class="px-2 py-1 text-xs font-medium rounded-full bg-red-100 text-red-800">超限</span>'
      : '<span class="px-2 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800">正常</span>';

    return `
      <tr class="${overLimitClass} hover:bg-gray-50">
        <td class="px-6 py-4 whitespace-nowrap">
          <input type="checkbox" class="user-checkbox h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded"
            data-user-id="${user.userId}" ${isSelected ? 'checked' : ''}>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="flex items-center">
            <div class="flex-shrink-0 h-10 w-10 bg-primary-100 rounded-full flex items-center justify-center">
              <span class="text-primary-600 font-medium">${user.username.charAt(0).toUpperCase()}</span>
            </div>
            <div class="ml-4">
              <div class="text-sm font-medium text-gray-900">${user.username}</div>
              <div class="text-sm text-gray-500">ID: ${user.userId}</div>
            </div>
          </div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="text-sm text-gray-900">${formatBytes(user.sessionsSize)}</div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="text-sm text-gray-900">${formatBytes(user.sharedSize)}</div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="text-sm font-medium text-gray-900">${formatBytes(user.totalSize)}</div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="text-sm text-gray-900">${user.sessionsCount}</div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          ${statusBadge}
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
          <button class="text-blue-600 hover:text-blue-900 mr-3 cleanup-user-btn" data-user-id="${user.userId}" data-username="${user.username}">
            <i class="fas fa-trash-alt"></i> 清理
          </button>
        </td>
      </tr>
    `;
  }).join('');

  // 绑定复选框事件
  document.querySelectorAll('.user-checkbox').forEach(checkbox => {
    checkbox.addEventListener('change', (e) => {
      const userId = parseInt(e.target.dataset.userId);
      if (e.target.checked) {
        selectedUsers.add(userId);
      } else {
        selectedUsers.delete(userId);
      }
      updateBatchActions();
      updateSelectAllCheckbox();
    });
  });

  // 绑定单个清理按钮事件
  document.querySelectorAll('.cleanup-user-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const userId = parseInt(e.currentTarget.dataset.userId);
      const username = e.currentTarget.dataset.username;
      showCleanupModal([userId], 'all', username);
    });
  });
}

// 更新分页
function updatePagination(data) {
  const start = (data.page - 1) * data.limit + 1;
  const end = Math.min(data.page * data.limit, data.total);

  document.getElementById('page-start').textContent = start;
  document.getElementById('page-end').textContent = end;
  document.getElementById('total-items').textContent = data.total;
  document.getElementById('page-info').textContent = `第 ${data.page} 页`;

  document.getElementById('prev-page').disabled = data.page <= 1;
  document.getElementById('next-page').disabled = data.page >= Math.ceil(data.total / data.limit);
}

// 更新批量操作
function updateBatchActions() {
  const batchActions = document.getElementById('batch-actions');
  const selectedCount = document.getElementById('selected-count');

  if (selectedUsers.size > 0) {
    batchActions.classList.remove('hidden');
    selectedCount.textContent = selectedUsers.size;
  } else {
    batchActions.classList.add('hidden');
  }
}

// 更新全选复选框
function updateSelectAllCheckbox() {
  const selectAll = document.getElementById('select-all-users');
  const checkboxes = document.querySelectorAll('.user-checkbox');
  const allChecked = checkboxes.length > 0 && Array.from(checkboxes).every(cb => cb.checked);
  selectAll.checked = allChecked;
}

// 显示清理模态框
function showCleanupModal(userIds, type, username = '') {
  const modal = document.getElementById('cleanup-modal');
  const message = document.getElementById('cleanup-modal-message');
  const typeSpan = document.getElementById('cleanup-type');

  const typeNames = {
    'sessions': '会话数据',
    'shared': '共享数据',
    'all': '全部数据'
  };

  if (userIds.length === 1) {
    message.textContent = `确定要清理用户 "${username}" 的数据吗？此操作不可撤销。`;
  } else {
    message.textContent = `确定要清理 ${userIds.length} 个用户的数据吗？此操作不可撤销。`;
  }
  typeSpan.textContent = typeNames[type];

  modal.classList.remove('hidden');
  modal.classList.add('flex');

  modal.dataset.userIds = JSON.stringify(userIds);
  modal.dataset.type = type;
}

// 隐藏清理模态框
function hideCleanupModal() {
  const modal = document.getElementById('cleanup-modal');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
}

// 执行清理
async function performCleanup(userIds, type) {
  try {
    const response = await fetch(`${API_BASE}/cleanup`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userIds, type })
    });

    const result = await response.json();

    if (result.success) {
      alert(`清理成功！\n清理用户: ${result.data.cleanedUsers}\n释放空间: ${formatBytes(result.data.freedSpace)}`);
      selectedUsers.clear();
      updateBatchActions();
      loadStorageStats();
      loadSystemStats();
    } else {
      alert('清理失败: ' + result.error);
    }
  } catch (error) {
    console.error('清理失败:', error);
    alert('清理失败: ' + error.message);
  }
}

// 事件监听
document.addEventListener('DOMContentLoaded', () => {
  // 初始加载
  loadSystemStats();
  loadStorageStats();

  // 刷新按钮
  document.getElementById('refresh-stats-btn').addEventListener('click', () => {
    loadSystemStats();
    loadStorageStats();
  });

  // 搜索
  let searchTimeout;
  document.getElementById('search-users').addEventListener('input', (e) => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      currentSearch = e.target.value;
      currentPage = 1;
      loadStorageStats();
    }, 300);
  });

  // 排序
  document.getElementById('sort-by').addEventListener('change', (e) => {
    currentSort = e.target.value;
    loadStorageStats();
  });

  document.getElementById('sort-order').addEventListener('change', (e) => {
    currentOrder = e.target.value;
    loadStorageStats();
  });

  // 分页
  document.getElementById('prev-page').addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      loadStorageStats();
    }
  });

  document.getElementById('next-page').addEventListener('click', () => {
    currentPage++;
    loadStorageStats();
  });

  // 全选
  document.getElementById('select-all-users').addEventListener('change', (e) => {
    const checkboxes = document.querySelectorAll('.user-checkbox');
    checkboxes.forEach(cb => {
      cb.checked = e.target.checked;
      const userId = parseInt(cb.dataset.userId);
      if (e.target.checked) {
        selectedUsers.add(userId);
      } else {
        selectedUsers.delete(userId);
      }
    });
    updateBatchActions();
  });

  // 取消选择
  document.getElementById('cancel-selection-btn').addEventListener('click', () => {
    selectedUsers.clear();
    document.querySelectorAll('.user-checkbox').forEach(cb => cb.checked = false);
    document.getElementById('select-all-users').checked = false;
    updateBatchActions();
  });

  // 批量清理
  document.getElementById('cleanup-sessions-btn').addEventListener('click', () => {
    showCleanupModal(Array.from(selectedUsers), 'sessions');
  });

  document.getElementById('cleanup-shared-btn').addEventListener('click', () => {
    showCleanupModal(Array.from(selectedUsers), 'shared');
  });

  document.getElementById('cleanup-all-btn-user').addEventListener('click', () => {
    showCleanupModal(Array.from(selectedUsers), 'all');
  });

  // 清理确认
  document.getElementById('confirm-cleanup').addEventListener('click', () => {
    const modal = document.getElementById('cleanup-modal');
    const userIds = JSON.parse(modal.dataset.userIds);
    const type = modal.dataset.type;

    hideCleanupModal();
    performCleanup(userIds, type);
  });

  document.getElementById('cancel-cleanup').addEventListener('click', hideCleanupModal);

  // 清理旧数据
  document.getElementById('cleanup-all-btn').addEventListener('click', () => {
    const modal = document.getElementById('cleanup-all-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  });

  document.getElementById('cancel-cleanup-all').addEventListener('click', () => {
    const modal = document.getElementById('cleanup-all-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  });

  document.getElementById('confirm-cleanup-all').addEventListener('click', async () => {
    const days = parseInt(document.getElementById('cleanup-days').value);
    const modal = document.getElementById('cleanup-all-modal');

    modal.classList.add('hidden');
    modal.classList.remove('flex');

    try {
      const response = await fetch(`${API_BASE}/cleanup-all`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ days })
      });

      const result = await response.json();

      if (result.success) {
        alert(`清理成功！\n删除项目: ${result.data.deletedCount}\n释放空间: ${formatBytes(result.data.freedSpace)}`);
        loadSystemStats();
        loadStorageStats();
      } else {
        alert('清理失败: ' + result.error);
      }
    } catch (error) {
      console.error('清理失败:', error);
      alert('清理失败: ' + error.message);
    }
  });

  // 筛选超限用户
  document.getElementById('filter-over-limit').addEventListener('click', () => {
