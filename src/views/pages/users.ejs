        </td>
        <td class="px-4 py-2 text-sm text-gray-500">
          <span class="font-mono text-xs">${r.password}</span>
          <button class="ml-1 text-gray-400 hover:text-gray-600 batch-copy-cell" data-value="${r.password}" title="复制">
            <i class="fas fa-copy text-xs"></i>
          </button>
        </td>
        <td class="px-4 py-2 text-sm text-gray-500">
          <span class="font-mono text-xs">${r.api_key && r.api_key !== '-' ? r.api_key.substring(0, 12) + '...' : '-'}</span>
          ${r.api_key && r.api_key !== '-' ? '<button class="ml-1 text-gray-400 hover:text-gray-600 batch-copy-cell" data-value="' + r.api_key + '" title="复制"><i class="fas fa-copy text-xs"></i></button>' : ''}
        </td>
      </tr>
    `).join('');
    document.querySelectorAll('.batch-copy-cell').forEach(btn => {
      btn.addEventListener('click', () => {
        window.appUtils.copyToClipboard(btn.getAttribute('data-value'));
        window.appUtils.toast.success('已复制');
      });
    });
  });

  batchCopyAll?.addEventListener('click', () => {
    const text = batchResults.filter(r => r.status === 'success').map(r =>
      `用户名: ${r.username}\n密码: ${r.password}\nAPI Key: ${r.api_key}\n---`
    ).join('\n');
    window.appUtils.copyToClipboard(text);
    window.appUtils.toast.success('已复制所有凭证');
  });

  batchCloseResults?.addEventListener('click', () => {
    batchCreateModal.classList.add('hidden');
    window.location.reload();
  });

  document.querySelectorAll('.copy-api-key-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const userId = btn.getAttribute('data-user-id');
      const username = btn.getAttribute('data-username');
      const row = btn.closest('tr');
      const apiKey = row.getAttribute('data-api-key');
      if (apiKey) {
        window.appUtils.copyToClipboard(apiKey);
        window.appUtils.toast.success(`已复制 ${username} 的 API Key`);
      } else {
        try {
          const result = await window.appUtils.API.get(`/api/admin/users/${userId}`);
          if (result.success && result.data.api_key) {
            window.appUtils.copyToClipboard(result.data.api_key);
            window.appUtils.toast.success(`已复制 ${username} 的 API Key`);
            row.setAttribute('data-api-key', result.data.api_key);
          } else {
            window.appUtils.toast.error('获取 API Key 失败');
          }
        } catch (error) {
          window.appUtils.toast.error('获取 API Key 失败: ' + error.message);
        }
      }
    });
  });
</script>

<style>
  .spinner {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    border: 2px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    border-top-color: #0ea5e9;
    animation: spin 1s ease-in-out infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
