<div class="bg-white rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
    <h3 class="text-lg font-medium text-gray-700">用户管理</h3>
    <div class="flex space-x-2">
      <button id="add-user-btn" class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-md text-sm font-medium flex items-center">
        <i class="fas fa-plus mr-2"></i> 添加用户
      </button>
      <button id="batch-create-btn" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md text-sm font-medium flex items-center">
        <i class="fas fa-users mr-2"></i> 批量创建
      </button>
    </div>
  </div>

  <div class="p-6">
    <!-- 搜索和筛选 -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6 space-y-4 md:space-y-0">
      <div class="flex items-center">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-search text-gray-400"></i>
          </div>
          <input type="text" id="search-users" placeholder="搜索用户..."
            class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>
        <div class="ml-4">
          <select id="role-filter" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="">所有角色</option>
            <option value="admin" <%= filters.role === 'admin' ? 'selected' : '' %>>管理员</option>
            <option value="user" <%= filters.role === 'user' ? 'selected' : '' %>>普通用户</option>
          </select>
        </div>
        <div class="ml-4">
          <select id="status-filter" class="block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="">所有状态</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>活跃</option>
            <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>禁用</option>
          </select>
        </div>
      </div>

      <div class="flex items-center space-x-2">
        <button id="refresh-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
          <i class="fas fa-sync-alt"></i>
        </button>
        <div class="relative">
          <button id="export-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm font-medium">
            <i class="fas fa-download mr-1"></i> 导出
          </button>
          <div id="export-menu" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-10 hidden">
            <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">导出为 CSV</a>
            <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">导出为 Excel</a>
          </div>
        </div>
      </div>
    </div>

    <!-- 批量操作按钮 -->
    <div id="batch-actions" class="hidden mb-4 p-3 bg-blue-50 border border-blue-200 rounded-md flex items-center justify-between">
      <span class="text-sm text-blue-700">已选择 <span id="selected-count">0</span> 个用户</span>
      <div class="flex space-x-2">
        <button id="batch-recharge-btn" class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1.5 rounded-md text-sm font-medium">
          <i class="fas fa-coins mr-1"></i> 批量充值
        </button>
        <button id="batch-delete-btn" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded-md text-sm font-medium">
          <i class="fas fa-trash mr-1"></i> 批量删除
        </button>
        <button id="cancel-selection-btn" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-3 py-1.5 rounded-md text-sm font-medium">
          取消选择
        </button>
      </div>
    </div>

    <!-- 用户表格 -->
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-12">
              <input type="checkbox" id="select-all-users" class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded">
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              用户
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              角色
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer hover:bg-gray-100" id="sort-credits">
              算力点数
              <span id="sort-icon" class="ml-1">
                <%
                  const currentSort = query.sort || 'created_at';
                  const currentOrder = query.order || 'desc';
                  if (currentSort === 'credits') {
                    if (currentOrder === 'asc') { %><i class="fas fa-sort-up"></i><% } else { %><i class="fas fa-sort-down"></i><% }
                  } else { %><i class="fas fa-sort text-gray-300"></i><% }
                %>
              </span>
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              状态
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              注册时间
            </th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
              操作
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% users.forEach(user => { %>
            <tr class="user-row" data-user-id="<%= user.id %>" data-role="<%= user.role %>" data-api-key="<%= user.api_key || '' %>" data-username="<%= user.username %>">
              <td class="px-6 py-4 whitespace-nowrap">
                <input type="checkbox" class="user-checkbox h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded" data-user-id="<%= user.id %>">
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="flex-shrink-0 h-10 w-10 rounded-full bg-primary-500 flex items-center justify-center text-white font-medium">
                    <%= user.username.charAt(0).toUpperCase() %>
                  </div>
                  <div class="ml-4">
                    <div class="text-sm font-medium text-gray-900"><%= user.username %></div>
                    <div class="text-sm text-gray-500"><%= user.email %></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (user.role === 'admin') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-purple-100 text-purple-800">
                    管理员
                  </span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                    普通用户
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= user.credits %> 点
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (user.status === 'active') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    活跃
                  </span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                    禁用
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= new Date(user.created_at).toLocaleString() %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex justify-end space-x-2">
                  <button class="text-gray-500 hover:text-gray-700 copy-api-key-btn" data-user-id="<%= user.id %>" data-username="<%= user.username %>" title="复制 API Key">
                    <i class="fas fa-key"></i>
                  </button>
                  <a href="/admin/playground?user_id=<%= user.id %>" class="text-gray-500 hover:text-gray-700" title="API Playground">
                    <i class="fas fa-flask"></i>
                  </a>
                  <button class="text-primary-600 hover:text-primary-900 add-credits-btn" data-user-id="<%= user.id %>" data-username="<%= user.username %>" title="添加算力">
                    <i class="fas fa-coins"></i>
                  </button>
                  <button class="text-green-600 hover:text-green-900 view-logs-btn" data-user-id="<%= user.id %>" data-username="<%= user.username %>" title="查看日志">
                    <i class="fas fa-history"></i>
                  </button>
                  <button class="text-blue-600 hover:text-blue-900 view-sessions-btn" data-user-id="<%= user.id %>" data-username="<%= user.username %>" title="查看会话">
                    <i class="fas fa-desktop"></i>
                  </button>
                  <a href="/admin/users/<%= user.id %>/edit" class="text-indigo-600 hover:text-indigo-900" title="编辑">
                    <i class="fas fa-edit"></i>
                  </a>
                  <button class="text-red-600 hover:text-red-900 delete-user-btn" data-user-id="<%= user.id %>" data-username="<%= user.username %>" title="删除">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- 分页 -->
    <div class="flex items-center justify-between mt-6">
      <div class="text-sm text-gray-700">
        显示 <span class="font-medium"><%= (page - 1) * limit + 1 %></span> 到 <span class="font-medium"><%= Math.min(page * limit, totalUsers) %></span> 条，共 <span class="font-medium"><%= totalUsers %></span> 条
      </div>
      <div class="flex space-x-2">
        <%
        // 构建分页 URL，保留筛选参数
        const buildUserPageUrl = (pageNum) => {
          let url = `/admin/users?page=${pageNum}&limit=${limit}`;
          if (filters.role) url += `&role=${filters.role}`;
          if (filters.status) url += `&status=${filters.status}`;
          if (query.search) url += `&search=${encodeURIComponent(query.search)}`;
          if (query.sort) url += `&sort=${query.sort}`;
          if (query.order) url += `&order=${query.order}`;
          return url;
        };
        %>
        <% if (page > 1) { %>
          <a href="<%= buildUserPageUrl(page - 1) %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            上一页
          </a>
        <% } else { %>
          <button disabled class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
            上一页
          </button>
        <% } %>

        <% if (page * limit < totalUsers) { %>
          <a href="<%= buildUserPageUrl(page + 1) %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            下一页
          </a>
        <% } else { %>
          <button disabled class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed">
            下一页
          </button>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- 添加用户模态框 -->
<div id="add-user-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">添加新用户</h3>
      <button id="close-add-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <form id="add-user-form" class="p-6">
      <div class="space-y-4">
        <div>
          <label for="username" class="block text-sm font-medium text-gray-700">用户名</label>
          <input type="text" id="username" name="username" required
            class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-gray-700">邮箱</label>
          <input type="email" id="email" name="email" required
            class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-gray-700">密码</label>
          <input type="password" id="password" name="password" required
            class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div>
          <label for="role" class="block text-sm font-medium text-gray-700">角色</label>
          <select id="role" name="role" required
            class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
            <option value="user">普通用户</option>
            <option value="admin">管理员</option>
          </select>
        </div>

        <div>
          <label for="initial-credits" class="block text-sm font-medium text-gray-700">初始算力点数</label>
          <input type="number" id="initial-credits" name="initial-credits" min="0" value="100"
            class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>
      </div>

      <div class="mt-6 flex justify-end">
        <button type="button" id="cancel-add-user" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 mr-3">
          取消
        </button>
        <button type="submit" class="bg-primary-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
          添加
        </button>
      </div>
    </form>
  </div>
</div>

<!-- 编辑用户模态框 -->
<div id="edit-user-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">编辑用户</h3>
      <button class="close-modal text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="modal-body p-6">
      <!-- 内容将通过JavaScript动态加载 -->
      <div class="flex justify-center items-center py-8">
        <div class="spinner mr-3"></div>
        <span>加载用户信息...</span>
      </div>
    </div>
  </div>
</div>

<!-- 添加算力模态框 -->
<div id="add-credits-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">添加算力点数</h3>
      <button id="close-credits-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <form id="add-credits-form" class="p-6">
      <input type="hidden" id="credits-user-id" name="user-id">
      <div class="space-y-4">
        <div>
          <label for="credits-amount" class="block text-sm font-medium text-gray-700">点数数量</label>
          <input type="number" id="credits-amount" name="credits-amount" min="1" value="100" required
            class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div>
          <label for="credits-reason" class="block text-sm font-medium text-gray-700">原因</label>
          <textarea id="credits-reason" name="credits-reason" rows="3"
            class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500"
            placeholder="添加算力的原因（可选）"></textarea>
        </div>
      </div>

      <div class="mt-6 flex justify-end">
        <button type="button" id="cancel-add-credits" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 mr-3">
          取消
        </button>
        <button type="submit" class="bg-primary-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
          添加
        </button>
      </div>
    </form>
  </div>
</div>

<!-- 批量充值模态框 -->
<div id="batch-recharge-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">批量充值</h3>
      <button id="close-batch-recharge-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <form id="batch-recharge-form" class="p-6">
      <div class="mb-4">
        <p class="text-sm text-gray-600">将为 <span id="batch-recharge-count" class="font-medium text-primary-600">0</span> 个用户充值</p>
      </div>
      <div class="space-y-4">
        <div>
          <label for="batch-credits-amount" class="block text-sm font-medium text-gray-700">点数数量</label>
          <input type="number" id="batch-credits-amount" name="credits-amount" min="1" value="100" required
            class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
        </div>

        <div>
          <label for="batch-credits-reason" class="block text-sm font-medium text-gray-700">原因</label>
          <textarea id="batch-credits-reason" name="credits-reason" rows="3"
            class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500"
            placeholder="添加算力的原因（可选）"></textarea>
        </div>
      </div>

      <div class="mt-6 flex justify-end">
        <button type="button" id="cancel-batch-recharge" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 mr-3">
          取消
        </button>
        <button type="submit" class="bg-primary-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
          批量充值
        </button>
      </div>
    </form>
  </div>
</div>

<div id="batch-create-modal" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center hidden">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-2xl mx-4">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">批量创建用户</h3>
      <button id="close-batch-create-modal" class="text-gray-400 hover:text-gray-500">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div id="batch-create-form-section" class="p-6">
      <form id="batch-create-form" class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">数量</label>
            <input type="number" id="batch-count" min="1" max="20" value="5"
              class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">用户名前缀</label>
            <input type="text" id="batch-prefix" value="test_user"
              class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">初始积分</label>
            <input type="number" id="batch-credits" min="0" value="100"
              class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">密码策略</label>
            <select id="batch-password-policy"
              class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
              <option value="random">随机生成</option>
              <option value="fixed">统一密码</option>
            </select>
          </div>
        </div>
        <div id="batch-fixed-password-section" class="hidden">
          <label class="block text-sm font-medium text-gray-700">统一密码</label>
          <input type="text" id="batch-fixed-password"
            class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-primary-500 focus:border-primary-500"
            placeholder="输入统一密码">
        </div>
        <div class="flex justify-end">
          <button type="button" id="cancel-batch-create" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 mr-3">取消</button>
          <button type="submit" class="bg-green-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-green-700">开始创建</button>
        </div>
      </form>
    </div>
    <div id="batch-create-progress-section" class="p-6 hidden">
      <div class="mb-4">
        <div class="flex justify-between text-sm text-gray-700 mb-1">
          <span>创建进度</span>
          <span id="batch-progress-text">0/0</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2.5">
          <div id="batch-progress-bar" class="bg-green-600 h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>
    </div>
    <div id="batch-create-results-section" class="p-6 hidden">
      <div class="flex justify-between items-center mb-4">
        <h4 class="text-sm font-medium text-gray-700">创建结果</h4>
        <button id="batch-copy-all" class="bg-primary-600 hover:bg-primary-700 text-white px-3 py-1.5 rounded-md text-sm font-medium">
          <i class="fas fa-copy mr-1"></i> 全部复制
        </button>
      </div>
      <div class="overflow-x-auto max-h-64 overflow-y-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">用户名</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">密码</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">API Key</th>
            </tr>
          </thead>
          <tbody id="batch-results-body" class="bg-white divide-y divide-gray-200"></tbody>
        </table>
      </div>
      <div class="mt-4 flex justify-end">
        <button id="batch-close-results" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50">关闭</button>
      </div>
    </div>
  </div>
</div>

<script>
  // 添加用户模态框
  const addUserBtn = document.getElementById('add-user-btn');
  const addUserModal = document.getElementById('add-user-modal');
  const closeAddModal = document.getElementById('close-add-modal');
  const cancelAddUser = document.getElementById('cancel-add-user');
  const addUserForm = document.getElementById('add-user-form');

  // 批量充值模态框
  const batchRechargeModal = document.getElementById('batch-recharge-modal');
  const closeBatchRechargeModal = document.getElementById('close-batch-recharge-modal');
  const cancelBatchRecharge = document.getElementById('cancel-batch-recharge');
  const batchRechargeForm = document.getElementById('batch-recharge-form');
  const batchRechargeCount = document.getElementById('batch-recharge-count');

  // 批量充值模态框事件
  closeBatchRechargeModal?.addEventListener('click', () => {
    batchRechargeModal.classList.add('hidden');
  });

  cancelBatchRecharge?.addEventListener('click', () => {
    batchRechargeModal.classList.add('hidden');
  });

  batchRechargeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(batchRechargeForm);
    const creditsData = {
      userIds: selectedUserIds,
      credits: parseInt(formData.get('credits-amount')),
      reason: formData.get('credits-reason')
    };

    try {
      const response = await fetch('/api/admin/users/batch-recharge', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(creditsData)
      });

      const result = await response.json();

      if (result.success) {
          let message = `成功为 ${result.data.recharged.length} 个用户充值`;
          if (result.data.failed.length > 0) {
            message += `，${result.data.failed.length} 个失败`;
            console.error('充值失败的用户:', result.data.failed);
          }
          window.appUtils.toast.success(message);
          batchRechargeModal.classList.add('hidden');
          window.location.reload();
        } else {
          window.appUtils.toast.error('批量充值失败: ' + result.message);
        }
      } catch (error) {
        window.appUtils.toast.error('批量充值失败: ' + error.message);
      }
  });

  batchRechargeModal?.addEventListener('click', (e) => {
    if (e.target === batchRechargeModal) {
      batchRechargeModal.classList.add('hidden');
    }
  });

  addUserBtn?.addEventListener('click', () => {
    addUserModal.classList.remove('hidden');
  });

  closeAddModal?.addEventListener('click', () => {
    addUserModal.classList.add('hidden');
  });

  cancelAddUser?.addEventListener('click', () => {
    addUserModal.classList.add('hidden');
  });

  addUserForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(addUserForm);
    const userData = {
      username: formData.get('username'),
      email: formData.get('email'),
      password: formData.get('password'),
      role: formData.get('role'),
      credits: parseInt(formData.get('initial-credits'))
    };

    try {
      const response = await fetch('/api/users', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(userData)
      });

      const result = await response.json();

      if (result.success) {
        // 刷新页面
        window.location.reload();
      } else {
        window.appUtils.toast.error('添加用户失败: ' + result.message);
      }
    } catch (error) {
      window.appUtils.toast.error('添加用户失败: ' + error.message);
    }
  });
  const editUserButtons = document.querySelectorAll('.edit-user-btn');
  const editUserModal = document.getElementById('edit-user-modal');
  const editUserModalBody = editUserModal?.querySelector('.modal-body');
  const closeEditModalButtons = editUserModal?.querySelectorAll('.close-modal');

  editUserButtons.forEach(button => {
    button.addEventListener('click', () => {
      const userId = button.getAttribute('data-user-id');
      openEditUserModal(userId);
    });
  });

  closeEditModalButtons?.forEach(button => {
    button.addEventListener('click', () => {
      editUserModal.classList.add('hidden');
    });
  });

  // 打开编辑用户模态框
  function openEditUserModal(userId) {
    // 显示加载状态
    editUserModalBody.innerHTML = `
      <div class="flex justify-center items-center py-8">
        <div class="spinner mr-3"></div>
        <span>加载用户信息...</span>
      </div>
    `;

    // 显示模态框
    editUserModal.classList.remove('hidden');

    // 获取用户信息
    fetch(`/api/admin/users/${userId}`, {
      credentials: 'same-origin',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
      }
    })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          const user = data.data;

          // 获取用户的会话消耗统计
          fetch(`/api/admin/users/${user.id}/session-stats`, {
            credentials: 'same-origin',
            headers: {
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
            }
          })
            .then(response => response.json())
            .then(statsData => {
              const stats = statsData.success ? statsData.data : { total_sessions: 0, total_duration: 0, total_credits_used: 0 };

              // 格式化持续时间
              const formatDuration = (seconds) => {
                const hours = Math.floor(seconds / 3600);
                const minutes = Math.floor((seconds % 3600) / 60);
                const remainingSeconds = seconds % 60;

                let result = '';
                if (hours > 0) result += `${hours} 小时 `;
                if (minutes > 0) result += `${minutes} 分钟 `;
                if (remainingSeconds > 0 || (hours === 0 && minutes === 0)) result += `${remainingSeconds} 秒`;

                return result.trim();
              };

              // 更新模态框内容
              editUserModalBody.innerHTML = `
                <form id="edit-user-form" class="space-y-4">
                  <input type="hidden" name="user_id" value="${user.id}">

                  <div>
                    <label for="edit-username" class="block text-sm font-medium text-gray-700 mb-1">用户名</label>
                    <input type="text" id="edit-username" name="username" value="${user.username}" readonly
                      class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm bg-gray-50 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
                    <p class="mt-1 text-xs text-gray-500">用户名不可更改</p>
                  </div>

                  <!-- 用户消耗统计 -->
                  <div class="bg-gray-50 p-4 rounded-md">
                    <h4 class="text-sm font-medium text-gray-700 mb-2">用户消耗统计</h4>
                    <div class="grid grid-cols-3 gap-4">
                      <div>
                        <p class="text-xs text-gray-500">总会话数</p>
                        <p class="text-sm font-medium">${stats.total_sessions} 个</p>
                      </div>
                      <div>
                        <p class="text-xs text-gray-500">总使用时长</p>
                        <p class="text-sm font-medium">${formatDuration(stats.total_duration)}</p>
                      </div>
                      <div>
                        <p class="text-xs text-gray-500">总消耗点数</p>
                        <p class="text-sm font-medium">${stats.total_credits_used} 点</p>
                      </div>
                    </div>
                  </div>

              <div>
                <label for="edit-email" class="block text-sm font-medium text-gray-700 mb-1">邮箱</label>
                <input type="email" id="edit-email" name="email" value="${user.email || ''}" required
                  class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
              </div>

              <div>
                <label for="edit-role" class="block text-sm font-medium text-gray-700 mb-1">角色</label>
                <select id="edit-role" name="role" required
                  class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
                  <option value="user" ${user.role === 'user' ? 'selected' : ''}>普通用户</option>
                  <option value="admin" ${user.role === 'admin' ? 'selected' : ''}>管理员</option>
                </select>
              </div>

              <div>
                <label for="edit-status" class="block text-sm font-medium text-gray-700 mb-1">状态</label>
                <select id="edit-status" name="status" required
                  class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
                  <option value="active" ${user.status === 'active' ? 'selected' : ''}>活跃</option>
                  <option value="inactive" ${user.status === 'inactive' ? 'selected' : ''}>禁用</option>
                </select>
              </div>

              <div>
                <label for="edit-password" class="block text-sm font-medium text-gray-700 mb-1">新密码</label>
                <input type="password" id="edit-password" name="password"
                  class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500">
                <p class="mt-1 text-xs text-gray-500">留空表示不修改密码</p>
              </div>

              <div>
                <label for="edit-webhook-url" class="block text-sm font-medium text-gray-700 mb-1">Webhook URL</label>
                <input type="url" id="edit-webhook-url" name="webhook_url" value="${user.webhook_url || ''}"
                  class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary-500 focus:border-primary-500"
                  placeholder="https://example.com/webhook">
                <p class="mt-1 text-xs text-gray-500">当会话结束时，系统将发送通知到此 URL</p>
              </div>

              <div>
                <label for="edit-api-key" class="block text-sm font-medium text-gray-700 mb-1">API Key</label>
                <div class="flex">
                  <input type="text" id="edit-api-key" value="${user.api_key || ''}" readonly
                    class="block w-full px-3 py-2 border border-gray-300 rounded-l-md shadow-sm bg-gray-50 focus:outline-none focus:ring-primary-500 focus:border-primary-500">
                  <button type="button" class="copy-api-key bg-gray-100 px-3 py-2 border border-l-0 border-gray-300 rounded-r-md text-gray-700 hover:bg-gray-200">
                    <i class="fas fa-copy"></i>
                  </button>
                </div>
                <p class="mt-1 text-xs text-gray-500">用户的 API Key，用于调用 API</p>
                <div class="mt-2">
                  <button type="button" class="reset-api-key text-sm text-primary-600 hover:text-primary-800" data-user-id="${user.id}">
                    <i class="fas fa-sync-alt mr-1"></i> 重置 API Key
                  </button>
                </div>
              </div>

              <div class="flex justify-end pt-4">
                <button type="button" class="close-modal bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 mr-3">
                  取消
                </button>
                <button type="submit" class="bg-primary-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                  保存更改
                </button>
              </div>
            </form>
          `;

          // 重新绑定事件
          const editUserForm = document.getElementById('edit-user-form');
          editUserForm.addEventListener('submit', function(e) {
            e.preventDefault();
            updateUser(this);
          });

          const closeModalButtons = editUserModalBody.querySelectorAll('.close-modal');
          closeModalButtons.forEach(button => {
            button.addEventListener('click', function() {
              editUserModal.classList.add('hidden');
            });
          });

          // 绑定复制 API Key 按钮
          const copyApiKeyBtn = editUserModalBody.querySelector('.copy-api-key');
          const apiKeyInput = editUserModalBody.querySelector('#edit-api-key');

          if (copyApiKeyBtn && apiKeyInput) {
            copyApiKeyBtn.addEventListener('click', function() {
              // 选择输入框内容
              apiKeyInput.select();

              // 复制到剪贴板
              try {
                document.execCommand('copy');

                // 显示复制成功提示
                const originalText = copyApiKeyBtn.innerHTML;
                copyApiKeyBtn.innerHTML = '<i class="fas fa-check"></i>';
                copyApiKeyBtn.classList.add('bg-green-100', 'text-green-700');

                setTimeout(() => {
                  copyApiKeyBtn.innerHTML = originalText;
                  copyApiKeyBtn.classList.remove('bg-green-100', 'text-green-700');
                }, 2000);

                // 显示成功通知
                window.appUtils.toast.success('API Key 已复制到剪贴板');
              } catch (err) {
                // 显示错误通知
                window.appUtils.toast.error('复制失败，请手动复制');
              }
            });
          }

          // 绑定重置 API Key 按钮
          const resetApiKeyBtn = editUserModalBody.querySelector('.reset-api-key');

          if (resetApiKeyBtn) {
            resetApiKeyBtn.addEventListener('click', function() {
              const userId = this.getAttribute('data-user-id');

              // 确认重置
              if (confirm('确定要重置此用户的 API Key 吗？这将使当前的 API Key 失效。')) {
                resetApiKey(userId, apiKeyInput);
              }
            });
          }
        });
      } else {
          editUserModalBody.innerHTML = `
            <div class="text-center py-8">
              <i class="fas fa-exclamation-circle text-red-500 text-4xl mb-4"></i>
              <p class="text-gray-700">获取用户信息失败: ${data.error}</p>
              <button type="button" class="close-modal mt-4 bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                关闭
              </button>
            </div>
          `;

          const closeModalButtons = editUserModalBody.querySelectorAll('.close-modal');
          closeModalButtons.forEach(button => {
            button.addEventListener('click', function() {
              editUserModal.classList.add('hidden');
            });
          });
        }
      })
      .catch(error => {
        editUserModalBody.innerHTML = `
          <div class="text-center py-8">
            <i class="fas fa-exclamation-circle text-red-500 text-4xl mb-4"></i>
            <p class="text-gray-700">获取用户信息失败: ${error.message}</p>
            <button type="button" class="close-modal mt-4 bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
              关闭
            </button>
          </div>
        `;

        const closeModalButtons = editUserModalBody.querySelectorAll('.close-modal');
        closeModalButtons.forEach(button => {
          button.addEventListener('click', function() {
            editUserModal.classList.add('hidden');
          });
        });
      });
  }

  // 更新用户
  function updateUser(form) {
    // 获取表单数据
    const formData = new FormData(form);
    const userId = formData.get('user_id');
    const userData = {
      role: formData.get('role'),
      status: formData.get('status'),
      webhook_url: formData.get('webhook_url') || null
    };

    // 如果提供了 email，则添加到请求数据中
    const email = formData.get('email');
    if (email && email.trim() !== '') {
      userData.email = email;
    }

    // 如果提供了密码，则添加到请求数据中
    const password = formData.get('password');
    if (password) {
      userData.password = password;
    }

    // 显示加载状态
    const submitButton = form.querySelector('button[type="submit"]');
    const originalText = submitButton.innerHTML;
    submitButton.innerHTML = '<div class="spinner inline-block mr-2"></div> 处理中...';
    submitButton.disabled = true;

    // 发送请求更新用户
    fetch(`/api/admin/users/${userId}`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
      },
      body: JSON.stringify(userData),
      credentials: 'same-origin'
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // 关闭模态框
        editUserModal.classList.add('hidden');

        // 显示成功通知
        window.appUtils.toast.success('用户信息已成功更新');

        // 重新加载页面以显示更新后的用户信息
        setTimeout(() => {
          window.location.reload();
        }, 1000);
      } else {
        // 恢复按钮状态
        submitButton.innerHTML = originalText;
        submitButton.disabled = false;

        // 显示错误通知
        window.appUtils.toast.error(`更新用户失败: ${data.error}`);
      }
    })
    .catch(error => {
      // 恢复按钮状态
      submitButton.innerHTML = originalText;
      submitButton.disabled = false;

      // 显示错误通知
      window.appUtils.toast.error(`更新用户失败: ${error.message}`);
    });
  }

  // 重置 API Key
  function resetApiKey(userId, apiKeyInput) {
    // 显示加载状态
    const resetButton = document.querySelector(`.reset-api-key[data-user-id="${userId}"]`);
    const originalText = resetButton.innerHTML;
    resetButton.innerHTML = '<div class="spinner inline-block mr-2"></div> 处理中...';
    resetButton.disabled = true;

    // 发送请求重置 API Key
    fetch(`/api/admin/users/${userId}/reset-api-key`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
      },
      credentials: 'same-origin'
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // 更新输入框中的 API Key
        apiKeyInput.value = data.data.api_key;

        // 显示成功通知
        window.appUtils.toast.success('API Key 已成功重置');

        // 恢复按钮状态
        resetButton.innerHTML = originalText;
        resetButton.disabled = false;
      } else {
        // 恢复按钮状态
        resetButton.innerHTML = originalText;
        resetButton.disabled = false;

        // 显示错误通知
        window.appUtils.toast.error(`重置 API Key 失败: ${data.error}`);
      }
    })
    .catch(error => {
      // 恢复按钮状态
      resetButton.innerHTML = originalText;
      resetButton.disabled = false;

      // 显示错误通知
      window.appUtils.toast.error(`重置 API Key 失败: ${error.message}`);
    });
  }

  // 添加算力模态框
  const addCreditsButtons = document.querySelectorAll('.add-credits-btn');
  const addCreditsModal = document.getElementById('add-credits-modal');
  const closeCreditsModal = document.getElementById('close-credits-modal');
  const cancelAddCredits = document.getElementById('cancel-add-credits');
  const addCreditsForm = document.getElementById('add-credits-form');
  const creditsUserId = document.getElementById('credits-user-id');

  addCreditsButtons.forEach(button => {
    button.addEventListener('click', () => {
      creditsUserId.value = button.getAttribute('data-user-id');
      addCreditsModal.classList.remove('hidden');
    });
  });

  closeCreditsModal?.addEventListener('click', () => {
    addCreditsModal.classList.add('hidden');
  });

  cancelAddCredits?.addEventListener('click', () => {
    addCreditsModal.classList.add('hidden');
  });

  addCreditsForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(addCreditsForm);
    const creditsData = {
      userId: formData.get('user-id'),
      amount: parseInt(formData.get('credits-amount')),
      reason: formData.get('credits-reason')
    };

    try {
      const response = await fetch('/api/admin/users/' + creditsData.userId + '/credits', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          amount: creditsData.amount,
          reason: creditsData.reason
        })
      });

      const result = await response.json();

      if (result.success) {
        // 刷新页面
        window.location.reload();
      } else {
        window.appUtils.toast.error('添加算力失败: ' + result.message);
      }
    } catch (error) {
      window.appUtils.toast.error('添加算力失败: ' + error.message);
    }
  });

  // 导出菜单
  const exportBtn = document.getElementById('export-btn');
  const exportMenu = document.getElementById('export-menu');

  exportBtn?.addEventListener('click', () => {
    exportMenu.classList.toggle('hidden');
  });

  // 点击其他地方关闭导出菜单
  document.addEventListener('click', (e) => {
    if (!exportBtn?.contains(e.target) && !exportMenu?.contains(e.target)) {
      exportMenu?.classList.add('hidden');
    }
  });

  // 导出 CSV 功能
  const exportCsvLink = exportMenu?.querySelector('a:first-child');
  exportCsvLink?.addEventListener('click', async (e) => {
    e.preventDefault();

    // 获取当前的搜索和筛选条件
    const searchTerm = document.getElementById('search-users')?.value || '';
    const roleFilter = document.getElementById('role-filter')?.value || '';
    const statusFilter = document.getElementById('status-filter')?.value || '';

    // 构建查询参数
    const params = new URLSearchParams();
    if (searchTerm) params.append('search', searchTerm);
    if (roleFilter) params.append('role', roleFilter);
    if (statusFilter) params.append('status', statusFilter);

    // 发起导出请求
    try {
      const response = await fetch(`/api/admin/users/export?${params.toString()}`, {
        method: 'GET',
        headers: {
          'Accept': 'text/csv',
        },
      });

      if (!response.ok) {
        throw new Error('导出失败');
      }

      // 获取文件名
      const contentDisposition = response.headers.get('Content-Disposition');
      let filename = 'users.csv';
      if (contentDisposition) {
        const match = contentDisposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
        if (match && match[1]) {
          filename = match[1].replace(/['"]/g, '');
        }
      }

      // 下载文件
      const blob = await response.blob();
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      window.URL.revokeObjectURL(url);
      document.body.removeChild(a);

      // 关闭菜单并显示成功提示
      exportMenu?.classList.add('hidden');
      window.appUtils.toast.success('导出成功');
    } catch (error) {
      window.appUtils.toast.error('导出失败: ' + error.message);
