  // 辅助函数：构建带筛选参数的 URL
  function buildUserUrl(params) {
    const url = new URL(window.location.href);
    // 保留当前的分页参数
    if (!params.page && url.searchParams.has('page')) {
      params.page = url.searchParams.get('page');
    }
    // 保留当前的 limit 参数
    if (!params.limit && url.searchParams.has('limit')) {
      params.limit = url.searchParams.get('limit');
    }
    // 保留当前的 sort 参数
    if (!params.sort && url.searchParams.has('sort')) {
      params.sort = url.searchParams.get('sort');
    }
    // 保留当前的 order 参数
    if (!params.order && url.searchParams.has('order')) {
      params.order = url.searchParams.get('order');
    }
    // 保留当前的 search 参数
    if (!params.search && url.searchParams.has('search')) {
      params.search = url.searchParams.get('search');
    }
    // 保留当前的 role 参数
    if (!params.role && url.searchParams.has('role')) {
      params.role = url.searchParams.get('role');
    }
    // 保留当前的 status 参数
    if (!params.status && url.searchParams.has('status')) {
      params.status = url.searchParams.get('status');
    }
    // 更新参数
    Object.keys(params).forEach(key => {
      if (params[key] === '' || params[key] === null || params[key] === undefined) {
        url.searchParams.delete(key);
      } else {
        url.searchParams.set(key, params[key]);
      }
    });
    return url.toString();
  }

