        <span>用户管理</span>
      </a>
    <% } %>
    <a href="/admin/sessions" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
      <i class="fas fa-desktop w-5 mr-3"></i>
      <span>会话管理</span>
    </a>
    <% if (locals.user && user.role === 'admin') { %>
      <a href="/admin/machines" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
        <i class="fas fa-server w-5 mr-3"></i>
        <span>机器管理</span>
      </a>
      <a href="/admin/logs" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
        <i class="fas fa-history w-5 mr-3"></i>
        <span>操作日志</span>
      </a>
      <a href="/admin/files" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
        <i class="fas fa-file-upload w-5 mr-3"></i>
        <span>文件上传</span>
      </a>
      <a href="/admin/playground" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
        <i class="fas fa-flask w-5 mr-3"></i>
        <span>API Playground</span>
      </a>
    <% } %>
    <div class="px-4 mt-6 mb-2">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">账户</p>
    </div>
    <a href="/admin/profile" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
      <i class="fas fa-user-circle w-5 mr-3"></i>
      <span>个人资料</span>
    </a>
    <a href="/admin/settings" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
      <i class="fas fa-cog w-5 mr-3"></i>
      <span>设置</span>
    </a>
    <a href="/admin/logout" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
      <i class="fas fa-sign-out-alt w-5 mr-3"></i>
      <span>退出登录</span>
    </a>
  </nav>
</aside>

<!-- 移动端侧边栏切换按钮 -->
<div class="md:hidden fixed bottom-4 right-4 z-50">
  <button id="sidebar-toggle" class="bg-primary-600 text-white p-3 rounded-full shadow-lg">
    <i class="fas fa-bars"></i>
  </button>
</div>

<!-- 移动端侧边栏 -->
<div id="mobile-sidebar" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-40 hidden md:hidden">
  <div class="absolute right-0 top-0 h-full w-64 bg-white shadow-lg transform transition-transform duration-300 translate-x-0">
    <div class="flex justify-between items-center p-4 border-b">
      <h2 class="text-lg font-semibold">菜单</h2>
      <button id="close-sidebar" class="text-gray-500 hover:text-gray-700">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <nav class="mt-6">
      <a href="/admin" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
        <i class="fas fa-tachometer-alt w-5 mr-3"></i>
        <span>仪表盘</span>
      </a>
      <% if (locals.user && user.role === 'admin') { %>
        <a href="/admin/users" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
          <i class="fas fa-users w-5 mr-3"></i>
          <span>用户管理</span>
        </a>
      <% } %>
      <a href="/admin/sessions" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
        <i class="fas fa-desktop w-5 mr-3"></i>
        <span>会话管理</span>
      </a>
      <% if (locals.user && user.role === 'admin') { %>
        <a href="/admin/machines" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
          <i class="fas fa-server w-5 mr-3"></i>
          <span>机器管理</span>
        </a>
        <a href="/admin/logs" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
          <i class="fas fa-history w-5 mr-3"></i>
          <span>操作日志</span>
        </a>
        <a href="/admin/files" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
          <i class="fas fa-file-upload w-5 mr-3"></i>
          <span>文件上传</span>
        </a>
        <a href="/admin/playground" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
          <i class="fas fa-flask w-5 mr-3"></i>
          <span>API Playground</span>
        </a>
      <% } %>
      <div class="border-t border-gray-200 my-4"></div>
      <a href="/admin/profile" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
        <i class="fas fa-user-circle w-5 mr-3"></i>
        <span>个人资料</span>
      </a>
      <a href="/admin/settings" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
        <i class="fas fa-cog w-5 mr-3"></i>
        <span>设置</span>
      </a>
      <a href="/admin/logout" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 transition-colors">
        <i class="fas fa-sign-out-alt w-5 mr-3"></i>
        <span>退出登录</span>
      </a>
    </nav>
  </div>
</div>

<script>
  // 移动端侧边栏切换
  document.getElementById('sidebar-toggle')?.addEventListener('click', function() {
    document.getElementById('mobile-sidebar').classList.remove('hidden');
  });

  document.getElementById('close-sidebar')?.addEventListener('click', function() {
    document.getElementById('mobile-sidebar').classList.add('hidden');
  });

  // 点击遮罩层关闭侧边栏
  document.getElementById('mobile-sidebar')?.addEventListener('click', function(e) {
    if (e.target === this) {
      this.classList.add('hidden');
    }
  });
</script>