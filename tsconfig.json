{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["src/shared/*"],
      "@manager/*": ["src/manager/*"],
      "@machine/*": ["src/machine/*"],
      "@schemas/*": ["src/schemas/*"]
    }
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "scripts", "src/tests/**/*"]
}
